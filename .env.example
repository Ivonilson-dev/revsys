# Ambiente de Execução (development | production | test)
NODE_ENV=development
PORT=3000

# Conexão MySQL
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=revsys
DB_USER=root
DB_PASS=

# Segurança de Sessão e Criptografia LGPD
# SESSION_SECRET: Chave forte e aleatória para assinatura dos cookies de sessão
SESSION_SECRET=coloque_uma_chave_aleatoria_longa_aqui
# AES_KEY: Chave simétrica obrigatória de EXATAMENTE 32 caracteres (256 bits) para criptografia de dados sensíveis
AES_KEY=chave-secreta-aes-256-para-dados-lgpd-32-chars

# Configurações de E-mail / SMTP (Recuperação de Senha)
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nao-responda@exemplo.com.br
SMTP_PASS=sua_senha_de_email_aqui
