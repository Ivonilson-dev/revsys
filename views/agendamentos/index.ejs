<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Cabeçalho -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Gerenciamento de Agendamentos</h1>
        <p class="text-slate-600 text-xs sm:text-sm md:text-base mt-1 font-normal">Veja todos os agendamentos do sistema ou filtre por período e cliente.</p>
      </div>
      <div>
        <a href="/agendamentos/calendario-tela" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-brand-500 hover:bg-brand-600 text-white font-bold py-2.5 px-4 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-xs sm:text-sm text-center">
          <i data-lucide="calendar" class="w-4 h-4"></i>
          <span>Ver Agenda Visual (Calendário)</span>
        </a>
      </div>
    </div>

    <!-- Filtros de Busca -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-5">
      <form action="/agendamentos" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 items-end">
        
        <!-- Filtro Data -->
        <div>
          <label for="data" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Data</label>
          <input type="date" id="data" name="data" value="<%= filtros.data || '' %>"
                 class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2 px-3 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
        </div>

        <!-- Filtro Status -->
        <div>
          <label for="status" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Status</label>
          <select id="status" name="status"
                  class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2 px-3 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
            <option value="">Todos os Status</option>
            <option value="agendado" <%= filtros.status === 'agendado' ? 'selected' : '' %>>Agendado</option>
            <option value="concluido" <%= filtros.status === 'concluido' ? 'selected' : '' %>>Concluído</option>
            <option value="cancelado" <%= filtros.status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
          </select>
        </div>

        <!-- Filtro Cliente -->
        <div>
          <label for="cliente_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Cliente</label>
          <select id="cliente_id" name="cliente_id"
                  class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2 px-3 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
            <option value="">Todos os Clientes</option>
            <% clientes.forEach(cli => { %>
              <option value="<%= cli.id %>" <%= filtros.cliente_id == cli.id ? 'selected' : '' %>><%= cli.usuario.nome %></option>
            <% }) %>
          </select>
        </div>

        <!-- Botões -->
        <div class="flex gap-2">
          <button type="submit" class="flex-1 bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition-all shadow-sm">
            Filtrar
          </button>
          <% if (filtros.data || filtros.status || filtros.cliente_id) { %>
            <a href="/agendamentos" class="flex-1 text-center border border-slate-300 hover:bg-slate-50 text-slate-700 py-2.5 px-4 rounded-xl text-sm transition-all font-semibold">
              Limpar
            </a>
          <% } %>
        </div>

      </form>
    </div>

    <!-- Tabela / Cards de Agendamentos -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      
      <!-- Visualização Desktop (Tabela) -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-100/80 border-b border-slate-200 text-slate-700 text-xs sm:text-sm font-bold uppercase tracking-wider">
              <th class="p-4 pl-6">Data / Horário</th>
              <th class="p-4">Cliente</th>
              <th class="p-4">Veículo (Placa)</th>
              <th class="p-4">Motivo da Revisão</th>
              <th class="p-4">Status / Presença</th>
              <th class="p-4 pr-6 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-800 text-base">
            <% if (agendamentos.length === 0) { %>
              <tr>
                <td colspan="6" class="p-8 text-center text-slate-500 font-medium">
                  <i data-lucide="calendar" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                  Nenhum agendamento encontrado para os filtros informados.
                </td>
              </tr>
            <% } else { %>
              <% agendamentos.forEach(a => { %>
                <% 
                  let telAg = a.cliente && a.cliente.telefone_whatsapp ? String(a.cliente.telefone_whatsapp).replace(/\D/g, '') : '';
                  if (telAg.length === 10 || telAg.length === 11) {
                    telAg = '55' + telAg;
                  }
                  const dataFormatada = formatarData(a.data_agendada);
                  const msgWhatsAg = `Olá ${a.cliente && a.cliente.usuario ? a.cliente.usuario.nome : ''}, tudo bem? Entramos em contato da oficina referente ao seu agendamento do dia ${dataFormatada} das ${a.horario_agendado} às ${a.horario_fim || ''}.`;
                %>
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="p-4 pl-6">
                    <span class="font-bold text-slate-900 block leading-tight"><%= dataFormatada %></span>
                    <span class="text-xs font-semibold text-slate-700 inline-flex items-center gap-1 mt-0.5">
                      <span><%= a.horario_agendado %> <%= a.horario_fim ? 'às ' + a.horario_fim : '' %></span>
                      <% if (a.duracao_minutos) { %>
                        <span class="text-[10px] font-bold text-slate-500 bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded">
                          <%= formatarDuracao(a.duracao_minutos) %>
                        </span>
                      <% } %>
                    </span>
                  </td>
                  <td class="p-4 font-semibold text-slate-800">
                    <div class="flex items-center gap-2">
                      <span><%= a.cliente ? a.cliente.usuario.nome : 'N/I' %></span>
                      <% if (telAg) { %>
                        <a href="https://wa.me/<%= telAg %>?text=<%= encodeURIComponent(msgWhatsAg) %>" target="_blank" rel="noopener noreferrer" class="p-1 rounded-lg bg-[#25D366] hover:bg-[#128C7E] text-white transition-all shadow-sm shrink-0" title="Chamar cliente no WhatsApp">
                          <svg class="w-4 h-4 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/></svg>
                        </a>
                      <% } %>
                    </div>
                  </td>
                  <td class="p-4">
                    <a href="/veiculos/<%= a.veiculo_id %>" class="<%= a.veiculo ? obterClassePlaca(a.veiculo.placa) : 'placa-mercosul' %> px-2.5 py-0.5 text-xs hover:shadow-md transition-shadow">
                      <%= a.veiculo ? formatarPlaca(a.veiculo.placa) : 'Placa N/I' %>
                    </a>
                  </td>
                  <td class="p-4 text-slate-600 italic">"<%= a.motivo_revisao %>"</td>
                  <td class="p-4">
                    <div>
                      <% if (a.status === 'agendado') { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-100 text-sky-800 border border-sky-200 uppercase">Agendado</span>
                      <% } else if (a.status === 'concluido') { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 uppercase">Concluído</span>
                      <% } else { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-200 uppercase">Cancelado</span>
                        <% if (a.motivo_cancelamento) { %>
                          <span class="block text-[11px] text-red-600 font-medium mt-1 italic max-w-xs" title="<%= a.motivo_cancelamento %>">Motivo: <%= a.motivo_cancelamento %></span>
                        <% } %>
                      <% } %>
                    </div>

                    <% if (a.status === 'agendado') { %>
                      <div class="mt-1.5">
                        <% if (a.confirmacao_presenca === 'confirmada') { %>
                          <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <i data-lucide="user-check" class="w-3 h-3 text-emerald-600"></i>
                            Presença Confirmada
                          </span>
                        <% } else if (a.confirmacao_presenca === 'solicitada') { %>
                          <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200">
                            <i data-lucide="message-square" class="w-3 h-3 text-blue-600"></i>
                            Whats Enviado
                          </span>
                        <% } else { %>
                          <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200">
                            <i data-lucide="help-circle" class="w-3 h-3 text-amber-600"></i>
                            Presença a Confirmar
                          </span>
                        <% } %>
                      </div>
                    <% } %>
                  </td>
                  <td class="p-4 pr-6 text-right space-x-2">
                    <% 
                      const agoraItem = new Date();
                      const hojeStrItem = agoraItem.toLocaleDateString('en-CA');
                      const horaAtualStrItem = agoraItem.toTimeString().substring(0, 5);
                      const ehAgendamentoFuturo = a.data_agendada > hojeStrItem || (a.data_agendada === hojeStrItem && a.horario_agendado > horaAtualStrItem);
                    %>
                    <% if (a.status === 'agendado' && ['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                      <% if (a.confirmacao_presenca !== 'confirmada') { %>
                        <!-- Confirmar Presença (Dar Baixa) -->
                        <button onclick="confirmarPresencaTabela(<%= a.id %>)" class="text-xs font-bold text-sky-700 hover:text-sky-800 bg-sky-50 hover:bg-sky-100 px-2.5 py-1.5 rounded-lg border border-sky-200 transition-colors inline-flex items-center gap-1" title="Confirmar presença do cliente">
                          <i data-lucide="user-check" class="w-3.5 h-3.5"></i>
                          <span>Dar Baixa</span>
                        </button>
                      <% } %>
                      <% if (!ehAgendamentoFuturo) { %>
                        <!-- Concluir (Apenas para agendamentos do dia/horário já chegado ou anteriores) -->
                        <button onclick="concluirAgendamento(<%= a.id %>)" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-lg border border-emerald-200 transition-colors">
                          Concluir
                        </button>
                      <% } %>
                      <!-- Cancelar (Horário liberado imediatamente, exige motivo) -->
                      <button onclick="cancelarAgendamento(<%= a.id %>)" class="text-xs font-bold text-red-700 hover:text-red-800 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg border border-red-200 transition-colors">
                        Cancelar
                      </button>
                    <% } else { %>
                      <span class="text-xs text-slate-400 italic">Sem ações</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Visualização Mobile (Cards) -->
      <div class="block md:hidden divide-y divide-slate-100">
        <% if (agendamentos.length === 0) { %>
          <div class="p-8 text-center text-slate-500 font-medium">
            Nenhum agendamento encontrado.
          </div>
        <% } else { %>
          <% agendamentos.forEach(a => { %>
            <% 
              let telAgMobile = a.cliente && a.cliente.telefone_whatsapp ? String(a.cliente.telefone_whatsapp).replace(/\D/g, '') : '';
              if (telAgMobile.length === 10 || telAgMobile.length === 11) {
                telAgMobile = '55' + telAgMobile;
              }
              const dataFormatadaMob = formatarData(a.data_agendada);
              const msgWhatsAgMob = `Olá ${a.cliente && a.cliente.usuario ? a.cliente.usuario.nome : ''}, tudo bem? Entramos em contato da oficina referente ao seu agendamento do dia ${dataFormatadaMob} das ${a.horario_agendado} às ${a.horario_fim || ''}.`;
            %>
            <div class="p-4 sm:p-5 space-y-3 hover:bg-slate-50/70 transition-colors">
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold text-slate-900 text-sm sm:text-base leading-snug">
                  <%= dataFormatadaMob %> • <%= a.horario_agendado %><%= a.horario_fim ? ' às ' + a.horario_fim : '' %>
                  <% if (a.duracao_minutos) { %>
                    <span class="text-[10px] font-bold text-slate-500 bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded ml-0.5">
                      <%= formatarDuracao(a.duracao_minutos) %>
                    </span>
                  <% } %>
                </span>
                <% if (a.status === 'agendado') { %>
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 shrink-0">AGENDADO</span>
                <% } else if (a.status === 'concluido') { %>
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 shrink-0">CONCLUÍDO</span>
                <% } else { %>
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-red-100 text-red-800 shrink-0">CANCELADO</span>
                <% } %>
              </div>

              <% if (a.status === 'cancelado' && a.motivo_cancelamento) { %>
                <div class="bg-red-50 border border-red-200 rounded-xl p-2.5 text-xs text-red-700">
                  <span class="font-bold uppercase tracking-wider text-[10px] block text-red-500">Motivo do cancelamento:</span>
                  <span class="italic block mt-0.5"><%= a.motivo_cancelamento %></span>
                </div>
              <% } %>
              
              <div class="grid grid-cols-2 gap-2.5 text-xs text-slate-600">
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-[10px]">Cliente</span>
                  <div class="flex items-center gap-1.5 mt-0.5">
                    <span class="text-slate-900 font-semibold text-sm truncate"><%= a.cliente ? a.cliente.usuario.nome : 'N/I' %></span>
                    <% if (telAgMobile) { %>
                      <a href="https://wa.me/<%= telAgMobile %>?text=<%= encodeURIComponent(msgWhatsAgMob) %>" target="_blank" rel="noopener noreferrer" class="p-1 rounded-lg bg-[#25D366] hover:bg-[#128C7E] text-white shrink-0 shadow-sm" title="Chamar no WhatsApp">
                        <svg class="w-4 h-4 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/></svg>
                      </a>
                    <% } %>
                  </div>
                </div>
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-[10px] mb-0.5">Veículo (Placa)</span>
                  <a href="/veiculos/<%= a.veiculo_id %>" class="<%= a.veiculo ? obterClassePlaca(a.veiculo.placa) : 'placa-mercosul' %> px-2 py-0.5 text-xs inline-block">
                    <%= a.veiculo ? formatarPlaca(a.veiculo.placa) : 'N/I' %>
                  </a>
                </div>
                <div class="col-span-2">
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-[10px]">Motivo</span>
                  <span class="text-slate-800 italic block text-xs sm:text-sm">"<%= a.motivo_revisao %>"</span>
                </div>
                <% if (a.status === 'agendado') { %>
                  <div class="col-span-2">
                    <span class="block text-slate-500 font-bold uppercase tracking-wider text-[10px]">Presença</span>
                    <div class="mt-1">
                      <% if (a.confirmacao_presenca === 'confirmada') { %>
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">
                          <i data-lucide="user-check" class="w-3 h-3 text-emerald-600"></i>
                          Presença Confirmada
                        </span>
                      <% } else if (a.confirmacao_presenca === 'solicitada') { %>
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200">
                          <i data-lucide="message-square" class="w-3 h-3 text-blue-600"></i>
                          Whats Enviado
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200">
                          <i data-lucide="help-circle" class="w-3 h-3 text-amber-600"></i>
                          Presença a Confirmar
                        </span>
                      <% } %>
                    </div>
                  </div>
                <% } %>
              </div>

              <!-- Ações no Mobile -->
              <% 
                const agoraMob = new Date();
                const hojeStrMob = agoraMob.toLocaleDateString('en-CA');
                const horaAtualStrMob = agoraMob.toTimeString().substring(0, 5);
                const ehFuturoMob = a.data_agendada > hojeStrMob || (a.data_agendada === hojeStrMob && a.horario_agendado > horaAtualStrMob);
              %>
              <% if (a.status === 'agendado' && ['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                <div class="flex gap-2 pt-2.5 border-t border-slate-100 flex-wrap">
                  <% if (a.confirmacao_presenca !== 'confirmada') { %>
                    <button onclick="confirmarPresencaTabela(<%= a.id %>)" class="flex-1 text-center py-2 px-3 rounded-xl bg-sky-50 border border-sky-200 text-sky-800 font-bold text-xs sm:text-sm active:scale-[0.98] transition-all flex items-center justify-center gap-1">
                      <i data-lucide="user-check" class="w-3.5 h-3.5"></i>
                      <span>Dar Baixa</span>
                    </button>
                  <% } %>
                  <% if (!ehFuturoMob) { %>
                    <button onclick="concluirAgendamento(<%= a.id %>)" class="flex-1 text-center py-2 px-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-bold text-xs sm:text-sm active:scale-[0.98] transition-all">
                      Concluir
                    </button>
                  <% } %>
                  <button onclick="cancelarAgendamento(<%= a.id %>)" class="flex-1 text-center py-2 px-3 rounded-xl bg-red-50 border border-red-200 text-red-800 font-bold text-xs sm:text-sm active:scale-[0.98] transition-all">
                    Cancelar
                  </button>
                </div>
              <% } %>
            </div>
          <% }) %>
        <% } %>
      </div>

    </div>

  </div>
</div>

<script>
  async function concluirAgendamento(id) {
    const result = await Swal.fire({
      title: 'Concluir Agendamento?',
      text: 'Confirma que este serviço foi executado e está concluído?',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#10b981',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Sim, marcar como concluído!',
      cancelButtonText: 'Voltar',
      customClass: {
        popup: 'rounded-2xl font-sans',
        confirmButton: 'rounded-xl font-bold px-4 py-2.5 text-sm',
        cancelButton: 'rounded-xl font-bold px-4 py-2.5 text-sm'
      }
    });

    if (!result.isConfirmed) return;

    try {
      const response = await fetch(`/agendamentos/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'concluido' })
      });

      if (response.ok) {
        window.location.reload();
      } else {
        const txt = await response.text();
        exibirAlertaModal('Atenção', txt, 'error');
      }
    } catch (err) {
      console.error(err);
      exibirAlertaModal('Erro de Conexão', 'Não foi possível se comunicar com o servidor.', 'error');
    }
  }

  async function cancelarAgendamento(id) {
    const { value: motivo, isConfirmed } = await Swal.fire({
      title: 'Cancelar Agendamento',
      text: 'O horário será liberado para outros clientes. Por favor, especifique o motivo do cancelamento (obrigatório):',
      input: 'textarea',
      inputPlaceholder: 'Ex: Cliente solicitou reagendamento, imprevisto com peças...',
      inputAttributes: {
        'aria-label': 'Motivo do cancelamento'
      },
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Confirmar Cancelamento',
      cancelButtonText: 'Manter Agendamento',
      customClass: {
        popup: 'rounded-2xl font-sans',
        confirmButton: 'rounded-xl font-bold px-4 py-2.5 text-sm',
        cancelButton: 'rounded-xl font-bold px-4 py-2.5 text-sm'
      },
      inputValidator: (value) => {
        if (!value || !value.trim()) {
          return 'O motivo do cancelamento é obrigatório!';
        }
        if (value.trim().length < 4) {
          return 'O motivo deve ter pelo menos 4 caracteres.';
        }
      }
    });

    if (!isConfirmed || !motivo) return;

    try {
      const response = await fetch(`/agendamentos/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          status: 'cancelado',
          motivo_cancelamento: motivo.trim()
        })
      });

      if (response.ok) {
        Swal.fire({
          icon: 'success',
          title: 'Agendamento Cancelado',
          text: 'O horário foi desocupado com sucesso.',
          timer: 1500,
          showConfirmButton: false
        }).then(() => {
          window.location.reload();
        });
      } else {
        const txt = await response.text();
        exibirAlertaModal('Atenção', txt, 'error');
      }
    } catch (err) {
      console.error(err);
      exibirAlertaModal('Erro de Conexão', 'Não foi possível se comunicar com o servidor.', 'error');
    }
  }

  async function confirmarPresencaTabela(id) {
    const result = await Swal.fire({
      title: 'Dar Baixa na Presença?',
      text: 'Confirma que o cliente comparecerá a este agendamento?',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#10b981',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Sim, confirmar presença!',
      cancelButtonText: 'Voltar',
      customClass: {
        popup: 'rounded-2xl font-sans',
        confirmButton: 'rounded-xl font-bold px-4 py-2.5 text-sm',
        cancelButton: 'rounded-xl font-bold px-4 py-2.5 text-sm'
      }
    });

    if (!result.isConfirmed) return;

    try {
      const response = await fetch(`/agendamentos/${id}/confirmar-presenca`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });

      if (response.ok) {
        Swal.fire({
          icon: 'success',
          title: 'Presença Confirmada',
          text: 'Baixa registrada com sucesso no sistema.',
          timer: 1500,
          showConfirmButton: false
        }).then(() => {
          window.location.reload();
        });
      } else {
        const erro = await response.json();
        Swal.fire('Atenção', erro.erro || 'Erro ao confirmar presença.', 'error');
      }
    } catch (err) {
      console.error(err);
      Swal.fire('Erro', 'Não foi possível se comunicar com o servidor.', 'error');
    }
  }
</script>

