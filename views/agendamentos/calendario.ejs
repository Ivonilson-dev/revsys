<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<!-- FullCalendar v6 CDN -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Alertas Globais -->
    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-sm flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Cabeçalho -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Agenda de Revisões</h1>
        <p class="text-slate-500 mt-1">Gerencie a ocupação dos boxes da oficina e evite conflitos de horário.</p>
      </div>
      <div>
        <a href="/agendamentos" class="inline-flex items-center space-x-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md hover:shadow-xl active:scale-[0.98] transition-all text-sm">
          <i data-lucide="list" class="w-4 h-4"></i>
          <span>Ver Lista Completa</span>
        </a>
      </div>
    </div>

    <!-- Layout Dividido em Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Coluna Calendário (2/3) -->
      <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm p-4 md:p-6">
        <div id="calendar" class="min-h-[500px]"></div>
      </div>

      <!-- Coluna Formulário de Agendamento (1/3) -->
      <div class="space-y-6">
        
        <!-- Formulário Rápido de Novo Agendamento -->
        <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
            <div>
              <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <i data-lucide="calendar-plus" class="w-5 h-5 text-brand-500"></i>
                <span>Agendar Revisão</span>
              </h2>
              <p class="text-xs text-slate-400 mt-0.5 font-medium">Cadastre um novo agendamento respeitando as regras de horários.</p>
            </div>

            <form action="/agendamentos" method="POST" class="space-y-4">
              
              <!-- Cliente -->
              <div>
                <label for="cliente_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Cliente proprietário *</label>
                <select id="cliente_id" name="cliente_id" required onchange="carregarVeiculosDoCliente(this.value)"
                        class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
                  <option value="" disabled selected>Selecione o cliente...</option>
                  <% clientes.forEach(cli => { %>
                    <option value="<%= cli.id %>"><%= cli.usuario.nome %> (CPF: <%= cli.cpf %>)</option>
                  <% }) %>
                </select>
              </div>

              <!-- Veículo -->
              <div>
                <label for="veiculo_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Veículo do Cliente *</label>
                <select id="veiculo_id" name="veiculo_id" required disabled
                        class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
                  <option value="" disabled selected>Selecione o veículo...</option>
                </select>
              </div>

              <!-- Data do Agendamento -->
              <div>
                <label for="data_agendada" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Data Agendada *</label>
                <input type="date" id="data_agendada" name="data_agendada" required onchange="carregarHorariosDisponiveis(this.value)"
                       min="<%= new Date().toISOString().split('T')[0] %>"
                       class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              </div>

              <!-- Horário Agendado -->
              <div>
                <label for="horario_agendado" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Horário Comercial *</label>
                <select id="horario_agendado" name="horario_agendado" required disabled
                        class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
                  <option value="" disabled selected>Selecione o horário...</option>
                </select>
                <span class="text-[10px] text-slate-450 mt-1 block leading-tight">Horários ocupados ou fora da agenda comercial estarão desabilitados.</span>
              </div>

              <!-- Motivo da Revisão -->
              <div>
                <label for="motivo_revisao" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Motivo / Reclamações *</label>
                <input type="text" id="motivo_revisao" name="motivo_revisao" required placeholder="Ex: Troca de óleo + revisão de freios"
                       class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              </div>

              <!-- Observações -->
              <div>
                <label for="observacoes" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Observações Internas</label>
                <textarea id="observacoes" name="observacoes" rows="2" placeholder="Observações adicionais..."
                          class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all resize-none"></textarea>
              </div>

              <button type="submit" 
                      class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-xs flex items-center justify-center space-x-2">
                <span>Criar Agendamento</span>
                <i data-lucide="check" class="w-3.5 h-3.5"></i>
              </button>

            </form>
          </div>
        <% } %>

        <!-- Detalhes do Evento Clicado (Card Dinâmico em JS) -->
        <div id="cardDetalheEvento" class="hidden bg-slate-900 text-white rounded-2xl border border-slate-850 p-6 space-y-4 shadow-xl transition-all">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="font-bold text-sm text-brand-300">Detalhes do Compromisso</h3>
            <button onclick="fecharDetalheEvento()" class="p-1 hover:bg-slate-850 rounded text-slate-400 hover:text-white">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
          
          <div class="space-y-3 text-xs">
            <div>
              <span class="block text-slate-400 font-semibold text-[10px] uppercase tracking-wider">Cliente</span>
              <span id="eventoCliente" class="font-bold text-white block mt-0.5 text-sm"></span>
            </div>
            <div>
              <span class="block text-slate-400 font-semibold text-[10px] uppercase tracking-wider">Veículo (Placa)</span>
              <span id="eventoVeiculo" class="font-bold text-white block mt-0.5"></span>
            </div>
            <div>
              <span class="block text-slate-400 font-semibold text-[10px] uppercase tracking-wider">Horário / Data</span>
              <span id="eventoHorario" class="font-bold text-white block mt-0.5"></span>
            </div>
            <div>
              <span class="block text-slate-400 font-semibold text-[10px] uppercase tracking-wider">Motivo</span>
              <span id="eventoMotivo" class="text-white block mt-0.5 italic"></span>
            </div>
            <div id="divEventoObs" class="hidden">
              <span class="block text-slate-400 font-semibold text-[10px] uppercase tracking-wider">Observações</span>
              <p id="eventoObs" class="text-slate-350 block mt-0.5 p-2 bg-slate-850 rounded border border-slate-800"></p>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  // Carrega os veículos de um cliente via AJAX API
  async function carregarVeiculosDoCliente(clienteId) {
    const selectVeiculo = document.getElementById('veiculo_id');
    selectVeiculo.innerHTML = '<option value="" disabled selected>Buscando veículos...</option>';
    selectVeiculo.disabled = true;

    if (!clienteId) return;

    try {
      const res = await fetch(`/api/clientes/${clienteId}/veiculos`);
      if (res.ok) {
        const veiculos = await res.json();
        selectVeiculo.innerHTML = '<option value="" disabled selected>Selecione o veículo...</option>';
        if (veiculos.length === 0) {
          selectVeiculo.innerHTML = '<option value="" disabled>Nenhum veículo cadastrado para este cliente.</option>';
        } else {
          veiculos.forEach(v => {
            const desc = v.modelo ? `${v.modelo.marca.nome} ${v.modelo.nome} (${v.placa})` : v.placa;
            selectVeiculo.innerHTML += `<option value="${v.id}">${desc}</option>`;
          });
          selectVeiculo.disabled = false;
        }
      } else {
        selectVeiculo.innerHTML = '<option value="" disabled>Erro ao buscar veículos.</option>';
      }
    } catch (error) {
      console.error(error);
      selectVeiculo.innerHTML = '<option value="" disabled>Erro de conexão.</option>';
    }
  }

  // Carrega horários disponíveis de acordo com a ocupação do dia (RF-20/RF-34)
  async function carregarHorariosDisponiveis(data) {
    const selectHorario = document.getElementById('horario_agendado');
    selectHorario.innerHTML = '<option value="" disabled selected>Carregando horários...</option>';
    selectHorario.disabled = true;

    if (!data) return;

    try {
      const res = await fetch(`/agendamentos/horarios-disponiveis?data=${data}`);
      if (res.ok) {
        const lista = await res.json();
        selectHorario.innerHTML = '<option value="" disabled selected>Selecione o horário...</option>';
        
        lista.forEach(item => {
          if (item.ocupado) {
            selectHorario.innerHTML += `<option value="${item.horario}" disabled class="text-red-400 bg-red-50 font-bold">${item.horario} (Ocupado)</option>`;
          } else {
            selectHorario.innerHTML += `<option value="${item.horario}" class="text-slate-800">${item.horario} (Disponível)</option>`;
          }
        });
        selectHorario.disabled = false;
      } else {
        selectHorario.innerHTML = '<option value="" disabled>Erro ao buscar agenda.</option>';
      }
    } catch (error) {
      console.error(error);
      selectHorario.innerHTML = '<option value="" disabled>Erro de conexão.</option>';
    }
  }

  function fecharDetalheEvento() {
    document.getElementById('cardDetalheEvento').classList.add('hidden');
  }

  // Inicialização do Calendário FullCalendar v6 (RF-17)
  document.addEventListener('DOMContentLoaded', () => {
    const calendarEl = document.getElementById('calendar');
    
    const calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,timeGridDay'
      },
      locale: 'pt-br', // Configuração padrão pt-br
      buttonText: {
        today: 'Hoje',
        month: 'Mês',
        week: 'Semana',
        day: 'Dia'
      },
      events: '/agendamentos/calendario', // Rota de eventos JSON
      eventClick: function(info) {
        // Exibe detalhes do agendamento clicado
        const props = info.event.extendedProps;
        document.getElementById('eventoCliente').innerText = props.cliente;
        document.getElementById('eventoVeiculo').innerText = props.placa;
        document.getElementById('eventoHorario').innerText = `${info.event.start.toLocaleDateString('pt-BR')} às ${props.title ? props.title.substring(0, 5) : ''}`;
        document.getElementById('eventoMotivo').innerText = `"${props.motivo}"`;

        if (props.observacoes) {
          document.getElementById('eventoObs').innerText = props.observacoes;
          document.getElementById('divEventoObs').classList.remove('hidden');
        } else {
          document.getElementById('divEventoObs').classList.add('hidden');
        }

        const card = document.getElementById('cardDetalheEvento');
        card.classList.remove('hidden');
        lucide.createIcons();
      }
    });

    calendar.render();
  });
</script>

<%- include('../parciais/rodape') %>
