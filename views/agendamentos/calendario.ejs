<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<!-- FullCalendar v6 CDN -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

<style>
  /* Responsividade & Estilização do FullCalendar para Mobile e Desktop */
  .fc .fc-toolbar.fc-header-toolbar {
    margin-bottom: 1rem;
    gap: 0.5rem;
  }
  
  .fc .fc-toolbar-title {
    font-family: 'Outfit', sans-serif !important;
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    letter-spacing: -0.025em;
  }

  .fc .fc-button {
    font-family: 'Outfit', sans-serif !important;
    font-weight: 600 !important;
    border-radius: 0.625rem !important;
    text-transform: capitalize !important;
    transition: all 0.15s ease !important;
  }

  .fc .fc-button-primary {
    background-color: #0f172a !important;
    border-color: #1e293b !important;
    color: #ffffff !important;
  }

  .fc .fc-button-primary:hover {
    background-color: #1e293b !important;
    border-color: #334155 !important;
  }

  .fc .fc-button-primary:not(:disabled).fc-button-active,
  .fc .fc-button-primary:not(:disabled):active {
    background-color: #0284c7 !important;
    border-color: #0284c7 !important;
    color: #ffffff !important;
    box-shadow: 0 4px 6px -1px rgba(2, 132, 199, 0.25) !important;
  }

  .fc-theme-standard th {
    background-color: #f8fafc !important;
    border-color: #e2e8f0 !important;
    color: #475569 !important;
    font-weight: 700 !important;
    padding: 0.5rem 0 !important;
    font-size: 0.8rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
  }

  .fc-theme-standard td {
    border-color: #f1f5f9 !important;
  }

  .fc .fc-day-today {
    background-color: #f0f9ff !important;
  }

  .fc-daygrid-day-number {
    font-weight: 700 !important;
    color: #334155 !important;
    font-size: 0.825rem !important;
  }

  .fc-event {
    border-radius: 0.375rem !important;
    padding: 2px 4px !important;
    border: none !important;
    cursor: pointer !important;
    transition: transform 0.1s ease !important;
  }

  .fc-event:hover {
    transform: scale(1.02);
  }

  /* Ajustes específicos para telas mobile (< 768px) */
  @media (max-width: 768px) {
    .fc .fc-toolbar {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 0.625rem !important;
    }
    
    .fc .fc-toolbar-chunk {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      width: 100% !important;
    }

    .fc .fc-toolbar-title {
      font-size: 1.05rem !important;
      font-weight: 800 !important;
      text-align: center !important;
    }

    .fc .fc-button {
      padding: 0.35rem 0.6rem !important;
      font-size: 0.75rem !important;
      border-radius: 0.5rem !important;
    }

    .fc-theme-standard th {
      padding: 0.35rem 0 !important;
      font-size: 0.7rem !important;
    }

    .fc-daygrid-day-number {
      font-size: 0.725rem !important;
      padding: 0.1rem 0.25rem !important;
    }

    .fc-daygrid-day-events {
      margin-top: 1px !important;
    }

    .fc-daygrid-event {
      font-size: 0.65rem !important;
      padding: 1px 3px !important;
      margin-top: 1px !important;
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      line-height: 1.2 !important;
    }

    .fc-event-title {
      font-weight: 600 !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
    }

    /* Ocultar horário do evento na grade mensal do mobile para não espremer o título */
    .fc-event-time {
      display: none !important;
    }
  }
</style>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Alertas Globais -->
    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-sm sm:text-base font-medium flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Cabeçalho -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Agenda de Revisões</h1>
        <p class="text-slate-600 text-xs sm:text-sm md:text-base mt-1 font-normal">Gerencie a ocupação dos boxes da oficina e evite conflitos de horário.</p>
      </div>
      <div>
        <a href="/agendamentos" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-4 rounded-xl shadow-md hover:shadow-xl active:scale-[0.98] transition-all text-xs sm:text-sm text-center">
          <i data-lucide="list" class="w-4 h-4"></i>
          <span>Ver Lista Completa</span>
        </a>
      </div>
    </div>

    <!-- Layout Dividido em Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Coluna Calendário (2/3) -->
      <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm p-3.5 sm:p-5 md:p-6 overflow-hidden">
        <div id="calendar" class="min-h-[460px] sm:min-h-[520px]"></div>
      </div>

      <!-- Coluna Formulário de Agendamento (1/3) -->
      <div class="space-y-6">
        
        <!-- Formulário Rápido de Novo Agendamento -->
        <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
                <i data-lucide="calendar-plus" class="w-5 h-5 text-brand-500"></i>
                <span>Agendar Revisão</span>
              </h2>
              <p class="text-xs text-slate-500 mt-0.5 font-normal">Cadastre um novo agendamento respeitando as regras de horários.</p>
            </div>

            <form action="/agendamentos" method="POST" class="space-y-4">
              
              <!-- Cliente -->
              <div>
                <label for="cliente_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Cliente proprietário *</label>
                <select id="cliente_id" name="cliente_id" required onchange="carregarVeiculosDoCliente(this.value)"
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
                  <option value="" disabled selected>Selecione o cliente...</option>
                  <% clientes.forEach(cli => { %>
                    <option value="<%= cli.id %>"><%= cli.usuario.nome %> (CPF: <%= formatarCPF(cli.cpf) %>)</option>
                  <% }) %>
                </select>
              </div>

              <!-- Veículo -->
              <div>
                <label for="veiculo_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Veículo do Cliente *</label>
                <select id="veiculo_id" name="veiculo_id" required disabled
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium disabled:opacity-60">
                  <option value="" disabled selected>Selecione o veículo...</option>
                </select>
              </div>

              <!-- Data do Agendamento -->
              <div>
                <label for="data_agendada" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Data Agendada *</label>
                <input type="date" id="data_agendada" name="data_agendada" required onchange="carregarHorariosDisponiveis(this.value)"
                       min="<%= new Date().toISOString().split('T')[0] %>"
                       class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              </div>

              <!-- Horário Agendado -->
              <div>
                <label for="horario_agendado" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Horário Comercial *</label>
                <select id="horario_agendado" name="horario_agendado" required disabled
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium disabled:opacity-60">
                  <option value="" disabled selected>Selecione o horário...</option>
                </select>
                <span class="text-[11px] text-slate-500 mt-1 block leading-tight font-normal">Horários ocupados estarão desabilitados.</span>
              </div>

              <!-- Motivo da Revisão -->
              <div>
                <label for="motivo_revisao" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Motivo / Reclamações *</label>
                <input type="text" id="motivo_revisao" name="motivo_revisao" required placeholder="Ex: Troca de óleo + revisão de freios"
                       class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              </div>

              <!-- Observações Internas -->
              <div>
                <label for="observacoes" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Observações da Oficina</label>
                <textarea id="observacoes" name="observacoes" rows="2" placeholder="Observações opcionais..."
                          class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all resize-none"></textarea>
              </div>

              <button type="submit" 
                      class="w-full bg-brand-500 hover:bg-brand-600 active:scale-[0.98] text-white font-bold py-3 px-4 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 transition-all text-sm sm:text-base flex items-center justify-center space-x-2">
                <span>Criar Agendamento</span>
                <i data-lucide="check" class="w-4 h-4"></i>
              </button>

            </form>
          </div>
        <% } %>

        <!-- Detalhes do Evento Clicado (Card Dinâmico em JS) -->
        <div id="cardDetalheEvento" class="hidden bg-slate-900 text-white rounded-2xl border border-slate-800 p-5 sm:p-6 space-y-4 shadow-xl transition-all">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="font-bold text-sm text-brand-300">Detalhes do Compromisso</h3>
            <button onclick="fecharDetalheEvento()" class="w-8 h-8 flex items-center justify-center hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition-colors">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
          
          <div class="space-y-3 text-xs sm:text-sm">
            <div>
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Cliente</span>
              <span id="eventoCliente" class="font-bold text-white block mt-0.5 text-sm sm:text-base"></span>
            </div>
            <div>
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Veículo (Placa)</span>
              <span id="eventoVeiculo" class="font-mono font-bold text-white block mt-0.5 text-sm sm:text-base"></span>
            </div>
            <div>
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Horário / Data</span>
              <span id="eventoHorario" class="font-bold text-white block mt-0.5 text-sm sm:text-base"></span>
            </div>
            <div>
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Motivo</span>
              <span id="eventoMotivo" class="text-white block mt-0.5 italic text-sm"></span>
            </div>
            <div id="divEventoObs" class="hidden">
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Observações</span>
              <p id="eventoObs" class="text-slate-300 block mt-0.5 p-2.5 bg-slate-800/80 rounded-xl border border-slate-700/60 text-xs sm:text-sm"></p>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  // Carrega os veículos de um cliente via AJAX API
  async function carregarVeiculosDoCliente(clienteId) {
    const selectVeiculo = document.getElementById('veiculo_id');
    selectVeiculo.innerHTML = '<option value="" disabled selected>Buscando veículos...</option>';
    selectVeiculo.disabled = true;

    if (!clienteId) return;

    try {
      const res = await fetch(`/api/clientes/${clienteId}/veiculos`);
      if (res.ok) {
        const veiculos = await res.json();
        selectVeiculo.innerHTML = '<option value="" disabled selected>Selecione o veículo...</option>';
        if (veiculos.length === 0) {
          selectVeiculo.innerHTML = '<option value="" disabled>Nenhum veículo cadastrado para este cliente.</option>';
        } else {
          veiculos.forEach(v => {
            const desc = v.modelo ? `${v.modelo.marca.nome} ${v.modelo.nome} (${v.placa})` : v.placa;
            selectVeiculo.innerHTML += `<option value="${v.id}">${desc}</option>`;
          });
          selectVeiculo.disabled = false;
        }
      } else {
        selectVeiculo.innerHTML = '<option value="" disabled>Erro ao buscar veículos.</option>';
      }
    } catch (error) {
      console.error(error);
      selectVeiculo.innerHTML = '<option value="" disabled>Erro de conexão.</option>';
    }
  }

  // Carrega horários disponíveis de acordo com a ocupação do dia (RF-20/RF-34)
  async function carregarHorariosDisponiveis(data) {
    const selectHorario = document.getElementById('horario_agendado');
    selectHorario.innerHTML = '<option value="" disabled selected>Carregando horários...</option>';
    selectHorario.disabled = true;

    if (!data) return;

    try {
      const res = await fetch(`/agendamentos/horarios-disponiveis?data=${data}`);
      if (res.ok) {
        const lista = await res.json();
        selectHorario.innerHTML = '<option value="" disabled selected>Selecione o horário...</option>';
        
        lista.forEach(item => {
          if (item.ocupado) {
            selectHorario.innerHTML += `<option value="${item.horario}" disabled class="text-red-400 bg-red-50 font-bold">${item.horario} (Ocupado)</option>`;
          } else {
            selectHorario.innerHTML += `<option value="${item.horario}" class="text-slate-800 font-medium">${item.horario} (Disponível)</option>`;
          }
        });
        selectHorario.disabled = false;
      } else {
        selectHorario.innerHTML = '<option value="" disabled>Erro ao buscar agenda.</option>';
      }
    } catch (error) {
      console.error(error);
      selectHorario.innerHTML = '<option value="" disabled>Erro de conexão.</option>';
    }
  }

  function fecharDetalheEvento() {
    document.getElementById('cardDetalheEvento').classList.add('hidden');
  }

  // Inicialização do Calendário FullCalendar v6 com responsividade mobile inteligente (RF-17)
  document.addEventListener('DOMContentLoaded', () => {
    const calendarEl = document.getElementById('calendar');
    const isMobile = window.innerWidth < 768;
    
    const calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      headerToolbar: isMobile ? {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridDay'
      } : {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,timeGridDay'
      },
      dayHeaderFormat: isMobile ? { weekday: 'narrow' } : { weekday: 'short' },
      locale: 'pt-br',
      buttonText: {
        today: 'Hoje',
        month: 'Mês',
        week: 'Semana',
        day: 'Dia'
      },
      events: '/agendamentos/calendario',
      eventClick: function(info) {
        const props = info.event.extendedProps;
        document.getElementById('eventoCliente').innerText = props.cliente;
        document.getElementById('eventoVeiculo').innerText = props.placa;
        document.getElementById('eventoHorario').innerText = `${info.event.start.toLocaleDateString('pt-BR')} às ${props.title ? props.title.substring(0, 5) : ''}`;
        document.getElementById('eventoMotivo').innerText = `"${props.motivo}"`;

        if (props.observacoes) {
          document.getElementById('eventoObs').innerText = props.observacoes;
          document.getElementById('divEventoObs').classList.remove('hidden');
        } else {
          document.getElementById('divEventoObs').classList.add('hidden');
        }

        const card = document.getElementById('cardDetalheEvento');
        card.classList.remove('hidden');
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        lucide.createIcons();
      },
      windowResize: function(view) {
        const mobileAgora = window.innerWidth < 768;
        calendar.setOption('headerToolbar', mobileAgora ? {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridDay'
        } : {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridWeek,timeGridDay'
        });
        calendar.setOption('dayHeaderFormat', mobileAgora ? { weekday: 'narrow' } : { weekday: 'short' });
      }
    });

    calendar.render();
  });
</script>

<%- include('../parciais/rodape') %>
