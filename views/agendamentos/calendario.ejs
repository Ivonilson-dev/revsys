<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<!-- FullCalendar v6 CDN & Idioma Português do Brasil -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.11/locales/pt-br.global.min.js"></script>

<style>
  /* Barra de Ferramentas e Controles do FullCalendar (Design Moderno & Espaçado) */
  .fc .fc-toolbar.fc-header-toolbar {
    margin-bottom: 1.25rem !important;
    padding: 0.625rem 0.875rem !important;
    background-color: #f8fafc !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 0.875rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: wrap !important;
    gap: 0.75rem !important;
  }
  
  .fc .fc-toolbar-chunk {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
  }

  /* Desfazer botões colados por padrão no FullCalendar e adicionar espaçamento limpo */
  .fc .fc-button-group {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.375rem !important;
  }

  .fc .fc-button-group > .fc-button,
  .fc-direction-ltr .fc-button-group > .fc-button:not(:first-child),
  .fc-direction-ltr .fc-button-group > .fc-button:not(:last-child) {
    margin: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    border-radius: 0.625rem !important;
  }

  .fc .fc-toolbar-title {
    font-family: 'Outfit', sans-serif !important;
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    letter-spacing: -0.025em;
  }

  .fc .fc-toolbar-title::first-letter {
    text-transform: uppercase !important;
  }

  /* Botão Base do Calendário */
  .fc .fc-button {
    font-family: 'Outfit', sans-serif !important;
    font-weight: 600 !important;
    border-radius: 0.625rem !important;
    text-transform: capitalize !important;
    transition: all 0.15s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
  }

  .fc .fc-button:focus,
  .fc .fc-button-primary:focus {
    outline: none !important;
    box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.35) !important;
  }

  /* Botões de Navegação (Apenas os ícones < e >) */
  .fc .fc-prev-button,
  .fc .fc-next-button {
    width: 2.25rem !important;
    height: 2.25rem !important;
    padding: 0 !important;
    font-size: 0 !important;
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    color: #334155 !important;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
  }

  .fc .fc-prev-button .fc-icon,
  .fc .fc-next-button .fc-icon {
    font-size: 1.25rem !important;
    line-height: 1 !important;
  }

  .fc .fc-prev-button:hover,
  .fc .fc-next-button:hover {
    background-color: #f1f5f9 !important;
    border-color: #94a3b8 !important;
    color: #0f172a !important;
  }

  .fc .fc-prev-button:active,
  .fc .fc-next-button:active {
    transform: scale(0.96) !important;
  }

  /* Botão 'Hoje' */
  .fc .fc-today-button {
    height: 2.25rem !important;
    padding: 0 0.875rem !important;
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    color: #0f172a !important;
    font-weight: 700 !important;
    font-size: 0.8125rem !important;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
  }

  .fc .fc-today-button:hover:not(:disabled) {
    background-color: #0f172a !important;
    border-color: #0f172a !important;
    color: #ffffff !important;
  }

  .fc .fc-today-button:disabled {
    opacity: 0.5 !important;
    background-color: #f8fafc !important;
    border-color: #e2e8f0 !important;
    color: #94a3b8 !important;
    cursor: not-allowed !important;
    box-shadow: none !important;
  }

  /* Botões de Modos de Visualização (Mês / Semana / Dia) */
  .fc .fc-dayGridMonth-button,
  .fc .fc-timeGridWeek-button,
  .fc .fc-timeGridDay-button {
    height: 2.25rem !important;
    padding: 0 0.875rem !important;
    font-size: 0.8125rem !important;
    font-weight: 600 !important;
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    color: #475569 !important;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
  }

  .fc .fc-dayGridMonth-button:hover:not(.fc-button-active),
  .fc .fc-timeGridWeek-button:hover:not(.fc-button-active),
  .fc .fc-timeGridDay-button:hover:not(.fc-button-active) {
    background-color: #f1f5f9 !important;
    border-color: #94a3b8 !important;
    color: #0f172a !important;
  }

  .fc .fc-dayGridMonth-button.fc-button-active,
  .fc .fc-timeGridWeek-button.fc-button-active,
  .fc .fc-timeGridDay-button.fc-button-active,
  .fc .fc-button-primary:not(:disabled).fc-button-active,
  .fc .fc-button-primary:not(:disabled):active {
    background-color: #0284c7 !important;
    border-color: #0284c7 !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    box-shadow: 0 2px 4px 0 rgba(2, 132, 199, 0.25) !important;
  }

  .fc-theme-standard th {
    background-color: #f8fafc !important;
    border-color: #e2e8f0 !important;
    color: #475569 !important;
    font-weight: 700 !important;
    padding: 0.5rem 0 !important;
    font-size: 0.8rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
  }

  .fc-theme-standard td {
    border-color: #f1f5f9 !important;
  }

  .fc .fc-day-today {
    background-color: #f0f9ff !important;
  }

  .fc-daygrid-day-number {
    font-weight: 700 !important;
    color: #334155 !important;
    font-size: 0.825rem !important;
  }

  .fc-event {
    border-radius: 0.375rem !important;
    padding: 2px 4px !important;
    border: none !important;
    cursor: pointer !important;
    transition: transform 0.1s ease !important;
  }

  .fc-event:hover {
    transform: scale(1.02);
  }

  /* Dias no passado ficam visivelmente desabilitados */
  .fc-day-past {
    background-color: #f1f5f9 !important;
    opacity: 0.65;
    cursor: not-allowed !important;
  }
  .fc-day-past .fc-daygrid-day-number {
    color: #94a3b8 !important;
  }

  /* Ajustes específicos para telas mobile (< 768px) */
  @media (max-width: 768px) {
    .fc .fc-toolbar.fc-header-toolbar {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 0.625rem !important;
      padding: 0.5rem 0.625rem !important;
    }
    
    .fc .fc-toolbar-chunk {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 0.375rem !important;
      width: 100% !important;
    }

    .fc .fc-button-group {
      gap: 0.35rem !important;
    }

    .fc .fc-toolbar-title {
      font-size: 1.05rem !important;
      font-weight: 800 !important;
      text-align: center !important;
    }

    .fc .fc-button {
      font-size: 0.75rem !important;
      border-radius: 0.5rem !important;
    }

    .fc .fc-prev-button,
    .fc .fc-next-button {
      width: 2rem !important;
      height: 2rem !important;
      padding: 0 !important;
      font-size: 0 !important;
      border-radius: 0.5rem !important;
    }

    .fc .fc-prev-button .fc-icon,
    .fc .fc-next-button .fc-icon {
      font-size: 1.1rem !important;
      line-height: 1 !important;
    }

    .fc .fc-today-button {
      height: 2rem !important;
      padding: 0 0.65rem !important;
      font-size: 0.75rem !important;
      border-radius: 0.5rem !important;
    }

    .fc .fc-dayGridMonth-button,
    .fc .fc-timeGridWeek-button,
    .fc .fc-timeGridDay-button {
      height: 2rem !important;
      padding: 0 0.65rem !important;
      font-size: 0.75rem !important;
      border-radius: 0.5rem !important;
    }

    .fc-theme-standard th {
      padding: 0.35rem 0 !important;
      font-size: 0.7rem !important;
    }

    .fc-daygrid-day-number {
      font-size: 0.725rem !important;
      padding: 0.1rem 0.25rem !important;
    }

    .fc-daygrid-day-events {
      margin-top: 1px !important;
    }

    .fc-daygrid-event {
      font-size: 0.65rem !important;
      padding: 1px 3px !important;
      margin-top: 1px !important;
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      line-height: 1.2 !important;
    }

    .fc-event-title {
      font-weight: 600 !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
    }

    /* Ocultar horário do evento na grade mensal do mobile para não espremer o título */
    .fc-event-time {
      display: none !important;
    }
  }
</style>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Alertas Globais -->
    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-sm sm:text-base font-medium flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Cabeçalho -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Agenda de Revisões</h1>
        <p class="text-slate-600 text-xs sm:text-sm md:text-base mt-1 font-normal">Gerencie a ocupação dos boxes da oficina e evite conflitos de horário.</p>
      </div>
      <div>
        <a href="/agendamentos" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-4 rounded-xl shadow-md hover:shadow-xl active:scale-[0.98] transition-all text-xs sm:text-sm text-center">
          <i data-lucide="list" class="w-4 h-4"></i>
          <span>Ver Lista Completa</span>
        </a>
      </div>
    </div>

    <!-- Layout Dividido em Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Coluna Calendário (2/3) -->
      <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm p-3.5 sm:p-5 md:p-6 overflow-hidden">
        <div id="calendar" class="min-h-[460px] sm:min-h-[520px]"></div>
      </div>

      <!-- Coluna Formulário de Agendamento (1/3) -->
      <div class="space-y-6">
        
        <!-- Formulário Rápido de Novo Agendamento -->
        <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
                <i data-lucide="calendar-plus" class="w-5 h-5 text-brand-500"></i>
                <span>Agendar Revisão</span>
              </h2>
              <p class="text-xs text-slate-500 mt-0.5 font-normal">Cadastre um novo agendamento respeitando as regras de horários.</p>
            </div>

            <!-- Regras de Horários e Expediente da Oficina -->
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-700 space-y-1.5 shadow-sm">
              <span class="font-bold flex items-center gap-1.5 text-slate-900 text-xs uppercase tracking-wide">
                <i data-lucide="clock" class="w-4 h-4 text-brand-600"></i>
                Expediente da Oficina:
              </span>
              <ul class="text-[11px] text-slate-600 space-y-1 pl-4 list-disc">
                <li><strong class="text-slate-800">Segunda a Sexta:</strong> 08:00 às 18:00 <span class="text-amber-700 font-semibold">(Almoço: 12:00 às 14:00)</span></li>
                <li><strong class="text-slate-800">Sábado:</strong> 08:00 às 12:00 <span class="text-brand-700 font-semibold">(Início até as 10:00)</span></li>
                <li><strong class="text-red-700">Domingo:</strong> <span class="text-red-600 font-semibold">Fechado</span></li>
              </ul>
            </div>

            <form action="/agendamentos" method="POST" class="space-y-4">
              
              <!-- Cliente -->
              <div>
                <label for="cliente_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Cliente proprietário *</label>
                <select id="cliente_id" name="cliente_id" required onchange="carregarVeiculosDoCliente(this.value)"
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
                  <option value="" disabled selected>Selecione o cliente...</option>
                  <% clientes.forEach(cli => { %>
                    <option value="<%= cli.id %>"><%= cli.usuario.nome %> (CPF: <%= formatarCPF(cli.cpf) %>)</option>
                  <% }) %>
                </select>
              </div>

              <!-- Veículo -->
              <div>
                <label for="veiculo_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Veículo do Cliente *</label>
                <select id="veiculo_id" name="veiculo_id" required disabled
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium disabled:opacity-60">
                  <option value="" disabled selected>Selecione o veículo...</option>
                </select>
              </div>

              <!-- Serviço Pretendido (Opcional) -->
              <div>
                <label for="servico_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Serviço Pretendido</label>
                <select id="servico_id" name="servico_id" onchange="aoMudarServico(this)"
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
                  <option value="" selected>Revisão Personalizada / Outro</option>
                  <% servicos.forEach(s => { %>
                    <option value="<%= s.id %>" data-nome="<%= s.nome %>"><%= s.nome %></option>
                  <% }) %>
                </select>
              </div>

              <!-- Duração da Revisão / Bloco de Tempo Requerido -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="duracao_minutos" class="block text-xs font-bold text-slate-700 uppercase tracking-wide">Duração da Revisão *</label>
                  <span id="badgeDuracao" class="text-[11px] font-black text-brand-700 bg-brand-50 border border-brand-200 px-2 py-0.5 rounded-lg">1 hora (padrão)</span>
                </div>
                <select id="duracao_minutos" name="duracao_minutos" required onchange="aoMudarDuracao(this.value)"
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
                  <% if (typeof opcoesDuracao !== 'undefined' && opcoesDuracao.length > 0) { %>
                    <% opcoesDuracao.forEach(op => { %>
                      <option value="<%= op.minutos %>" <%= op.minutos === 60 ? 'selected' : '' %>><%= op.rotulo %></option>
                    <% }) %>
                  <% } else { %>
                    <option value="30">30 min (Check-up / Inspeção Rápida)</option>
                    <option value="60" selected>1 hora (Troca de Óleo / Filtros)</option>
                    <option value="90">1h 30 min (Freios / Suspensão)</option>
                    <option value="120">2 horas (Revisão Periódica Completa)</option>
                    <option value="150">2h 30 min (Revisão Intermediária)</option>
                    <option value="180">3 horas (Correia Dentada / Embreagem)</option>
                    <option value="240">4 horas (Meio Período / Motor)</option>
                    <option value="480">8 horas (Dia Inteiro / Geral)</option>
                  <% } %>
                </select>
                <span class="text-[11px] text-slate-500 mt-1 block leading-tight font-normal">Ajuste o tempo necessário conforme a complexidade do serviço.</span>
              </div>

              <!-- Data do Agendamento -->
              <div>
                <label for="data_agendada" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Data Agendada *</label>
                <input type="date" id="data_agendada" name="data_agendada" required onchange="carregarHorariosDisponiveis(this.value)"
                       min="<%= new Date().toLocaleDateString('en-CA') %>"
                       class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              </div>

              <!-- Horário Agendado (Início) -->
              <div>
                <label for="horario_agendado" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Horário de Início (30 em 30 min) *</label>
                <select id="horario_agendado" name="horario_agendado" required disabled onchange="aoMudarHorarioInicio(this.value)"
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium disabled:opacity-60">
                  <option value="" disabled selected>Selecione a data para ver horários...</option>
                </select>
                <span class="text-[11px] text-slate-500 mt-1 block leading-tight font-normal">Horários ocupados ou sem tempo hábil estarão desabilitados.</span>
              </div>

              <!-- Resumo do Bloco Selecionado -->
              <input type="hidden" id="horario_fim" name="horario_fim" value="">
              <div id="cardBlocoResumo" class="hidden p-3.5 rounded-xl bg-sky-50 border border-sky-200 text-sky-950 text-xs sm:text-sm transition-all shadow-sm">
                <div class="flex items-center justify-between font-bold">
                  <span class="flex items-center gap-1.5 text-sky-800">
                    <i data-lucide="clock" class="w-4 h-4 text-sky-600"></i>
                    <span>Bloco Reservado:</span>
                  </span>
                  <span id="textoBlocoResumo" class="font-extrabold text-sky-950 text-sm">--:-- às --:--</span>
                </div>
                <p class="text-[11px] text-sky-700 mt-1 font-medium leading-relaxed">
                  Os boxes da oficina ficarão reservados continuamente para este veículo durante todo esse período.
                </p>
              </div>

              <!-- Motivo da Revisão -->
              <div>
                <label for="motivo_revisao" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Motivo / Reclamações *</label>
                <input type="text" id="motivo_revisao" name="motivo_revisao" required placeholder="Ex: Troca de óleo + revisão de freios"
                       class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              </div>

              <!-- Observações Internas -->
              <div>
                <label for="observacoes" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Observações da Oficina</label>
                <textarea id="observacoes" name="observacoes" rows="2" placeholder="Observações opcionais..."
                          class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm sm:text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all resize-none"></textarea>
              </div>

              <button type="submit" 
                      class="w-full bg-brand-500 hover:bg-brand-600 active:scale-[0.98] text-white font-bold py-3 px-4 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 transition-all text-sm sm:text-base flex items-center justify-center space-x-2">
                <span>Criar Agendamento</span>
                <i data-lucide="check" class="w-4 h-4"></i>
              </button>

            </form>
          </div>
        <% } %>

        <!-- Detalhes do Evento Clicado (Card Dinâmico em JS) -->
        <div id="cardDetalheEvento" class="hidden bg-slate-900 text-white rounded-2xl border border-slate-800 p-5 sm:p-6 space-y-4 shadow-xl transition-all">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-sm text-brand-300">Detalhes do Compromisso</h3>
              <span id="eventoStatusBadge" class="text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-sky-500/20 text-sky-300 border border-sky-500/30">Agendado</span>
            </div>
            <button onclick="fecharDetalheEvento()" class="w-8 h-8 flex items-center justify-center hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition-colors">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
          
          <div class="space-y-3 text-xs sm:text-sm">
            <div>
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Cliente</span>
              <span id="eventoCliente" class="font-bold text-white block mt-0.5 text-sm sm:text-base"></span>
            </div>
            <div>
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider mb-1">Veículo (Placa)</span>
              <span id="eventoVeiculo" class="placa-mercosul px-2.5 py-0.5 text-sm inline-block"></span>
            </div>
            <div>
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Horário do Bloco</span>
              <span id="eventoHorario" class="font-bold text-emerald-400 block mt-0.5 text-sm sm:text-base"></span>
            </div>
            <div id="divEventoServico" class="hidden">
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Serviço</span>
              <span id="eventoServico" class="text-sky-300 font-bold block mt-0.5 text-xs sm:text-sm"></span>
            </div>
            <div>
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Motivo / Reclamação</span>
              <span id="eventoMotivo" class="text-white block mt-0.5 italic text-sm"></span>
            </div>
            <div id="divEventoObs" class="hidden">
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Observações Internas</span>
              <p id="eventoObs" class="text-slate-300 block mt-0.5 p-2.5 bg-slate-800/80 rounded-xl border border-slate-700/60 text-xs sm:text-sm"></p>
            </div>

            <div id="divEventoCancelado" class="hidden">
              <span class="block text-red-400 font-bold text-[10px] uppercase tracking-wider">Motivo do Cancelamento</span>
              <p id="eventoMotivoCancelamento" class="text-red-200 block mt-0.5 p-2.5 bg-red-950/60 rounded-xl border border-red-800/60 text-xs sm:text-sm italic"></p>
            </div>

            <!-- Confirmação de Presença -->
            <div id="divEventoPresenca" class="pt-2 border-t border-slate-800/80">
              <span class="block text-slate-400 font-bold text-[10px] uppercase tracking-wider">Confirmação de Presença</span>
              <div id="eventoPresencaBadgeContainer" class="mt-1 flex items-center gap-2">
                <!-- Injetado dinamicamente -->
              </div>
            </div>
            
            <!-- Painel Informativo para Agendamento Concluído (Tempo alocado finalizado) -->
            <div id="divEventoConcluidoInfo" class="hidden pt-3 border-t border-slate-800 space-y-2.5">
              <div class="p-3 rounded-xl bg-emerald-950/60 border border-emerald-800/60 text-emerald-200">
                <div class="flex items-start gap-2">
                  <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0"></i>
                  <div>
                    <span class="text-xs font-bold text-white block">Tempo Alocado Finalizado</span>
                    <p class="text-[11px] text-emerald-300/90 leading-relaxed mt-0.5">
                      Este atendimento foi marcado como concluído. Caso o cliente necessite de mais slots de tempo ou novos serviços, realize um novo agendamento conforme a disponibilidade da oficina.
                    </p>
                  </div>
                </div>
              </div>
              <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                <button type="button" onclick="prepararNovoSlotDoModal()" class="w-full py-2.5 px-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs transition-all flex items-center justify-center gap-1.5 shadow-md shadow-brand-500/10 active:scale-[0.98]">
                  <i data-lucide="calendar-plus" class="w-4 h-4"></i>
                  <span>Agendar Novo Slot para este Veículo</span>
                </button>
              <% } %>
            </div>

            <!-- Ações Rápidas de Status -->
            <div id="divAcoesEvento" class="pt-3 border-t border-slate-800 flex items-center gap-2 flex-wrap">
              <button id="btnConfirmarPresencaEvento" onclick="darBaixaPresencaCalendario()" class="py-2 px-3 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                <i data-lucide="user-check" class="w-3.5 h-3.5"></i>
                <span>Confirmar Presença</span>
              </button>
              <button id="btnConcluirEvento" onclick="alterarStatusEvento('concluido')" class="flex-1 py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                <span>Marcar Concluído</span>
              </button>
              <button id="btnCancelarEvento" onclick="alterarStatusEvento('cancelado')" class="py-2 px-3 rounded-xl bg-red-600/80 hover:bg-red-700 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                <i data-lucide="x-circle" class="w-3.5 h-3.5"></i>
                <span>Cancelar</span>
              </button>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  // Carrega os veículos de um cliente via AJAX API
  async function carregarVeiculosDoCliente(clienteId) {
    const selectVeiculo = document.getElementById('veiculo_id');
    selectVeiculo.innerHTML = '<option value="" disabled selected>Buscando veículos...</option>';
    selectVeiculo.disabled = true;

    if (!clienteId) return;

    try {
      const res = await fetch(`/api/clientes/${clienteId}/veiculos`);
      if (res.ok) {
        const veiculos = await res.json();
        selectVeiculo.innerHTML = '<option value="" disabled selected>Selecione o veículo...</option>';
        if (veiculos.length === 0) {
          selectVeiculo.innerHTML = '<option value="" disabled>Nenhum veículo cadastrado para este cliente.</option>';
        } else {
          veiculos.forEach(v => {
            const desc = v.modelo ? `${v.modelo.marca.nome} ${v.modelo.nome} (${v.placa})` : v.placa;
            selectVeiculo.innerHTML += `<option value="${v.id}">${desc}</option>`;
          });
          selectVeiculo.disabled = false;
        }
      } else {
        selectVeiculo.innerHTML = '<option value="" disabled>Erro ao buscar veículos.</option>';
      }
    } catch (error) {
      console.error(error);
      selectVeiculo.innerHTML = '<option value="" disabled>Erro de conexão.</option>';
    }
  }

  let eventoSelecionadoId = null;
  let eventoSelecionadoProps = null;
  let calendarInstance = null;

  function aoMudarServico(selectElem) {
    const opt = selectElem.options[selectElem.selectedIndex];
    const nomeServico = opt ? opt.getAttribute('data-nome') : '';
    const inputMotivo = document.getElementById('motivo_revisao');
    const selectDuracao = document.getElementById('duracao_minutos');

    if (nomeServico) {
      if (!inputMotivo.value || inputMotivo.value.trim() === '') {
        inputMotivo.value = nomeServico;
      }
      
      // Sugestão de duração baseada no tipo de serviço
      const nomeLower = nomeServico.toLowerCase();
      let minutosSugeridos = 60;
      if (nomeLower.includes('alinhamento') || nomeLower.includes('balanceamento') || nomeLower.includes('higienização') || nomeLower.includes('check')) {
        minutosSugeridos = 30;
      } else if (nomeLower.includes('freio') || nomeLower.includes('pastilha') || nomeLower.includes('suspensão')) {
        minutosSugeridos = 90;
      } else if (nomeLower.includes('revisão periódica') || nomeLower.includes('injeção')) {
        minutosSugeridos = 120;
      } else if (nomeLower.includes('correia') || nomeLower.includes('embreagem')) {
        minutosSugeridos = 180;
      } else if (nomeLower.includes('motor') || nomeLower.includes('câmbio')) {
        minutosSugeridos = 240;
      }

      if (selectDuracao) {
        selectDuracao.value = String(minutosSugeridos);
        aoMudarDuracao(minutosSugeridos);
      }
    }
  }

  function aoMudarDuracao(novaDuracao) {
    const dataInput = document.getElementById('data_agendada');
    const badge = document.getElementById('badgeDuracao');
    const select = document.getElementById('duracao_minutos');
    const textoSel = select.options[select.selectedIndex]?.text.split('(')[0].trim() || `${novaDuracao} min`;
    if (badge) badge.textContent = textoSel;

    if (dataInput && dataInput.value) {
      carregarHorariosDisponiveis(dataInput.value);
    }
  }

  function aoMudarHorarioInicio(horarioInicio) {
    const duracao = parseInt(document.getElementById('duracao_minutos').value, 10) || 60;
    const cardBloco = document.getElementById('cardBlocoResumo');
    const textoBloco = document.getElementById('textoBlocoResumo');
    const inputFim = document.getElementById('horario_fim');

    if (!horarioInicio) {
      cardBloco.classList.add('hidden');
      return;
    }

    const [h, m] = horarioInicio.split(':').map(Number);
    const totalMinFim = h * 60 + m + duracao;
    const fimH = String(Math.floor(totalMinFim / 60)).padStart(2, '0');
    const fimM = String(totalMinFim % 60).padStart(2, '0');
    const horarioFim = `${fimH}:${fimM}`;

    inputFim.value = horarioFim;
    
    const hDur = Math.floor(duracao / 60);
    const mDur = duracao % 60;
    let durStr = '';
    if (hDur > 0) durStr += `${hDur}h`;
    if (mDur > 0) durStr += (durStr ? ' ' : '') + `${mDur}min`;

    textoBloco.textContent = `${horarioInicio} às ${horarioFim} (${durStr})`;
    cardBloco.classList.remove('hidden');
    lucide.createIcons();
  }

  // Carrega horários disponíveis de acordo com a duração e ocupação do dia
  async function carregarHorariosDisponiveis(data) {
    const selectHorario = document.getElementById('horario_agendado');
    const duracao = document.getElementById('duracao_minutos') ? document.getElementById('duracao_minutos').value : 60;
    selectHorario.innerHTML = '<option value="" disabled selected>Calculando blocos disponíveis...</option>';
    selectHorario.disabled = true;

    if (!data) return;

    // Checar se a data selecionada está no passado
    const agoraHoje = new Date();
    const hojeLocalStr = agoraHoje.toLocaleDateString('en-CA');
    if (data < hojeLocalStr) {
      Swal.fire({
        icon: 'warning',
        title: 'Data no Passado',
        text: 'Não é possível agendar atendimentos em datas passadas. O calendário retroativo permanece bloqueado para novos agendamentos.',
        confirmButtonColor: '#0284c7'
      });
      document.getElementById('data_agendada').value = '';
      selectHorario.innerHTML = '<option value="" disabled selected>Data passada indisponível</option>';
      selectHorario.disabled = true;
      document.getElementById('cardBlocoResumo').classList.add('hidden');
      return;
    }

    // Checar se a data selecionada é domingo (Oficina fechada)
    const [ano, mes, dia] = data.split('-').map(Number);
    const dt = new Date(ano, mes - 1, dia, 12, 0, 0);
    if (dt.getDay() === 0) {
      Swal.fire({
        icon: 'warning',
        title: 'Oficina Fechada aos Domingos',
        text: 'A oficina não abre aos domingos. Por favor, escolha uma data de segunda-feira a sábado.',
        confirmButtonColor: '#0284c7'
      });
      document.getElementById('data_agendada').value = '';
      selectHorario.innerHTML = '<option value="" disabled selected>Oficina fechada aos domingos</option>';
      selectHorario.disabled = true;
      document.getElementById('cardBlocoResumo').classList.add('hidden');
      return;
    }

    try {
      const res = await fetch(`/agendamentos/horarios-disponiveis?data=${data}&duracao=${duracao}`);
      if (res.ok) {
        const lista = await res.json();
        selectHorario.innerHTML = '<option value="" disabled selected>Selecione o horário de início...</option>';
        
        let primeiroDisponivel = null;

        lista.forEach(item => {
          if (item.ocupado) {
            selectHorario.innerHTML += `<option value="${item.horario}" disabled class="text-red-400 bg-red-50 font-bold">${item.horario} às ${item.horario_fim} (${item.motivo_bloqueio || 'Ocupado'})</option>`;
          } else {
            if (!primeiroDisponivel) primeiroDisponivel = item.horario;
            selectHorario.innerHTML += `<option value="${item.horario}" class="text-slate-900 font-medium">${item.horario} às ${item.horario_fim} (Disponível)</option>`;
          }
        });
        selectHorario.disabled = false;
        
        if (selectHorario.value) {
          aoMudarHorarioInicio(selectHorario.value);
        } else {
          document.getElementById('cardBlocoResumo').classList.add('hidden');
        }
      } else {
        selectHorario.innerHTML = '<option value="" disabled>Erro ao buscar agenda.</option>';
      }
    } catch (error) {
      console.error(error);
      selectHorario.innerHTML = '<option value="" disabled>Erro de conexão.</option>';
    }
  }

  function fecharDetalheEvento() {
    document.getElementById('cardDetalheEvento').classList.add('hidden');
    eventoSelecionadoId = null;
    eventoSelecionadoProps = null;
  }

  async function prepararNovoSlotDoModal() {
    if (!eventoSelecionadoProps) return;
    const { clienteId, veiculoId } = eventoSelecionadoProps;

    const selectCliente = document.getElementById('cliente_id');
    if (selectCliente && clienteId) {
      selectCliente.value = String(clienteId);
      await carregarVeiculosDoCliente(clienteId);

      if (veiculoId) {
        const selectVeiculo = document.getElementById('veiculo_id');
        if (selectVeiculo) {
          selectVeiculo.value = String(veiculoId);
        }
      }

      const dataInput = document.getElementById('data_agendada');
      if (dataInput) {
        dataInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        dataInput.focus();
      }

      Swal.fire({
        icon: 'info',
        title: 'Novo Slot de Horário',
        text: 'Cliente e veículo pré-selecionados. Escolha a data e o horário disponível desejados para o novo agendamento.',
        timer: 3500,
        showConfirmButton: false,
        customClass: { popup: 'rounded-2xl font-sans' }
      });
    }
  }

  async function alterarStatusEvento(novoStatus) {
    if (!eventoSelecionadoId) return;

    if (novoStatus === 'cancelado') {
      const agoraEv = new Date();
      const hojeStrEv = agoraEv.toLocaleDateString('en-CA');
      const horaAtualStrEv = agoraEv.toTimeString().substring(0, 5);
      const dataEv = eventoSelecionadoProps?.dataAgendada || '';
      const horaEv = eventoSelecionadoProps?.horarioInicio || '';
      const ehPassado = dataEv < hojeStrEv || (dataEv === hojeStrEv && horaEv <= horaAtualStrEv);

      const tituloModal = ehPassado ? 'Tratar / Cancelar Agendamento Passado' : 'Cancelar Agendamento';
      const textoModal = ehPassado
        ? 'Este agendamento é de uma data passada. O cancelamento registrará a ocorrência/não comparecimento no histórico do veículo e do cliente (datas passadas não abrem vagas para agendamento). Por favor, informe o motivo:'
        : 'O agendamento será cancelado e o horário futuro será desocupado na agenda. Por favor, informe o motivo do cancelamento (obrigatório):';
      const placeholderModal = ehPassado
        ? 'Ex: Cliente não compareceu, cancelou com antecedência...'
        : 'Ex: Cliente solicitou reagendamento, imprevisto com peças...';

      const { value: motivo, isConfirmed } = await Swal.fire({
        title: tituloModal,
        text: textoModal,
        input: 'textarea',
        inputPlaceholder: placeholderModal,
        inputAttributes: {
          'aria-label': 'Motivo do cancelamento'
        },
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Confirmar Cancelamento',
        cancelButtonText: 'Manter Agendamento',
        inputValidator: (value) => {
          if (!value || !value.trim()) {
            return 'O motivo do cancelamento é obrigatório!';
          }
          if (value.trim().length < 4) {
            return 'O motivo deve conter ao menos 4 caracteres.';
          }
        }
      });

      if (!isConfirmed || !motivo) return;

      try {
        const res = await fetch(`/agendamentos/${eventoSelecionadoId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            status: 'cancelado',
            motivo_cancelamento: motivo.trim()
          })
        });

        if (res.ok) {
          Swal.fire({
            icon: 'success',
            title: 'Cancelado com Sucesso',
            text: ehPassado
              ? 'O agendamento do passado foi cancelado e arquivado no histórico. Datas passadas permanecem indisponíveis na agenda.'
              : 'O agendamento foi cancelado e a data e horário foram liberados para novo agendamento.',
            timer: 2000,
            showConfirmButton: false
          });
          fecharDetalheEvento();
          if (calendarInstance) {
            calendarInstance.refetchEvents();
          }
          const dataInput = document.getElementById('data_agendada');
          if (dataInput && dataInput.value) {
            carregarHorariosDisponiveis(dataInput.value);
          }
        } else {
          const txt = await res.text();
          Swal.fire('Aviso', txt || 'Não foi possível cancelar o agendamento.', 'warning');
        }
      } catch (err) {
        console.error(err);
        Swal.fire('Erro', 'Falha na conexão.', 'error');
      }
      return;
    }

    const confirmacao = await Swal.fire({
      title: 'Concluir Agendamento?',
      text: 'Deseja marcar este agendamento como realizado e concluído?',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#10b981',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Sim, concluir',
      cancelButtonText: 'Voltar'
    });

    if (confirmacao.isConfirmed) {
      try {
        const res = await fetch(`/agendamentos/${eventoSelecionadoId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: novoStatus })
        });
        if (res.ok) {
          Swal.fire({
            icon: 'success',
            title: 'Concluído!',
            text: 'Agendamento concluído com sucesso.',
            timer: 1500,
            showConfirmButton: false
          });
          fecharDetalheEvento();
          if (calendarInstance) {
            calendarInstance.refetchEvents();
          }
        } else {
          const txt = await res.text();
          Swal.fire('Aviso', txt || 'Não foi possível alterar o status.', 'warning');
        }
      } catch (err) {
        console.error(err);
        Swal.fire('Erro', 'Falha na conexão.', 'error');
      }
    }
  }

  async function darBaixaPresencaCalendario() {
    if (!eventoSelecionadoId) return;

    const result = await Swal.fire({
      title: 'Dar Baixa na Presença?',
      text: 'Confirma que o cliente comparecerá a este agendamento?',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#10b981',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Sim, confirmar presença!',
      cancelButtonText: 'Voltar',
      customClass: {
        popup: 'rounded-2xl font-sans',
        confirmButton: 'rounded-xl font-bold px-4 py-2 text-sm',
        cancelButton: 'rounded-xl font-bold px-4 py-2 text-sm'
      }
    });

    if (!result.isConfirmed) return;

    try {
      const res = await fetch(`/agendamentos/${eventoSelecionadoId}/confirmar-presenca`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });

      if (res.ok) {
        Swal.fire({
          icon: 'success',
          title: 'Presença Confirmada!',
          text: 'Baixa registrada no sistema com sucesso.',
          timer: 1500,
          showConfirmButton: false
        });
        fecharDetalheEvento();
        if (calendarInstance) {
          calendarInstance.refetchEvents();
        }
      } else {
        const erro = await res.json();
        Swal.fire('Atenção', erro.erro || 'Falha ao confirmar presença.', 'error');
      }
    } catch (e) {
      console.error(e);
      Swal.fire('Erro', 'Não foi possível se comunicar com o servidor.', 'error');
    }
  }

  // Inicialização do Calendário FullCalendar v6 com responsividade mobile inteligente (RF-17)
  function inicializarCalendario() {
    const calendarEl = document.getElementById('calendar');
    if (!calendarEl || typeof FullCalendar === 'undefined') return;

    if (calendarInstance) {
      try {
        calendarInstance.destroy();
      } catch (e) {}
      calendarInstance = null;
    }

    const isMobile = window.innerWidth < 768;
    
    calendarInstance = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      headerToolbar: isMobile ? {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridDay'
      } : {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,timeGridDay'
      },
      locale: 'pt-br',
      allDaySlot: false,
      allDayText: 'Dia Inteiro',
      slotMinTime: '08:00:00',
      slotMaxTime: '18:30:00',
      slotDuration: '00:30:00',
      slotLabelInterval: '01:00',
      slotLabelFormat: {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      },
      eventTimeFormat: {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      },
      dayHeaderFormat: isMobile ? { weekday: 'narrow' } : { weekday: 'short' },
      buttonIcons: {
        prev: 'chevron-left',
        next: 'chevron-right'
      },
      buttonText: {
        today: 'Hoje',
        month: 'Mês',
        week: 'Semana',
        day: 'Dia',
        list: 'Lista'
      },
      buttonHints: {
        prev: 'Período anterior',
        next: 'Próximo período',
        today: (t) => t === 'Dia' ? 'Hoje' : ('Este ' + (t ? t.toLowerCase() : 'período')),
        month: 'Visualizar mês',
        week: 'Visualizar semana',
        day: 'Visualizar dia'
      },
      viewHint: (v) => `Visualizar ${v ? v.toLowerCase() : ''}`,
      navLinkHint: 'Ir para $0',
      closeHint: 'Fechar',
      timeHint: 'Hora',
      eventHint: 'Agendamento',
      moreLinkText: (n) => `+${n} mais`,
      moreLinkHint: (n) => `Mostrar mais ${n} agendamentos`,
      noEventsText: 'Nenhum agendamento para exibir',
      events: '/agendamentos/calendario',
      businessHours: [
        {
          daysOfWeek: [1, 2, 3, 4, 5], // Seg a Sex
          startTime: '08:00',
          endTime: '18:00'
        },
        {
          daysOfWeek: [6], // Sábado
          startTime: '08:00',
          endTime: '12:00'
        }
      ],
      dateClick: function(info) {
        const dataStr = info.dateStr.split('T')[0];
        const agoraClick = new Date();
        const hojeClickStr = agoraClick.toLocaleDateString('en-CA');
        const horaAtualClickStr = agoraClick.toTimeString().substring(0, 5);

        // Bloqueio de cliques em datas passadas
        if (dataStr < hojeClickStr) {
          Swal.fire({
            icon: 'warning',
            title: 'Data no Passado',
            text: 'Não é possível agendar em datas passadas. O calendário retroativo permanece indisponível para novos agendamentos.',
            confirmButtonColor: '#0284c7'
          });
          return;
        }

        // Bloqueio de cliques em horários passados do dia de hoje
        if (info.dateStr.includes('T')) {
          const horaStr = info.dateStr.split('T')[1].substring(0, 5);
          if (dataStr === hojeClickStr && horaStr <= horaAtualClickStr) {
            Swal.fire({
              icon: 'warning',
              title: 'Horário já Transcorrido',
              text: 'Este horário de hoje já passou. Por favor, escolha um horário futuro.',
              confirmButtonColor: '#0284c7'
            });
            return;
          }
        }

        const [ano, mes, dia] = dataStr.split('-').map(Number);
        const dt = new Date(ano, mes - 1, dia, 12, 0, 0);
        if (dt.getDay() === 0) {
          Swal.fire({
            icon: 'warning',
            title: 'Oficina Fechada aos Domingos',
            text: 'A oficina não abre aos domingos. Por favor, escolha uma data entre segunda-feira e sábado.',
            confirmButtonColor: '#0284c7'
          });
          return;
        }

        const dataInput = document.getElementById('data_agendada');
        if (dataInput) {
          dataInput.value = dataStr;
          carregarHorariosDisponiveis(dataStr);

          if (info.dateStr.includes('T')) {
            const horaStr = info.dateStr.split('T')[1].substring(0, 5);
            setTimeout(() => {
              const selectHorario = document.getElementById('horario_agendado');
              if (selectHorario) {
                selectHorario.value = horaStr;
                aoMudarHorarioInicio(horaStr);
              }
            }, 350);
          }
          dataInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      },
      eventClick: function(info) {
        const props = info.event.extendedProps;
        eventoSelecionadoId = info.event.id;
        eventoSelecionadoProps = props;

        document.getElementById('eventoCliente').innerText = props.cliente;
        
        const placaEl = document.getElementById('eventoVeiculo');
        const placaStr = props.placa || '';
        const placaLimpa = placaStr.toUpperCase().replace(/[^A-Z0-9]/g, '');
        const isMercosul = /^[A-Z]{3}[0-9][A-Z][0-9]{2}$/.test(placaLimpa);
        const formatada = (placaLimpa.length === 7 && /^[A-Z]{3}[0-9]{4}$/.test(placaLimpa))
          ? placaLimpa.replace(/([A-Z]{3})([0-9]{4})/, '$1-$2')
          : placaStr;
        placaEl.innerText = formatada;
        placaEl.className = (isMercosul ? 'placa-mercosul' : 'placa-antiga') + ' px-2.5 py-0.5 text-sm inline-block';

        const dataFormatada = info.event.start.toLocaleDateString('pt-BR');
        const hInicio = props.horarioInicio || (info.event.startStr ? info.event.startStr.split('T')[1]?.substring(0, 5) : '');
        const hFim = props.horarioFim || (info.event.endStr ? info.event.endStr.split('T')[1]?.substring(0, 5) : '');
        
        let durTexto = '';
        if (props.duracaoMinutos) {
          const hDur = Math.floor(props.duracaoMinutos / 60);
          const mDur = props.duracaoMinutos % 60;
          let str = '';
          if (hDur > 0) str += `${hDur}h`;
          if (mDur > 0) str += (str ? ' ' : '') + `${mDur}min`;
          durTexto = ` (${str})`;
        }

        document.getElementById('eventoHorario').innerText = `${dataFormatada} • ${hInicio} às ${hFim}${durTexto}`;
        document.getElementById('eventoMotivo').innerText = `"${props.motivo}"`;

        const badgeStatus = document.getElementById('eventoStatusBadge');
        if (props.status === 'concluido') {
          badgeStatus.className = 'text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
          badgeStatus.textContent = 'Concluído';
        } else if (props.status === 'cancelado') {
          badgeStatus.className = 'text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-red-500/20 text-red-300 border border-red-500/30';
          badgeStatus.textContent = 'Cancelado';
        } else {
          badgeStatus.className = 'text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-sky-500/20 text-sky-300 border border-sky-500/30';
          badgeStatus.textContent = 'Agendado';
        }

        const divServico = document.getElementById('divEventoServico');
        if (props.servico) {
          document.getElementById('eventoServico').innerText = props.servico;
          divServico.classList.remove('hidden');
        } else {
          divServico.classList.add('hidden');
        }

        if (props.observacoes) {
          document.getElementById('eventoObs').innerText = props.observacoes;
          document.getElementById('divEventoObs').classList.remove('hidden');
        } else {
          document.getElementById('divEventoObs').classList.add('hidden');
        }

        // Exibir motivo do cancelamento se cancelado
        const divCancelado = document.getElementById('divEventoCancelado');
        if (props.status === 'cancelado' && props.motivoCancelamento) {
          document.getElementById('eventoMotivoCancelamento').innerText = props.motivoCancelamento;
          divCancelado.classList.remove('hidden');
        } else {
          divCancelado.classList.add('hidden');
        }

        // Exibição do Status de Presença e Botão Confirmar Presença
        const presencaContainer = document.getElementById('eventoPresencaBadgeContainer');
        const btnConfirmarPresenca = document.getElementById('btnConfirmarPresencaEvento');

        if (props.status === 'cancelado') {
          presencaContainer.innerHTML = '<span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-500/20 text-slate-300 border border-slate-500/30"><i data-lucide="x-circle" class="w-3.5 h-3.5 text-slate-400"></i> Agendamento Cancelado</span>';
          if (btnConfirmarPresenca) btnConfirmarPresenca.classList.add('hidden');
        } else if (props.confirmacaoPresenca === 'confirmada') {
          presencaContainer.innerHTML = '<span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"><i data-lucide="user-check" class="w-3.5 h-3.5 text-emerald-400"></i> Presença Confirmada</span>';
          if (btnConfirmarPresenca) btnConfirmarPresenca.classList.add('hidden');
        } else if (props.confirmacaoPresenca === 'solicitada') {
          presencaContainer.innerHTML = '<span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-0.5 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30"><i data-lucide="message-square" class="w-3.5 h-3.5 text-blue-400"></i> WhatsApp Enviado (Aguardando)</span>';
          if (btnConfirmarPresenca) {
            if (props.status === 'agendado') btnConfirmarPresenca.classList.remove('hidden');
            else btnConfirmarPresenca.classList.add('hidden');
          }
        } else {
          presencaContainer.innerHTML = '<span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30"><i data-lucide="help-circle" class="w-3.5 h-3.5 text-amber-400"></i> Presença a Confirmar</span>';
          if (btnConfirmarPresenca) {
            if (props.status === 'agendado') btnConfirmarPresenca.classList.remove('hidden');
            else btnConfirmarPresenca.classList.add('hidden');
          }
        }

        // Regra de Negócio: Bloquear conclusão de agendamentos futuros
        const agoraEv = new Date();
        const hojeStrEv = agoraEv.toLocaleDateString('en-CA');
        const horaAtualStrEv = agoraEv.toTimeString().substring(0, 5);
        const dataAgEv = props.dataAgendada || (info.event.startStr ? info.event.startStr.split('T')[0] : '');
        const ehFuturoEv = dataAgEv > hojeStrEv || (dataAgEv === hojeStrEv && hInicio > horaAtualStrEv);

        const divAcoes = document.getElementById('divAcoesEvento');
        const divConcluidoInfo = document.getElementById('divEventoConcluidoInfo');
        const btnConcluir = document.getElementById('btnConcluirEvento');
        const btnCancelar = document.getElementById('btnCancelarEvento');

        if (props.status === 'concluido') {
          divAcoes.classList.add('hidden');
          if (divConcluidoInfo) divConcluidoInfo.classList.remove('hidden');
        } else if (props.status === 'cancelado') {
          divAcoes.classList.add('hidden');
          if (divConcluidoInfo) divConcluidoInfo.classList.add('hidden');
        } else {
          if (divConcluidoInfo) divConcluidoInfo.classList.add('hidden');
          divAcoes.classList.remove('hidden');
          if (ehFuturoEv) {
            btnConcluir.classList.add('hidden'); // Mecânico não tem máquina do tempo!
          } else {
            btnConcluir.classList.remove('hidden');
          }
          btnCancelar.classList.remove('hidden');
        }

        const card = document.getElementById('cardDetalheEvento');
        card.classList.remove('hidden');
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        lucide.createIcons();
      },
      windowResize: function(view) {
        const mobileAgora = window.innerWidth < 768;
        calendarInstance.setOption('headerToolbar', mobileAgora ? {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridDay'
        } : {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridWeek,timeGridDay'
        });
        calendarInstance.setOption('dayHeaderFormat', mobileAgora ? { weekday: 'narrow' } : { weekday: 'short' });
      }
    });

    calendarInstance.render();

    // Pré-selecionar cliente e veículo caso venham via parâmetro de URL (ex: botão "Novo Slot")
    const urlParams = new URLSearchParams(window.location.search);
    const paramCliId = urlParams.get('cliente_id') || '<%= typeof clientePreSelecionado !== "undefined" && clientePreSelecionado ? clientePreSelecionado : "" %>';
    const paramVeicId = urlParams.get('veiculo_id') || '<%= typeof veiculoPreSelecionado !== "undefined" && veiculoPreSelecionado ? veiculoPreSelecionado : "" %>';
    
    if (paramCliId) {
      const selectCli = document.getElementById('cliente_id');
      if (selectCli) {
        selectCli.value = paramCliId;
        carregarVeiculosDoCliente(paramCliId).then(() => {
          if (paramVeicId) {
            const selectVeic = document.getElementById('veiculo_id');
            if (selectVeic) selectVeic.value = paramVeicId;
          }
          const dataInput = document.getElementById('data_agendada');
          if (dataInput) {
            dataInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            dataInput.focus();
          }
        });
      }
    }

    // Atualização em tempo real do calendário a cada 60 segundos
    if (!window._calendarioIntervalConfigurado) {
      window._calendarioIntervalConfigurado = true;
      setInterval(() => {
        if (calendarInstance) {
          calendarInstance.refetchEvents();
        }
      }, 60000);
    }
  }

  document.addEventListener('turbo:load', inicializarCalendario);
  document.addEventListener('DOMContentLoaded', inicializarCalendario);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    inicializarCalendario();
  }
</script>

