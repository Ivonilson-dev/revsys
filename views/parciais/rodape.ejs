  <!-- Rodapé da Página com Termo LGPD e Informações Legais (Apenas se logado) -->
  <% if (usuarioLogado) { %>
    <footer class="bg-slate-100 border-t border-slate-200 py-3 px-4 text-center text-xs text-slate-500 shrink-0 z-20 safe-bottom">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
        <span class="text-slate-600 font-medium">© <%= new Date().getFullYear() %> AUTEC. Todos os direitos reservados.</span>
        <span class="text-[11px] bg-slate-200/80 text-slate-700 px-3 py-1 rounded-full font-medium leading-tight">
          Este sistema coleta dados pessoais conforme a LGPD.
        </span>
      </div>
    </footer>
  <% } %>

  </main> <!-- Fechamento da tag main iniciada no menu -->

  <!-- Botão Flutuante Voltar ao Topo (Scroll to Top) com Chave de Boca (Oficina) -->
  <button id="btnScrollToTop" 
          type="button"
          class="fixed bottom-20 sm:bottom-16 right-5 sm:right-7 z-40 bg-transparent text-slate-700 hover:text-brand-600 transition-all duration-300 transform opacity-0 translate-y-4 pointer-events-none group active:scale-90 flex items-center justify-center cursor-pointer focus:outline-none p-1.5"
          aria-label="Voltar ao topo da página"
          title="Voltar ao topo">
    <i data-lucide="wrench" class="w-8 h-8 -rotate-45 group-hover:-translate-y-1.5 transition-transform duration-200 drop-shadow-md"></i>
  </button>

  <!-- Script para Interatividade do Menu Mobile & Modais -->
  <script>
    function abrirMenuMobile() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebarOverlay');
      if (sidebar && overlay) {
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      }
    }

    function fecharMenuMobile() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebarOverlay');
      if (sidebar && overlay) {
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }
    }

    // Delegação de eventos no document para funcionar de forma resiliente em qualquer transição de página
    if (!window._menuListenersConfigurados) {
      window._menuListenersConfigurados = true;

      document.addEventListener('click', (e) => {
        if (e.target.closest('#btnMenuMobile')) {
          abrirMenuMobile();
        } else if (e.target.closest('#btnFecharMenu') || e.target.closest('#btnFecharMenuTopo') || e.target.closest('#sidebarOverlay')) {
          fecharMenuMobile();
        } else if (e.target.closest('#sidebar a')) {
          // No mobile, fechar o menu automaticamente ao clicar em qualquer item
          if (window.innerWidth < 768) {
            fecharMenuMobile();
          }
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') fecharMenuMobile();
      });
    }

    // Funções Globais para Alertas e Confirmações com SweetAlert2
    function confirmarAcaoModal(e, mensagem, titulo = 'Tem certeza?', textoBotao = 'Sim, confirmar!') {
      if (e) e.preventDefault();
      const target = e ? (e.target.tagName === 'FORM' ? e.target : e.target.closest('form')) : null;
      
      return Swal.fire({
        title: titulo,
        text: mensagem,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#64748b',
        confirmButtonText: textoBotao,
        cancelButtonText: 'Cancelar',
        customClass: {
          popup: 'rounded-2xl font-sans text-base',
          confirmButton: 'rounded-xl font-bold px-4 py-2.5 text-base',
          cancelButton: 'rounded-xl font-bold px-4 py-2.5 text-base'
        }
      }).then((result) => {
        if (result.isConfirmed && target) {
          target.submit();
        }
        return result.isConfirmed;
      });
    }

    function exibirAlertaModal(titulo, texto, icone = 'info') {
      return Swal.fire({
        title: titulo,
        text: texto,
        icon: icone,
        confirmButtonColor: '#0284c7',
        confirmButtonText: 'Entendido',
        customClass: {
          popup: 'rounded-2xl font-sans text-base',
          confirmButton: 'rounded-xl font-bold px-5 py-2.5 text-base'
        }
      });
    }

    // Auto-fechar alertas de sucesso/erro após 5 segundos
    setTimeout(() => {
      const alerta = document.getElementById('alerta-global');
      if (alerta) {
        alerta.style.opacity = '0';
        setTimeout(() => alerta.remove(), 400);
      }
    }, 5000);

    // Inicialização Global de Máscaras com IMask (RNF-15)
    function inicializarMascarasGlobais() {
      if (typeof IMask === 'undefined') return;

      // 1. Telefones (Fixo de 10 dígitos ou Celular de 11 dígitos dinâmico)
      const camposTelefone = document.querySelectorAll(
        'input[data-mask="telefone"], #telefone, #telefone_whatsapp, input[name="telefone"], input[name="telefone_whatsapp"], input[name="whatsapp_numero"]'
      );
      camposTelefone.forEach(el => {
        if (!el._imask) {
          el._imask = IMask(el, {
            mask: [
              { mask: '(00) 0000-0000' },
              { mask: '(00) 00000-0000' }
            ]
          });
        }
      });

      // 2. CPF (000.000.000-00)
      const camposCPF = document.querySelectorAll(
        'input[data-mask="cpf"], #cpfInput, input[name="cpfInput"], input[name="cpf"]'
      );
      camposCPF.forEach(el => {
        if (!el._imask) {
          el._imask = IMask(el, { mask: '000.000.000-00' });
        }
      });

      // 3. CNPJ (00.000.000/0000-00)
      const camposCNPJ = document.querySelectorAll(
        'input[data-mask="cnpj"], #cnpj, input[name="cnpj"]'
      );
      camposCNPJ.forEach(el => {
        if (!el._imask) {
          el._imask = IMask(el, { mask: '00.000.000/0000-00' });
        }
      });

      // 4. CPF ou CNPJ Dinâmico
      const camposCpfCnpj = document.querySelectorAll('input[data-mask="cpf-cnpj"]');
      camposCpfCnpj.forEach(el => {
        if (!el._imask) {
          el._imask = IMask(el, {
            mask: [
              { mask: '000.000.000-00' },
              { mask: '00.000.000/0000-00' }
            ]
          });
        }
      });

      // 5. CEP (00000-000)
      const camposCEP = document.querySelectorAll(
        'input[data-mask="cep"], #cep, input[name="cep"]'
      );
      camposCEP.forEach(el => {
        if (!el._imask) {
          el._imask = IMask(el, { mask: '00000-000' });
        }
      });

      // 6. Placa (Padrão Antigo AAA-0000 ou Mercosul AAA0A00)
      const camposPlaca = document.querySelectorAll(
        'input[data-mask="placa"], #placa, input[name="placa"]'
      );
      camposPlaca.forEach(el => {
        if (!el._imask) {
          el._imask = IMask(el, {
            mask: [
              { mask: 'aaa-0000' },
              { mask: 'aaa0a00' }
            ],
            prepare: function (str) {
              return str.toUpperCase();
            }
          });
        }
      });
    }

    // 7. Scroll to Top com Ícone de Chave de Boca (Oficina)
    function configurarScrollToTop() {
      const btn = document.getElementById('btnScrollToTop');
      if (!btn) return;

      const containers = Array.from(document.querySelectorAll('main > div.overflow-y-auto, .smooth-scroll, [class*="overflow-y-auto"]'));

      function verificarScroll() {
        let maxScroll = window.scrollY || document.documentElement.scrollTop || 0;

        containers.forEach(c => {
          if (c.scrollTop > maxScroll) {
            maxScroll = c.scrollTop;
          }
        });

        if (maxScroll > 180) {
          btn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          btn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        } else {
          btn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          btn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        }
      }

      function rolarParaOTopo() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        document.documentElement.scrollTo({ top: 0, behavior: 'smooth' });
        document.body.scrollTo({ top: 0, behavior: 'smooth' });

        containers.forEach(c => {
          c.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      btn.addEventListener('click', rolarParaOTopo);

      window.addEventListener('scroll', verificarScroll, { passive: true });
      containers.forEach(c => {
        c.addEventListener('scroll', verificarScroll, { passive: true });
      });

      // Checagem imediata
      verificarScroll();
    }

    // Disparar no carregamento do DOM e a cada transição SPA pelo Turbo Drive
    function inicializarScriptsGlobais() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
      fecharMenuMobile();
      inicializarMascarasGlobais();
      configurarScrollToTop();
    }

    document.addEventListener('turbo:load', inicializarScriptsGlobais);
    document.addEventListener('DOMContentLoaded', inicializarScriptsGlobais);
    // Também executar imediatamente caso o script seja avaliado após o DOM ready
    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      inicializarScriptsGlobais();
    }
  </script>
</body>
</html>
