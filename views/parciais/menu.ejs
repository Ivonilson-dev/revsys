<!-- Cabeçalho Mobile Fixo Superior (Sticky) -->
<header class="md:hidden sticky top-0 w-full bg-slate-200/95 backdrop-blur-md text-slate-900 flex items-center justify-between px-4 py-3 z-40 border-b border-slate-300 shrink-0 shadow-xs safe-top">
  <a href="/painel" class="flex items-center space-x-2.5 active:opacity-80 transition-opacity">
    <div class="bg-slate-900 p-2 rounded-xl text-white shadow-xs">
      <i data-lucide="wrench" class="w-5 h-5"></i>
    </div>
    <div class="flex flex-col">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-600 leading-none">RevSys</span>
      <span class="text-lg font-black text-slate-900 tracking-wider uppercase leading-tight mt-0.5">AUTEC</span>
    </div>
  </a>
  
  <div class="flex items-center space-x-2">
    <% if (usuarioLogado) { %>
      <div class="relative">
        <div class="w-8 h-8 rounded-lg bg-white border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-800 select-none shadow-xs">
          <% if (usuarioLogado.papel === 'admin') { %>
            <i data-lucide="shield-check" class="w-4 h-4 text-slate-800"></i>
          <% } else { %>
            <%= usuarioLogado.nome ? usuarioLogado.nome.substring(0, 2).toUpperCase() : 'U' %>
          <% } %>
        </div>
        <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-white" title="Conectado"></span>
      </div>
    <% } %>
    <button id="btnMenuMobile" 
            class="w-11 h-11 flex items-center justify-center rounded-xl bg-white hover:bg-slate-100 text-slate-800 border border-slate-300 focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all active:scale-95 shadow-xs"
            aria-label="Abrir menu de navegação">
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
  </div>
</header>

<!-- Menu Lateral / Navegação (Desktop & Mobile Drawer) - Padrão Corporativo Cinza Industrial -->
<aside id="sidebar" 
       class="fixed inset-y-0 left-0 transform -translate-x-full md:relative md:translate-x-0 transition-transform duration-300 ease-out z-50 w-[82vw] max-w-[300px] md:w-64 bg-slate-200 text-slate-800 flex flex-col justify-between shrink-0 h-full border-r border-slate-300 shadow-xl md:shadow-none safe-top safe-bottom">
  
  <div class="flex flex-col h-full overflow-hidden">
    <!-- Topo da Sidebar: Logo & Botão Fechar no Mobile -->
    <div class="p-4 md:p-5 border-b border-slate-300 shrink-0">
      <div class="flex items-center justify-between">
        <a href="/painel" class="flex items-center space-x-3 group">
          <div class="bg-slate-900 p-2 rounded-xl text-white shadow-sm group-hover:scale-105 transition-transform">
            <i data-lucide="wrench" class="w-5 h-5"></i>
          </div>
          <div>
            <span class="text-[11px] font-bold uppercase tracking-widest text-slate-600 block leading-tight">RevSys</span>
            <span class="text-xl font-black text-slate-900 tracking-wider block uppercase">AUTEC</span>
          </div>
        </a>

        <!-- Botão X no topo da sidebar para fechar fácil no mobile -->
        <button id="btnFecharMenuTopo" 
                class="md:hidden w-9 h-9 flex items-center justify-center rounded-xl bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 hover:text-slate-900 transition-colors shadow-xs"
                aria-label="Fechar menu">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
    </div>

    <!-- Links de Navegação com Rolagem Touch -->
    <nav class="flex-1 p-3.5 space-y-1.5 overflow-y-auto smooth-scroll">
      <% if (usuarioLogado && usuarioLogado.papel !== 'cliente') { %>
        <!-- Painel -->
        <a href="/painel" class="group flex items-center space-x-3.5 p-3 rounded-xl transition-all duration-150 text-base font-semibold <%= urlAtiva === '/painel' ? 'bg-white text-slate-950 font-bold border border-slate-300 shadow-xs border-l-4 border-l-slate-900' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-300/70' %>">
          <i data-lucide="layout-dashboard" class="w-5 h-5 shrink-0 <%= urlAtiva === '/painel' ? 'text-slate-900 font-bold' : 'text-slate-600 group-hover:text-slate-950' %>"></i>
          <span>Painel</span>
        </a>

        <!-- Clientes -->
        <a href="/clientes" class="group flex items-center space-x-3.5 p-3 rounded-xl transition-all duration-150 text-base font-semibold <%= urlAtiva.startsWith('/clientes') ? 'bg-white text-slate-950 font-bold border border-slate-300 shadow-xs border-l-4 border-l-slate-900' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-300/70' %>">
          <i data-lucide="users" class="w-5 h-5 shrink-0 <%= urlAtiva.startsWith('/clientes') ? 'text-slate-900 font-bold' : 'text-slate-600 group-hover:text-slate-950' %>"></i>
          <span>Clientes</span>
        </a>

        <!-- Veículos -->
        <a href="/veiculos" class="group flex items-center space-x-3.5 p-3 rounded-xl transition-all duration-150 text-base font-semibold <%= urlAtiva.startsWith('/veiculos') ? 'bg-white text-slate-950 font-bold border border-slate-300 shadow-xs border-l-4 border-l-slate-900' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-300/70' %>">
          <i data-lucide="car" class="w-5 h-5 shrink-0 <%= urlAtiva.startsWith('/veiculos') ? 'text-slate-900 font-bold' : 'text-slate-600 group-hover:text-slate-950' %>"></i>
          <span>Veículos</span>
        </a>

        <!-- Agendamentos -->
        <a href="/agendamentos/calendario-tela" class="group flex items-center space-x-3.5 p-3 rounded-xl transition-all duration-150 text-base font-semibold <%= urlAtiva.startsWith('/agendamentos') ? 'bg-white text-slate-950 font-bold border border-slate-300 shadow-xs border-l-4 border-l-slate-900' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-300/70' %>">
          <i data-lucide="calendar" class="w-5 h-5 shrink-0 <%= urlAtiva.startsWith('/agendamentos') ? 'text-slate-900 font-bold' : 'text-slate-600 group-hover:text-slate-950' %>"></i>
          <span>Agendamentos</span>
        </a>

        <!-- Cadastros Auxiliares -->
        <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
          <a href="/cadastros" class="group flex items-center space-x-3.5 p-3 rounded-xl transition-all duration-150 text-base font-semibold <%= urlAtiva === '/cadastros' ? 'bg-white text-slate-950 font-bold border border-slate-300 shadow-xs border-l-4 border-l-slate-900' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-300/70' %>">
            <i data-lucide="settings" class="w-5 h-5 shrink-0 <%= urlAtiva === '/cadastros' ? 'text-slate-900 font-bold' : 'text-slate-600 group-hover:text-slate-950' %>"></i>
            <span>Cadastros Base</span>
          </a>
        <% } %>

        <!-- Relatórios -->
        <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
          <a href="/relatorios" class="group flex items-center space-x-3.5 p-3 rounded-xl transition-all duration-150 text-base font-semibold <%= urlAtiva.startsWith('/relatorios') ? 'bg-white text-slate-950 font-bold border border-slate-300 shadow-xs border-l-4 border-l-slate-900' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-300/70' %>">
            <i data-lucide="file-text" class="w-5 h-5 shrink-0 <%= urlAtiva.startsWith('/relatorios') ? 'text-slate-900 font-bold' : 'text-slate-600 group-hover:text-slate-950' %>"></i>
            <span>Relatórios</span>
          </a>
        <% } %>

        <!-- Auditoria (Exclusivo Administrador) -->
        <% if (usuarioLogado && usuarioLogado.papel === 'admin') { %>
          <a href="/auditoria" class="group flex items-center space-x-3.5 p-3 rounded-xl transition-all duration-150 text-base font-semibold <%= urlAtiva.startsWith('/auditoria') ? 'bg-white text-slate-950 font-bold border border-slate-300 shadow-xs border-l-4 border-l-slate-900' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-300/70' %>">
            <i data-lucide="shield-check" class="w-5 h-5 shrink-0 <%= urlAtiva.startsWith('/auditoria') ? 'text-slate-900 font-bold' : 'text-slate-600 group-hover:text-slate-950' %>"></i>
            <span>Auditoria</span>
          </a>
        <% } %>
      <% } else if (usuarioLogado && usuarioLogado.papel === 'cliente') { %>
        <!-- Área do Cliente -->
        <a href="/cliente/veiculos" class="group flex items-center space-x-3.5 p-3 rounded-xl transition-all duration-150 text-base font-semibold <%= urlAtiva.startsWith('/cliente') ? 'bg-white text-slate-950 font-bold border border-slate-300 shadow-xs border-l-4 border-l-slate-900' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-300/70' %>">
          <i data-lucide="car" class="w-5 h-5 shrink-0 <%= urlAtiva.startsWith('/cliente') ? 'text-slate-900 font-bold' : 'text-slate-600 group-hover:text-slate-950' %>"></i>
          <span>Meus Veículos</span>
        </a>
      <% } %>

      <!-- LGPD - Última opção no menu de navegação -->
      <a href="/lgpd" class="group flex items-center space-x-3.5 p-3 rounded-xl transition-all duration-150 text-base font-semibold <%= urlAtiva.startsWith('/lgpd') ? 'bg-white text-slate-950 font-bold border border-slate-300 shadow-xs border-l-4 border-l-slate-900' : 'text-slate-700 hover:text-slate-950 hover:bg-slate-300/70' %>">
        <i data-lucide="shield-check" class="w-5 h-5 shrink-0 <%= urlAtiva.startsWith('/lgpd') ? 'text-slate-900 font-bold' : 'text-slate-600 group-hover:text-slate-950' %>"></i>
        <span>LGPD</span>
      </a>
    </nav>

    <!-- Rodapé do Menu (Sair) -->
    <div class="p-3.5 border-t border-slate-300 shrink-0 space-y-2">
      <a href="/sair" data-turbo="false" class="group flex items-center space-x-3.5 p-3 rounded-xl hover:bg-red-50 hover:text-red-700 text-slate-700 text-base font-semibold transition-all w-full border border-transparent hover:border-red-200 active:scale-[0.98]">
        <i data-lucide="log-out" class="w-5 h-5 text-red-600 group-hover:text-red-700 transition-colors shrink-0"></i>
        <span>Sair do Sistema</span>
      </a>
      
      <!-- Botão Fechar Menu no Rodapé Mobile -->
      <button id="btnFecharMenu" class="md:hidden flex items-center justify-center space-x-2 py-2.5 px-4 rounded-xl border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold w-full transition-colors shadow-xs">
        <i data-lucide="x" class="w-4 h-4"></i>
        <span>Fechar Menu</span>
      </button>
    </div>
  </div>
</aside>

<!-- Overlay no Mobile com backdrop blur para fechar sidebar clicando fora -->
<div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-40 hidden md:hidden transition-opacity duration-300"></div>

<!-- Container Principal do Conteúdo -->
<main class="flex-1 flex flex-col overflow-hidden h-full">

  <!-- Barra Superior Discreta no Desktop com Usuário no Canto Superior Direito -->
  <header class="hidden md:flex items-center justify-between px-6 py-2.5 bg-white border-b border-slate-200/90 shrink-0 z-20 shadow-xs">
    <div class="flex items-center space-x-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-600 font-semibold text-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Sistema Ativo
      </span>
    </div>

    <!-- Informações Discretas do Usuário Conectado (Canto Superior Direito) -->
    <% if (usuarioLogado) { %>
      <div class="flex items-center space-x-3">
        <div class="text-right leading-tight">
          <% if (usuarioLogado.nome && usuarioLogado.nome !== 'Administrador Oficina' && usuarioLogado.nome !== 'Administrador') { %>
            <div class="text-sm font-bold text-slate-900 leading-tight">
              <%= usuarioLogado.nome %>
            </div>
          <% } %>
          <div class="flex items-center justify-end gap-1.5 <%= (usuarioLogado.nome && usuarioLogado.nome !== 'Administrador Oficina' && usuarioLogado.nome !== 'Administrador') ? 'mt-0.5' : '' %>">
            <% if (usuarioLogado.email) { %>
              <span class="text-xs text-slate-600 font-medium">
                <%= usuarioLogado.email %>
              </span>
              <span class="text-slate-300 text-xs">•</span>
            <% } %>
            <span class="inline-flex items-center gap-1 text-[11px] font-bold px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
              <% if (usuarioLogado.papel === 'admin') { %>
                <i data-lucide="shield-check" class="w-3 h-3 text-slate-700"></i>
                <span>Administrador</span>
              <% } else if (usuarioLogado.papel === 'gerente') { %>
                <i data-lucide="briefcase" class="w-3 h-3 text-slate-700"></i>
                <span>Gerente</span>
              <% } else if (usuarioLogado.papel === 'atendente') { %>
                <i data-lucide="headphones" class="w-3 h-3 text-slate-700"></i>
                <span>Atendente</span>
              <% } else if (usuarioLogado.papel === 'mecanico') { %>
                <i data-lucide="wrench" class="w-3 h-3 text-slate-700"></i>
                <span>Mecânico</span>
              <% } else { %>
                <i data-lucide="user" class="w-3 h-3 text-slate-700"></i>
                <span>Cliente</span>
              <% } %>
            </span>
          </div>
        </div>

        <!-- Avatar Compacto Circular -->
        <div class="relative shrink-0">
          <div class="w-8 h-8 rounded-full bg-slate-800 text-white font-black text-xs flex items-center justify-center select-none shadow-xs ring-2 ring-slate-100">
            <% if (usuarioLogado.papel === 'admin') { %>
              <i data-lucide="shield-check" class="w-4 h-4 text-white"></i>
            <% } else { %>
              <%= usuarioLogado.nome ? usuarioLogado.nome.substring(0, 2).toUpperCase() : 'U' %>
            <% } %>
          </div>
          <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-1.5 ring-white" title="Conectado"></span>
        </div>
      </div>
    <% } %>
  </header>

  <!-- Conteúdo de cada página é renderizado abaixo -->
