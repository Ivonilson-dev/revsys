<!-- Cabeçalho Mobile Fixo Superior (Sticky) -->
<header class="md:hidden sticky top-0 w-full bg-slate-900/95 backdrop-blur-md text-white flex items-center justify-between px-4 py-3 z-40 border-b border-slate-800 shrink-0 shadow-sm safe-top">
  <a href="/painel" class="flex items-center space-x-2.5 active:opacity-80 transition-opacity">
    <div class="bg-brand-500 p-2 rounded-xl text-white shadow-md shadow-brand-500/20">
      <i data-lucide="wrench" class="w-5 h-5"></i>
    </div>
    <div class="flex flex-col">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400 leading-none">RevSys</span>
      <span class="text-lg font-black text-sky-400 tracking-wider uppercase leading-tight mt-0.5">AUTEC</span>
    </div>
  </a>
  
  <div class="flex items-center space-x-2">
    <% if (usuarioLogado) { %>
      <div class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-xs font-bold text-slate-200 select-none">
        <%= usuarioLogado.nome.substring(0, 2).toUpperCase() %>
      </div>
    <% } %>
    <button id="btnMenuMobile" 
            class="w-11 h-11 flex items-center justify-center rounded-xl bg-slate-800 hover:bg-slate-750 text-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all active:scale-95"
            aria-label="Abrir menu de navegação">
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
  </div>
</header>

<!-- Menu Lateral / Navegação (Desktop & Mobile Drawer) -->
<aside id="sidebar" 
       class="fixed inset-y-0 left-0 transform -translate-x-full md:relative md:translate-x-0 transition-transform duration-300 ease-out z-50 w-[82vw] max-w-[300px] md:w-64 bg-slate-900 text-slate-300 flex flex-col justify-between shrink-0 h-full border-r border-slate-800 shadow-2xl md:shadow-none safe-top safe-bottom">
  
  <div class="flex flex-col h-full overflow-hidden">
    <!-- Topo da Sidebar: Logo & Botão Fechar no Mobile -->
    <div class="p-5 md:p-6 border-b border-slate-800 shrink-0">
      <div class="flex items-center justify-between mb-5">
        <div class="flex items-center space-x-3">
          <div class="bg-brand-500 p-2.5 rounded-xl text-white shadow-md shadow-brand-500/25">
            <i data-lucide="wrench" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-slate-400 block leading-tight">RevSys</span>
            <span class="text-2xl font-black text-sky-400 tracking-wider block uppercase">AUTEC</span>
          </div>
        </div>

        <!-- Botão X no topo da sidebar para fechar fácil no mobile -->
        <button id="btnFecharMenuTopo" 
                class="md:hidden w-10 h-10 flex items-center justify-center rounded-xl bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white transition-colors"
                aria-label="Fechar menu">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      
      <!-- Usuário Conectado -->
      <% if (usuarioLogado) { %>
        <div class="bg-slate-800/80 rounded-xl p-3.5 border border-slate-750 flex items-center space-x-3 shadow-inner">
          <div class="w-10 h-10 rounded-xl bg-brand-600/30 border border-brand-500/30 text-brand-300 flex items-center justify-center font-bold text-base select-none shrink-0">
            <%= usuarioLogado.nome.substring(0, 2).toUpperCase() %>
          </div>
          <div class="overflow-hidden">
            <span class="text-base font-bold text-white block truncate leading-tight"><%= usuarioLogado.nome %></span>
            <span class="text-xs text-slate-400 capitalize font-medium block mt-1">
              <%= usuarioLogado.papel === 'mecanico' ? 'Mecânico' : usuarioLogado.papel %>
            </span>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Links de Navegação com Rolagem Touch -->
    <nav class="flex-1 p-4 space-y-2 overflow-y-auto smooth-scroll">
      <% if (usuarioLogado && usuarioLogado.papel !== 'cliente') { %>
        <!-- Painel / Dashboard -->
        <a href="/painel" class="flex items-center space-x-3.5 p-3.5 rounded-xl hover:bg-slate-800 hover:text-white transition-all text-base font-semibold <%= urlAtiva === '/painel' ? 'bg-brand-600 text-white shadow-md shadow-brand-600/25' : 'text-slate-300' %>">
          <i data-lucide="layout-dashboard" class="w-5 h-5 shrink-0"></i>
          <span>Dashboard</span>
        </a>

        <!-- Clientes -->
        <a href="/clientes" class="flex items-center space-x-3.5 p-3.5 rounded-xl hover:bg-slate-800 hover:text-white transition-all text-base font-semibold <%= urlAtiva.startsWith('/clientes') ? 'bg-brand-600 text-white shadow-md shadow-brand-600/25' : 'text-slate-300' %>">
          <i data-lucide="users" class="w-5 h-5 shrink-0"></i>
          <span>Clientes</span>
        </a>

        <!-- Veículos -->
        <a href="/veiculos" class="flex items-center space-x-3.5 p-3.5 rounded-xl hover:bg-slate-800 hover:text-white transition-all text-base font-semibold <%= urlAtiva.startsWith('/veiculos') ? 'bg-brand-600 text-white shadow-md shadow-brand-600/25' : 'text-slate-300' %>">
          <i data-lucide="car" class="w-5 h-5 shrink-0"></i>
          <span>Veículos</span>
        </a>

        <!-- Agendamentos -->
        <a href="/agendamentos/calendario-tela" class="flex items-center space-x-3.5 p-3.5 rounded-xl hover:bg-slate-800 hover:text-white transition-all text-base font-semibold <%= urlAtiva.startsWith('/agendamentos') ? 'bg-brand-600 text-white shadow-md shadow-brand-600/25' : 'text-slate-300' %>">
          <i data-lucide="calendar" class="w-5 h-5 shrink-0"></i>
          <span>Agendamentos</span>
        </a>

        <!-- Cadastros Auxiliares -->
        <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
          <a href="/cadastros" class="flex items-center space-x-3.5 p-3.5 rounded-xl hover:bg-slate-800 hover:text-white transition-all text-base font-semibold <%= urlAtiva === '/cadastros' ? 'bg-brand-600 text-white shadow-md shadow-brand-600/25' : 'text-slate-300' %>">
            <i data-lucide="settings" class="w-5 h-5 shrink-0"></i>
            <span>Cadastros Base</span>
          </a>
        <% } %>

        <!-- Relatórios -->
        <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
          <a href="/relatorios" class="flex items-center space-x-3.5 p-3.5 rounded-xl hover:bg-slate-800 hover:text-white transition-all text-base font-semibold <%= urlAtiva.startsWith('/relatorios') ? 'bg-brand-600 text-white shadow-md shadow-brand-600/25' : 'text-slate-300' %>">
            <i data-lucide="file-text" class="w-5 h-5 shrink-0"></i>
            <span>Relatórios</span>
          </a>
        <% } %>
      <% } else if (usuarioLogado && usuarioLogado.papel === 'cliente') { %>
        <!-- Área do Cliente -->
        <a href="/cliente/veiculos" class="flex items-center space-x-3.5 p-3.5 rounded-xl hover:bg-slate-800 hover:text-white transition-all text-base font-semibold <%= urlAtiva.startsWith('/cliente') ? 'bg-brand-600 text-white shadow-md shadow-brand-600/25' : 'text-slate-300' %>">
          <i data-lucide="car" class="w-5 h-5 shrink-0"></i>
          <span>Meus Veículos</span>
        </a>
      <% } %>
    </nav>

    <!-- Rodapé do Menu (Sair) -->
    <div class="p-4 border-t border-slate-800 shrink-0 space-y-2">
      <a href="/sair" class="flex items-center space-x-3.5 p-3.5 rounded-xl hover:bg-red-950/80 hover:text-red-200 text-slate-300 text-base font-semibold transition-colors w-full active:scale-[0.98]">
        <i data-lucide="log-out" class="w-5 h-5 text-red-500 shrink-0"></i>
        <span>Sair do Sistema</span>
      </a>
      
      <!-- Botão Fechar Menu no Rodapé Mobile -->
      <button id="btnFecharMenu" class="md:hidden flex items-center justify-center space-x-2 py-3 px-4 rounded-xl border border-slate-800 hover:bg-slate-800 text-slate-400 text-sm font-medium w-full transition-colors">
        <i data-lucide="x" class="w-4 h-4"></i>
        <span>Fechar Menu</span>
      </button>
    </div>
  </div>
</aside>

<!-- Overlay no Mobile com backdrop blur para fechar sidebar clicando fora -->
<div id="sidebarOverlay" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-40 hidden md:hidden transition-opacity duration-300"></div>

<!-- Container Principal do Conteúdo -->
<main class="flex-1 flex flex-col overflow-hidden h-full">
  <!-- Conteúdo de cada página é renderizado abaixo -->
