              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">E-mail</label>
              <input type="email" name="email" placeholder="contato@oficina.com..."
                     class="w-full bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3.5 text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 transition-all">
            </div>
            
            <div class="sm:col-span-3 flex justify-end">
              <button type="submit" class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-7 rounded-xl text-base transition-all flex items-center justify-center gap-2 shadow-sm cursor-pointer">
                <i data-lucide="check" class="w-5 h-5"></i>
                <span>Salvar Oficina</span>
              </button>
            </div>
          </form>
        </div>

        <!-- SANFONA: Oficinas Cadastradas -->
        <div id="sanfona-box-oficina" class="hidden space-y-3 pt-1 transition-all duration-300">
          <!-- Campo de Busca por Palavra-Chave -->
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3"></i>
            <input type="text" 
                   oninput="filtrarListaItens('lista-oficinas', this.value, 'empty-oficinas')"
                   placeholder="Pesquisar oficina por nome, CNPJ, WhatsApp, e-mail ou endereço..."
                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-8 py-2 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
            <button type="button" onclick="limparBuscaInput(this, 'lista-oficinas', 'empty-oficinas')" class="hidden text-slate-400 hover:text-slate-600 absolute right-3 top-2.5" title="Limpar pesquisa">
              <i data-lucide="x-circle" class="w-4 h-4"></i>
            </button>
          </div>

          <div id="empty-oficinas" class="hidden p-4 text-center text-xs sm:text-sm text-slate-500 bg-slate-50 rounded-xl border border-dashed border-slate-200">
            Nenhuma oficina encontrada com essa palavra-chave.
          </div>

          <div id="lista-oficinas" class="border border-slate-200 rounded-xl divide-y divide-slate-100 overflow-x-auto">
            <table class="w-full text-left text-sm sm:text-base text-slate-800">
              <thead>
                <tr class="bg-slate-100/80 font-bold uppercase tracking-wider text-slate-700 text-xs sm:text-sm border-b border-slate-200">
                  <th class="p-3 pl-4 sm:pl-5">Nome</th>
                  <th class="p-3">CNPJ</th>
                  <th class="p-3">WhatsApp</th>
                  <th class="p-3">E-mail</th>
                  <th class="p-3 pr-4 sm:pr-5 text-right">Ações</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% if (oficinas.length === 0) { %>
                  <tr>
                    <td colspan="5" class="p-6 text-center text-slate-500 text-sm">Nenhuma oficina cadastrada.</td>
                  </tr>
                <% } else { %>
                  <% oficinas.forEach(o => { %>
                    <tr class="item-filtrável hover:bg-slate-50/70 transition-colors" data-texto-busca="<%= o.nome %> <%= o.cnpj %> <%= o.whatsapp_numero || '' %> <%= o.email || '' %> <%= o.endereco || '' %>">
                      <td class="p-3 pl-4 sm:pl-5 font-bold text-slate-900"><%= o.nome %></td>
                      <td class="p-3 font-mono text-xs sm:text-sm font-semibold text-slate-700"><%= formatarCNPJ(o.cnpj) %></td>
                      <td class="p-3 font-medium"><%= o.whatsapp_numero ? formatarTelefone(o.whatsapp_numero) : 'N/I' %></td>
                      <td class="p-3 text-slate-600"><%= o.email || 'N/I' %></td>
                      <td class="p-3 pr-4 sm:pr-5 text-right">
                        <% if (['admin', 'gerente'].includes(usuarioLogado.papel)) { %>
                          <form action="/oficinas/<%= o.id %>?_method=DELETE" method="POST" onsubmit="confirmarAcaoModal(event, 'Tem certeza que deseja excluir esta oficina? A exclusão só será permitida se não houver manutenções vinculadas a ela.', 'Excluir Oficina?'); return false;" class="inline">
                            <button type="submit" class="text-slate-400 hover:text-red-600 p-1.5 rounded-lg hover:bg-red-50 transition-colors" title="Excluir oficina">
                              <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 7. BLOCO: USUÁRIOS DO SISTEMA (EXCLUSIVO ADMINISTRADOR) -->
      <% if (usuarioLogado && usuarioLogado.papel === 'admin') { %>
        <section id="usuarios-sistema" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4 lg:col-span-2">
          <!-- Cabeçalho com Gatilhos -->
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center shrink-0 shadow-xs">
                <i data-lucide="user-plus" class="w-5 h-5"></i>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-lg sm:text-xl font-bold text-slate-900 leading-tight">Usuários do Sistema</h2>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                    Acesso Administrador
                  </span>
                </div>
                <p class="text-xs text-slate-500 mt-0.5"><%= typeof usuariosSistema !== 'undefined' ? usuariosSistema.length : 0 %> usuário(s) ativos no sistema.</p>
              </div>
            </div>

            <div class="flex items-center gap-2 self-start sm:self-auto">
              <!-- Gatilho Sanfona: Ver Itens -->
              <button type="button" 
                      id="btn-accordion-usuario"
                      onclick="toggleSanfonaItens('sanfona-box-usuario', this, 'Ver Itens (<%= typeof usuariosSistema !== 'undefined' ? usuariosSistema.length : 0 %>)', 'Ocultar Itens')"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 shadow-2xs hover:shadow-xs active:scale-95 transition-all cursor-pointer">
                <i data-lucide="chevron-down" class="w-4 h-4 text-slate-600 transition-transform duration-200"></i>
                <span class="btn-rotulo">Ver Itens (<%= typeof usuariosSistema !== 'undefined' ? usuariosSistema.length : 0 %>)</span>
              </button>

              <!-- Gatilho Formulário: Novo Usuário -->
              <button type="button" 
                      id="btn-toggle-usuario"
                      onclick="toggleFormularioCadastro('form-box-usuario', this, 'Novo Usuário')"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold bg-slate-900 hover:bg-slate-800 text-white shadow-2xs hover:shadow-xs active:scale-95 transition-all cursor-pointer">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Novo Usuário</span>
              </button>
            </div>
          </div>

          <!-- Formulário Oculto (Abertura Sob Demanda) -->
          <div id="form-box-usuario" class="hidden bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200 space-y-4 transition-all duration-200">
            <div class="flex items-center justify-between border-b border-slate-200 pb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                <i data-lucide="plus-circle" class="w-4 h-4 text-brand-600"></i>
                Cadastrar Novo Usuário e Definir Nível de Acesso
              </span>
              <button type="button" onclick="fecharFormularioCadastro('form-box-usuario', 'btn-toggle-usuario', 'Novo Usuário')" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-200 transition-colors" title="Fechar formulário">
                <i data-lucide="x" class="w-4 h-4"></i>
              </button>
            </div>

            <form action="/usuarios" method="POST" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Nome Completo -->
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nome Completo *</label>
                  <input type="text" name="nome" required placeholder="Ex: Carlos Eduardo da Silva"
                         class="w-full bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3.5 text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 transition-all font-medium">
                </div>

                <!-- E-mail de Acesso -->
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">E-mail de Acesso (Login) *</label>
                  <input type="email" name="email" required placeholder="usuario@autec.com.br"
                         class="w-full bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3.5 text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 transition-all">
                </div>

                <!-- Nível de Acesso (Tabela niveis_acesso) -->
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nível de Acesso *</label>
                  <select name="nivel_acesso_id" required
                          class="w-full bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3.5 text-base focus:outline-none focus:border-brand-500 transition-all font-semibold">
                    <option value="" disabled selected>Selecione o nível de acesso...</option>
                    <% if (typeof niveisAcesso !== 'undefined' && niveisAcesso.length > 0) { %>
                      <% niveisAcesso.forEach(nivel => { %>
                        <option value="<%= nivel.id %>">
                          <%= nivel.titulo %> (<%= nivel.nome.toUpperCase() %>)
                        </option>
                      <% }) %>
                    <% } else { %>
                      <option value="1">Administrador</option>
                      <option value="2">Gerente</option>
                      <option value="3">Atendente</option>
                      <option value="4">Mecânico</option>
                    <% } %>
                  </select>
                </div>

                <!-- Senha -->
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Senha Provisória *</label>
                  <input type="password" name="senha" required minlength="6" placeholder="Mínimo de 6 caracteres"
                         class="w-full bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3.5 text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 transition-all">
                </div>

                <!-- Confirmação de Senha -->
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Confirmar Senha *</label>
                  <input type="password" name="confirmar_senha" required minlength="6" placeholder="Repita a senha"
                         class="w-full bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3.5 text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 transition-all">
                </div>

                <!-- Botão Cadastrar -->
                <div class="sm:col-span-2 lg:col-span-1 flex items-end">
                  <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-5 rounded-xl text-base transition-all flex items-center justify-center gap-2 shadow-sm cursor-pointer active:scale-95">
                    <i data-lucide="check" class="w-5 h-5"></i>
                    <span>Salvar Usuário</span>
                  </button>
                </div>
              </div>
            </form>
          </div>

          <!-- SANFONA: Usuários Cadastrados -->
          <div id="sanfona-box-usuario" class="hidden space-y-3 pt-1 transition-all duration-300">
            <!-- Campo de Busca por Palavra-Chave -->
            <div class="relative">
              <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3"></i>
              <input type="text" 
                     oninput="filtrarListaItens('lista-usuarios', this.value, 'empty-usuarios')"
                     placeholder="Pesquisar usuário por nome, e-mail ou nível de acesso..."
                     class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-8 py-2 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
              <button type="button" onclick="limparBuscaInput(this, 'lista-usuarios', 'empty-usuarios')" class="hidden text-slate-400 hover:text-slate-600 absolute right-3 top-2.5" title="Limpar pesquisa">
                <i data-lucide="x-circle" class="w-4 h-4"></i>
              </button>
            </div>

            <div id="empty-usuarios" class="hidden p-4 text-center text-xs sm:text-sm text-slate-500 bg-slate-50 rounded-xl border border-dashed border-slate-200">
              Nenhum usuário encontrado com essa palavra-chave.
            </div>

            <div id="lista-usuarios" class="border border-slate-200 rounded-xl divide-y divide-slate-100 overflow-x-auto">
              <table class="w-full text-left text-sm sm:text-base text-slate-800">
                <thead>
                  <tr class="bg-slate-100/80 font-bold uppercase tracking-wider text-slate-700 text-xs sm:text-sm border-b border-slate-200">
                    <th class="p-3 pl-4 sm:pl-5">Nome do Usuário</th>
                    <th class="p-3">E-mail (Login)</th>
                    <th class="p-3">Nível de Acesso</th>
                    <th class="p-3">Data de Cadastro</th>
                    <th class="p-3 pr-4 sm:pr-5 text-right">Ações</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% if (typeof usuariosSistema !== 'undefined' && usuariosSistema.length > 0) { %>
                    <% usuariosSistema.forEach(u => { %>
                      <tr class="item-filtrável hover:bg-slate-50/70 transition-colors" data-texto-busca="<%= u.nome %> <%= u.email %> <%= u.papel %> <%= u.nivel_acesso ? u.nivel_acesso.titulo : '' %>">
                        <td class="p-3 pl-4 sm:pl-5">
                          <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-slate-200 text-slate-800 font-bold flex items-center justify-center text-xs shrink-0 select-none">
                              <%= u.nome ? u.nome.substring(0, 2).toUpperCase() : 'U' %>
                            </div>
                            <div>
                              <span class="font-bold text-slate-900 block leading-snug"><%= u.nome %></span>
                              <% if (u.id === usuarioLogado.id) { %>
                                <span class="text-[10px] text-emerald-600 font-bold uppercase tracking-wider">(Seu Usuário Atual)</span>
                              <% } %>
                            </div>
                          </div>
                        </td>
                        <td class="p-3 text-slate-600 text-xs sm:text-sm"><%= u.email %></td>
                        <td class="p-3">
                          <% if (u.papel === 'admin') { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800 border border-purple-200">
                              <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                              <%= u.nivel_acesso ? u.nivel_acesso.titulo : 'Administrador' %>
                            </span>
                          <% } else if (u.papel === 'gerente') { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200">
                              <i data-lucide="briefcase" class="w-3.5 h-3.5"></i>
                              <%= u.nivel_acesso ? u.nivel_acesso.titulo : 'Gerente' %>
                            </span>
                          <% } else if (u.papel === 'atendente') { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                              <i data-lucide="headset" class="w-3.5 h-3.5"></i>
                              <%= u.nivel_acesso ? u.nivel_acesso.titulo : 'Atendente' %>
                            </span>
                          <% } else if (u.papel === 'mecanico') { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">
                              <i data-lucide="wrench" class="w-3.5 h-3.5"></i>
                              <%= u.nivel_acesso ? u.nivel_acesso.titulo : 'Mecânico' %>
                            </span>
                          <% } else { %>
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-800 border border-slate-200">
                              <i data-lucide="user" class="w-3.5 h-3.5"></i>
                              <%= u.nivel_acesso ? u.nivel_acesso.titulo : 'Cliente' %>
                            </span>
                          <% } %>
                        </td>
                        <td class="p-3 text-xs text-slate-500 font-medium">
                          <%= u.criado_em ? new Date(u.criado_em).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/I' %>
                        </td>
                        <td class="p-3 pr-4 sm:pr-5 text-right">
                          <% if (u.id !== usuarioLogado.id && !(u.id === 1 && u.email === 'admin@revsys.com')) { %>
                            <form action="/usuarios/<%= u.id %>?_method=DELETE" method="POST" 
                                  onsubmit="confirmarAcaoModal(event, 'Tem certeza que deseja remover o usuário <%= u.nome %>? Essa ação é irreversível.', 'Excluir Usuário?'); return false;" 
                                  class="inline">
                              <button type="submit" class="text-slate-400 hover:text-red-600 p-1.5 rounded-lg hover:bg-red-50 transition-colors cursor-pointer" title="Excluir usuário">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                              </button>
                            </form>
                          <% } else { %>
                            <span class="text-xs text-slate-400 font-medium italic">Protegido</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="p-6 text-center text-slate-500 text-sm">
                        Nenhum usuário cadastrado.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      <% } %>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>

<!-- Scripts de Interatividade: Sanfonas, Formulários Sob Demanda e Filtro por Palavra-Chave -->
<script>
  /**
   * Alterna a visibilidade da Sanfona de Itens (Accordion)
   */
  function toggleSanfonaItens(sanfonaId, btnElement, textoPadrao, textoAberto) {
    const box = document.getElementById(sanfonaId);
    if (!box) return;

    const estaOculto = box.classList.contains('hidden');

    if (estaOculto) {
      box.classList.remove('hidden');
      if (btnElement) {
        btnElement.classList.remove('bg-white', 'text-slate-700');
        btnElement.classList.add('bg-slate-100', 'text-slate-900', 'border-slate-400');
        btnElement.innerHTML = `
          <i data-lucide="chevron-up" class="w-4 h-4 text-slate-800"></i>
          <span class="btn-rotulo">${textoAberto}</span>
        `;
      }
      // Foca automaticamente no campo de pesquisa da sanfona
      const inputBusca = box.querySelector('input[type="text"]');
      if (inputBusca) {
        setTimeout(() => inputBusca.focus(), 60);
      }
    } else {
      box.classList.add('hidden');
      if (btnElement) {
        btnElement.classList.remove('bg-slate-100', 'text-slate-900', 'border-slate-400');
        btnElement.classList.add('bg-white', 'text-slate-700');
        btnElement.innerHTML = `
          <i data-lucide="chevron-down" class="w-4 h-4 text-slate-600"></i>
          <span class="btn-rotulo">${textoPadrao}</span>
        `;
      }
    }

    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  /**
   * Abre uma sanfona específica e rola até a seção (usado nos atalhos do topo)
   */
  function abrirSanfonaSecao(sanfonaId, btnId, secaoId) {
    const box = document.getElementById(sanfonaId);
    const btn = document.getElementById(btnId);
    const secao = document.getElementById(secaoId);

    if (box && box.classList.contains('hidden') && btn) {
      btn.click();
    }

    if (secao) {
      secao.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  /**
   * Alterna a visibilidade do Formulário de Cadastro (Abertura Sob Demanda)
   */
  function toggleFormularioCadastro(boxId, btnElement, textoPadrao, textoAberto = 'Cancelar') {
    const box = document.getElementById(boxId);
    if (!box) return;

    const estaOculto = box.classList.contains('hidden');

    if (estaOculto) {
      box.classList.remove('hidden');
      if (btnElement) {
        btnElement.classList.remove('bg-slate-900', 'text-white', 'hover:bg-slate-800');
        btnElement.classList.add('bg-slate-200', 'text-slate-800', 'hover:bg-slate-300');
        btnElement.innerHTML = `
          <i data-lucide="x" class="w-4 h-4 text-slate-700"></i>
          <span>${textoAberto}</span>
        `;
      }
      // Foca automaticamente no primeiro campo do formulário
      const primeiroInput = box.querySelector('input:not([type="hidden"]), select, textarea');
      if (primeiroInput) {
        setTimeout(() => primeiroInput.focus(), 80);
      }
    } else {
      box.classList.add('hidden');
      if (btnElement) {
        btnElement.classList.remove('bg-slate-200', 'text-slate-800', 'hover:bg-slate-300');
        btnElement.classList.add('bg-slate-900', 'text-white', 'hover:bg-slate-800');
        btnElement.innerHTML = `
          <i data-lucide="plus" class="w-4 h-4 text-white"></i>
          <span>${textoPadrao}</span>
        `;
      }
    }

    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  /**
   * Fecha o formulário a partir do botão X interno
   */
  function fecharFormularioCadastro(boxId, btnId, textoPadrao) {
    const box = document.getElementById(boxId);
    const btn = document.getElementById(btnId);
    if (box) {
      box.classList.add('hidden');
    }
    if (btn) {
      btn.classList.remove('bg-slate-200', 'text-slate-800', 'hover:bg-slate-300');
      btn.classList.add('bg-slate-900', 'text-white', 'hover:bg-slate-800');
      btn.innerHTML = `
        <i data-lucide="plus" class="w-4 h-4 text-white"></i>
        <span>${textoPadrao}</span>
      `;
    }
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  /**
   * Filtra os itens de uma lista em tempo real com base no texto digitado
   */
  function filtrarListaItens(containerId, termo, emptyMsgId) {
    const container = document.getElementById(containerId);
    const emptyMsg = document.getElementById(emptyMsgId);
    if (!container) return;

    const termoLimpo = termo.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const itens = container.querySelectorAll('.item-filtrável');
    let visiveis = 0;

    itens.forEach(item => {
      const texto = (item.getAttribute('data-texto-busca') || item.textContent || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

      if (!termoLimpo || texto.includes(termoLimpo)) {
        item.classList.remove('hidden');
        visiveis++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (emptyMsg) {
      if (visiveis === 0 && termoLimpo !== '') {
        emptyMsg.classList.remove('hidden');
      } else {
        emptyMsg.classList.add('hidden');
      }
    }

    // Controlar visibilidade do botão limpar busca
    const inputEl = event?.target;
    if (inputEl && inputEl.parentElement) {
      const btnLimpar = inputEl.parentElement.querySelector('button');
      if (btnLimpar) {
        if (termo.length > 0) {
          btnLimpar.classList.remove('hidden');
        } else {
          btnLimpar.classList.add('hidden');
        }
      }
    }

    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  /**
   * Limpa o campo de busca e restaura todos os itens da lista
   */
  function limparBuscaInput(btnLimpar, containerId, emptyMsgId) {
    const input = btnLimpar?.parentElement?.querySelector('input');
    if (input) {
      input.value = '';
      filtrarListaItens(containerId, '', emptyMsgId);
      btnLimpar.classList.add('hidden');
      input.focus();
    }
  }

  // Deep-linking e hash na URL
  document.addEventListener('DOMContentLoaded', verificarHashAbertura);
  document.addEventListener('turbo:load', verificarHashAbertura);

  function verificarHashAbertura() {
    const hash = window.location.hash;
    if (hash === '#usuarios-sistema') {
      const btnSanfonaUsuario = document.getElementById('btn-accordion-usuario');
      if (btnSanfonaUsuario) {
        btnSanfonaUsuario.click();
        document.getElementById('usuarios-sistema')?.scrollIntoView({ behavior: 'smooth' });
      }
    }
  }
</script>
