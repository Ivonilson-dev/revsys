<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-7xl mx-auto space-y-6 sm:space-y-8">
    
    <!-- Cabeçalho Principal -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Cadastros Base</h1>
        <p class="text-slate-600 text-sm sm:text-base md:text-lg mt-1 font-normal">
          Gerencie os dados mestres e configurações de suporte do sistema AUTEC.
        </p>
      </div>

      <!-- Barra de Ações Rápidas -->
      <div class="flex items-center flex-wrap gap-2 text-xs font-semibold">
        <span class="text-slate-500 mr-1 hidden sm:inline-block">Ações Rápidas:</span>
        <button type="button" onclick="abrirSanfonaSecao('sanfona-box-marca-veiculo', 'btn-accordion-marca-veiculo', 'secao-marcas-veiculo')" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:text-slate-950 hover:bg-slate-100 shadow-2xs transition-colors cursor-pointer">
          Marcas (<%= marcasVeiculo.length %>)
        </button>
        <button type="button" onclick="abrirSanfonaSecao('sanfona-box-modelo-veiculo', 'btn-accordion-modelo-veiculo', 'secao-modelos-veiculo')" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:text-slate-950 hover:bg-slate-100 shadow-2xs transition-colors cursor-pointer">
          Modelos (<%= modelosVeiculo.length %>)
        </button>
        <button type="button" onclick="abrirSanfonaSecao('sanfona-box-peca', 'btn-accordion-peca', 'secao-pecas')" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:text-slate-950 hover:bg-slate-100 shadow-2xs transition-colors cursor-pointer">
          Peças (<%= pecas.length %>)
        </button>
        <button type="button" onclick="abrirSanfonaSecao('sanfona-box-servico', 'btn-accordion-servico', 'secao-servicos')" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:text-slate-950 hover:bg-slate-100 shadow-2xs transition-colors cursor-pointer">
          Serviços (<%= servicos.length %>)
        </button>
        <button type="button" onclick="abrirSanfonaSecao('sanfona-box-oficina', 'btn-accordion-oficina', 'secao-oficinas')" class="px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:text-slate-950 hover:bg-slate-100 shadow-2xs transition-colors cursor-pointer">
          Oficinas (<%= oficinas.length %>)
        </button>
        <% if (usuarioLogado && usuarioLogado.papel === 'admin') { %>
          <button type="button" onclick="abrirSanfonaSecao('sanfona-box-usuario', 'btn-accordion-usuario', 'usuarios-sistema')" class="px-2.5 py-1.5 rounded-lg bg-indigo-50 border border-indigo-200 text-indigo-700 hover:bg-indigo-100 shadow-2xs transition-colors cursor-pointer font-bold">
            Usuários (<%= typeof usuariosSistema !== 'undefined' ? usuariosSistema.length : 0 %>)
          </button>
        <% } %>
      </div>
    </div>

    <!-- Alertas Globais -->
    <% if (erro) { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-800 text-base font-medium flex items-start space-x-2 shadow-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-red-600"></i>
        <span><%= erro %></span>
      </div>
    <% } %>

    <% if (sucesso) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-base font-medium flex items-start space-x-2 shadow-sm">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucesso %></span>
      </div>
    <% } %>

    <!-- Grid de Seções de Tabelas Auxiliares -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
      
      <!-- 1. BLOCO: MARCAS DE VEÍCULO -->
      <section id="secao-marcas-veiculo" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4">
        <!-- Cabeçalho com Gatilhos (Ver Itens & Nova Marca) -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 flex items-center justify-center shrink-0">
              <i data-lucide="car" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-slate-900 leading-tight">Marcas de Veículos</h2>
              <p class="text-xs text-slate-500"><%= marcasVeiculo.length %> fabricante(s) cadastrada(s)</p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-auto">
            <!-- Gatilho da Sanfona: Ver Itens -->
            <button type="button" 
                    id="btn-accordion-marca-veiculo"
                    onclick="toggleSanfonaItens('sanfona-box-marca-veiculo', this, 'Ver Itens (<%= marcasVeiculo.length %>)', 'Ocultar Itens')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 shadow-2xs hover:shadow-xs active:scale-95 transition-all cursor-pointer">
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-600 transition-transform duration-200"></i>
              <span class="btn-rotulo">Ver Itens (<%= marcasVeiculo.length %>)</span>
            </button>

            <!-- Gatilho do Formulário: Nova Marca -->
            <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
              <button type="button" 
                      id="btn-toggle-marca-veiculo"
                      onclick="toggleFormularioCadastro('form-box-marca-veiculo', this, 'Nova Marca')"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold bg-slate-900 hover:bg-slate-800 text-white shadow-2xs hover:shadow-xs active:scale-95 transition-all cursor-pointer">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Nova Marca</span>
              </button>
            <% } %>
          </div>
        </div>

        <!-- Formulário Oculto (Abertura Sob Demanda) -->
        <div id="form-box-marca-veiculo" class="hidden bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 transition-all duration-200">
          <div class="flex items-center justify-between border-b border-slate-200 pb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
              <i data-lucide="plus-circle" class="w-4 h-4 text-brand-600"></i>
              Cadastrar Nova Marca
            </span>
            <button type="button" onclick="fecharFormularioCadastro('form-box-marca-veiculo', 'btn-toggle-marca-veiculo', 'Nova Marca')" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-200 transition-colors" title="Fechar formulário">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>

          <form action="/marcas-veiculo" method="POST" class="flex flex-col xs:flex-row gap-2.5">
            <input type="text" name="nome" required placeholder="Ex: Toyota, Honda, Ford..."
                   class="flex-1 bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3.5 text-sm md:text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 transition-all font-medium">
            <button type="submit" class="w-full xs:w-auto bg-slate-900 hover:bg-slate-800 text-white font-bold py-2 px-5 rounded-xl text-sm md:text-base transition-all flex items-center justify-center gap-1.5 shrink-0 shadow-sm cursor-pointer">
              <i data-lucide="check" class="w-4 h-4"></i>
              <span>Salvar Marca</span>
            </button>
          </form>
        </div>

        <!-- SANFONA: Itens Cadastrados (Inicia Recolhido) -->
        <div id="sanfona-box-marca-veiculo" class="hidden space-y-3 pt-1 transition-all duration-300">
          <!-- Campo de Busca por Palavra-Chave -->
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3"></i>
            <input type="text" 
                   oninput="filtrarListaItens('lista-marcas-veiculo', this.value, 'empty-marcas-veiculo')"
                   placeholder="Pesquisar marca por palavra-chave..."
                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-8 py-2 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
            <button type="button" onclick="limparBuscaInput(this, 'lista-marcas-veiculo', 'empty-marcas-veiculo')" class="hidden text-slate-400 hover:text-slate-600 absolute right-3 top-2.5" title="Limpar pesquisa">
              <i data-lucide="x-circle" class="w-4 h-4"></i>
            </button>
          </div>

          <!-- Mensagem se busca vazia -->
          <div id="empty-marcas-veiculo" class="hidden p-4 text-center text-xs sm:text-sm text-slate-500 bg-slate-50 rounded-xl border border-dashed border-slate-200">
            Nenhuma marca encontrada com essa palavra-chave.
          </div>

          <!-- Lista de Itens -->
          <div id="lista-marcas-veiculo" class="border border-slate-200 rounded-xl max-h-[220px] overflow-y-auto divide-y divide-slate-100 pr-1">
            <% if (marcasVeiculo.length === 0) { %>
              <div class="p-6 text-center text-slate-500 text-sm">Nenhuma marca cadastrada ainda.</div>
            <% } else { %>
              <% marcasVeiculo.forEach(m => { %>
                <div class="item-filtrável p-2.5 sm:p-3 text-sm md:text-base text-slate-800 font-semibold flex justify-between items-center hover:bg-slate-50/70 transition-colors" data-texto-busca="<%= m.nome %>">
                  <span><%= m.nome %></span>
                  <% if (['admin', 'gerente'].includes(usuarioLogado.papel)) { %>
                    <form action="/marcas-veiculo/<%= m.id %>?_method=DELETE" method="POST" onsubmit="confirmarAcaoModal(event, 'Tem certeza que deseja excluir esta marca de veículo? A exclusão só será permitida se não houver modelos associados.', 'Excluir Marca?'); return false;" class="inline">
                      <button type="submit" class="text-slate-400 hover:text-red-600 p-1.5 rounded-lg hover:bg-red-50 transition-colors" title="Excluir marca">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </section>

      <!-- 2. BLOCO: MODELOS DE VEÍCULO -->
      <section id="secao-modelos-veiculo" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4">
        <!-- Cabeçalho com Gatilhos -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 flex items-center justify-center shrink-0">
              <i data-lucide="car-front" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-slate-900 leading-tight">Modelos de Veículos</h2>
              <p class="text-xs text-slate-500"><%= modelosVeiculo.length %> modelo(s) cadastrado(s)</p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-auto">
            <!-- Gatilho Sanfona -->
            <button type="button" 
                    id="btn-accordion-modelo-veiculo"
                    onclick="toggleSanfonaItens('sanfona-box-modelo-veiculo', this, 'Ver Itens (<%= modelosVeiculo.length %>)', 'Ocultar Itens')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 shadow-2xs hover:shadow-xs active:scale-95 transition-all cursor-pointer">
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-600 transition-transform duration-200"></i>
              <span class="btn-rotulo">Ver Itens (<%= modelosVeiculo.length %>)</span>
            </button>

            <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
              <button type="button" 
                      id="btn-toggle-modelo-veiculo"
                      onclick="toggleFormularioCadastro('form-box-modelo-veiculo', this, 'Novo Modelo')"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold bg-slate-900 hover:bg-slate-800 text-white shadow-2xs hover:shadow-xs active:scale-95 transition-all cursor-pointer">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Novo Modelo</span>
              </button>
            <% } %>
          </div>
        </div>

        <!-- Formulário Oculto (Abertura Sob Demanda) -->
        <div id="form-box-modelo-veiculo" class="hidden bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 transition-all duration-200">
          <div class="flex items-center justify-between border-b border-slate-200 pb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
              <i data-lucide="plus-circle" class="w-4 h-4 text-brand-600"></i>
              Cadastrar Novo Modelo
            </span>
            <button type="button" onclick="fecharFormularioCadastro('form-box-modelo-veiculo', 'btn-toggle-modelo-veiculo', 'Novo Modelo')" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-200 transition-colors" title="Fechar formulário">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>

          <form action="/modelos-veiculo" method="POST" class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <select name="marca_veiculo_id" required
                    class="bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3 text-sm focus:outline-none focus:border-brand-500 transition-all font-medium">
              <option value="" disabled selected>Marca...</option>
              <% marcasVeiculo.forEach(m => { %>
                <option value="<%= m.id %>"><%= m.nome %></option>
              <% }) %>
            </select>
            <input type="text" name="nome" required placeholder="Ex: Corolla, Civic..."
                   class="bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3.5 text-sm md:text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 transition-all font-medium">
            <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2 px-4 rounded-xl text-sm md:text-base transition-all flex items-center justify-center gap-1.5 shadow-sm cursor-pointer">
              <i data-lucide="check" class="w-4 h-4"></i>
              <span>Salvar Modelo</span>
            </button>
          </form>
        </div>

        <!-- SANFONA: Itens Cadastrados -->
        <div id="sanfona-box-modelo-veiculo" class="hidden space-y-3 pt-1 transition-all duration-300">
          <!-- Campo de Busca por Palavra-Chave -->
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3"></i>
            <input type="text" 
                   oninput="filtrarListaItens('lista-modelos-veiculo', this.value, 'empty-modelos-veiculo')"
                   placeholder="Pesquisar modelo ou marca..."
                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-8 py-2 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
            <button type="button" onclick="limparBuscaInput(this, 'lista-modelos-veiculo', 'empty-modelos-veiculo')" class="hidden text-slate-400 hover:text-slate-600 absolute right-3 top-2.5" title="Limpar pesquisa">
              <i data-lucide="x-circle" class="w-4 h-4"></i>
            </button>
          </div>

          <div id="empty-modelos-veiculo" class="hidden p-4 text-center text-xs sm:text-sm text-slate-500 bg-slate-50 rounded-xl border border-dashed border-slate-200">
            Nenhum modelo encontrado com essa palavra-chave.
          </div>

          <div id="lista-modelos-veiculo" class="border border-slate-200 rounded-xl max-h-[220px] overflow-y-auto divide-y divide-slate-100 pr-1">
            <% if (modelosVeiculo.length === 0) { %>
              <div class="p-6 text-center text-slate-500 text-sm">Nenhum modelo cadastrado ainda.</div>
            <% } else { %>
              <% modelosVeiculo.forEach(mod => { %>
                <div class="item-filtrável p-2.5 sm:p-3 text-sm md:text-base text-slate-800 font-semibold flex justify-between items-center hover:bg-slate-50/70 transition-colors" data-texto-busca="<%= mod.nome %> <%= mod.marca ? mod.marca.nome : '' %>">
                  <div class="flex items-center gap-2">
                    <span><%= mod.nome %></span>
                    <span class="text-xs text-slate-500 uppercase tracking-wider font-bold bg-slate-100 px-2 py-0.5 rounded border border-slate-200"><%= mod.marca ? mod.marca.nome : '' %></span>
                  </div>
                  <% if (['admin', 'gerente'].includes(usuarioLogado.papel)) { %>
                    <form action="/modelos-veiculo/<%= mod.id %>?_method=DELETE" method="POST" onsubmit="confirmarAcaoModal(event, 'Tem certeza que deseja excluir este modelo de veículo? A exclusão só será permitida se não houver veículos cadastrados.', 'Excluir Modelo?'); return false;" class="inline">
                      <button type="submit" class="text-slate-400 hover:text-red-600 p-1.5 rounded-lg hover:bg-red-50 transition-colors" title="Excluir modelo">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </section>

      <!-- 3. BLOCO: FABRICANTES DE PEÇA -->
      <section id="secao-marcas-peca" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4">
        <!-- Cabeçalho com Gatilhos -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 flex items-center justify-center shrink-0">
              <i data-lucide="package" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-slate-900 leading-tight">Fabricantes de Peças</h2>
              <p class="text-xs text-slate-500"><%= marcasPeca.length %> fabricante(s) cadastrada(s)</p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-auto">
            <button type="button" 
                    id="btn-accordion-marca-peca"
                    onclick="toggleSanfonaItens('sanfona-box-marca-peca', this, 'Ver Itens (<%= marcasPeca.length %>)', 'Ocultar Itens')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 shadow-2xs hover:shadow-xs active:scale-95 transition-all cursor-pointer">
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-600 transition-transform duration-200"></i>
              <span class="btn-rotulo">Ver Itens (<%= marcasPeca.length %>)</span>
            </button>

            <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
              <button type="button" 
                      id="btn-toggle-marca-peca"
                      onclick="toggleFormularioCadastro('form-box-marca-peca', this, 'Nova Fabricante')"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold bg-slate-900 hover:bg-slate-800 text-white shadow-2xs hover:shadow-xs active:scale-95 transition-all cursor-pointer">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Nova Fabricante</span>
              </button>
            <% } %>
          </div>
        </div>

        <!-- Formulário Oculto (Abertura Sob Demanda) -->
        <div id="form-box-marca-peca" class="hidden bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 transition-all duration-200">
          <div class="flex items-center justify-between border-b border-slate-200 pb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
              <i data-lucide="plus-circle" class="w-4 h-4 text-brand-600"></i>
              Cadastrar Fabricante de Peças
            </span>
            <button type="button" onclick="fecharFormularioCadastro('form-box-marca-peca', 'btn-toggle-marca-peca', 'Nova Fabricante')" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-200 transition-colors" title="Fechar formulário">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>

          <form action="/marcas-peca" method="POST" class="flex flex-col xs:flex-row gap-2.5">
            <input type="text" name="nome" required placeholder="Ex: Bosch, Fram, Metal Leve..."
                   class="flex-1 bg-white border border-slate-300 text-slate-900 rounded-xl py-2 px-3.5 text-sm md:text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 transition-all font-medium">
            <button type="submit" class="w-full xs:w-auto bg-slate-900 hover:bg-slate-800 text-white font-bold py-2 px-5 rounded-xl text-sm md:text-base transition-all flex items-center justify-center gap-1.5 shrink-0 shadow-sm cursor-pointer">
              <i data-lucide="check" class="w-4 h-4"></i>
              <span>Salvar Fabricante</span>
            </button>
          </form>
        </div>

        <!-- SANFONA: Itens Cadastrados -->
        <div id="sanfona-box-marca-peca" class="hidden space-y-3 pt-1 transition-all duration-300">
          <!-- Campo de Busca por Palavra-Chave -->
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3"></i>
            <input type="text" 
                   oninput="filtrarListaItens('lista-marcas-peca', this.value, 'empty-marcas-peca')"
                   placeholder="Pesquisar fabricante por palavra-chave..."
                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-8 py-2 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
            <button type="button" onclick="limparBuscaInput(this, 'lista-marcas-peca', 'empty-marcas-peca')" class="hidden text-slate-400 hover:text-slate-600 absolute right-3 top-2.5" title="Limpar pesquisa">
