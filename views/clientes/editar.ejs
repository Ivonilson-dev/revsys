<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<script src="https://unpkg.com/imask"></script>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-3xl mx-auto space-y-6">
    
    <!-- Link Voltar -->
    <a href="/clientes/<%= cliente.id %>" class="inline-flex items-center space-x-1 text-slate-500 hover:text-slate-900 transition-colors text-sm font-semibold">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      <span>Voltar para Detalhes</span>
    </a>

    <!-- Alerta de Erro -->
    <% if (erro) { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-800 text-sm flex items-start space-x-2 shadow-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-red-600"></i>
        <span><%= erro %></span>
      </div>
    <% } %>

    <!-- Título -->
    <div>
      <h1 class="text-3xl font-bold text-slate-900 tracking-tight font-sans">Editar Cliente: <%= cliente.usuario.nome %></h1>
      <p class="text-slate-500 mt-1">Atualize as informações cadastrais do cliente.</p>
    </div>

    <!-- Card de Formulário -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <form action="/clientes/<%= cliente.id %>?_method=PUT" method="POST" class="space-y-8">
        
        <!-- Seção 1: Dados Pessoais -->
        <div class="space-y-4">
          <h2 class="text-sm font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-2">Dados Pessoais</h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="col-span-1 sm:col-span-2">
              <label for="nome" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Nome Completo *</label>
              <input type="text" id="nome" name="nome" required value="<%= cliente.usuario.nome %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div>
              <label for="cpfInput" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">CPF (Inalterável)</label>
              <input type="text" id="cpfInput" name="cpfInput" disabled value="<%= cliente.cpf %>"
                     class="w-full bg-slate-100 border border-slate-200 text-slate-400 rounded-xl py-2.5 px-3.5 text-sm cursor-not-allowed">
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">E-mail *</label>
              <input type="email" id="email" name="email" required value="<%= cliente.usuario.email %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div>
              <label for="telefone" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Telefone Principal</label>
              <input type="text" id="telefone" name="telefone" value="<%= cliente.usuario.telefone || '' %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div>
              <label for="telefone_whatsapp" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">WhatsApp para Contatos</label>
              <input type="text" id="telefone_whatsapp" name="telefone_whatsapp" value="<%= cliente.telefone_whatsapp || '' %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>
          </div>
        </div>

        <!-- Seção 2: Endereço -->
        <div class="space-y-4">
          <h2 class="text-sm font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-2">Endereço Residencial</h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="cep" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">CEP</label>
              <input type="text" id="cep" name="cep" value="<%= cliente.cep || '' %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div class="sm:col-span-2">
              <label for="logradouro" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Logradouro / Rua</label>
              <input type="text" id="logradouro" name="logradouro" value="<%= cliente.logradouro || '' %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div>
              <label for="numero" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Número</label>
              <input type="text" id="numero" name="numero" value="<%= cliente.numero || '' %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div>
              <label for="bairro" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Bairro</label>
              <input type="text" id="bairro" name="bairro" value="<%= cliente.bairro || '' %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div>
              <label for="cidade" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Cidade</label>
              <input type="text" id="cidade" name="cidade" value="<%= cliente.cidade || '' %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div>
              <label for="estado" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Estado (UF)</label>
              <input type="text" id="estado" name="estado" maxlength="2" value="<%= cliente.estado || '' %>"
                     class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all uppercase">
            </div>
          </div>
        </div>

        <!-- Botões de Ação -->
        <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
          <a href="/clientes/<%= cliente.id %>" class="px-5 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold transition-all">
            Cancelar
          </a>
          <button type="submit" 
                  class="bg-brand-500 hover:bg-brand-600 text-white font-semibold py-2.5 px-6 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-sm flex items-center space-x-2">
            <span>Salvar Alterações</span>
            <i data-lucide="check" class="w-4 h-4"></i>
          </button>
        </div>

      </form>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Máscara CEP
    const cepInput = document.getElementById('cep');
    if (cepInput) IMask(cepInput, { mask: '00000-000' });

    // Máscara Telefone
    const telInput = document.getElementById('telefone');
    if (telInput) IMask(telInput, { mask: '(00) 00000-0000' });

    // Máscara WhatsApp
    const whatsappInput = document.getElementById('telefone_whatsapp');
    if (whatsappInput) IMask(whatsappInput, { mask: '(00) 00000-0000' });
  });
</script>

<%- include('../parciais/rodape') %>
