<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Alertas Globais -->
    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-sm flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Cabeçalho -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Clientes Cadastrados</h1>
        <p class="text-slate-500 mt-1">Gerenciamento de clientes e contatos da oficina.</p>
      </div>
      <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
        <a href="/clientes/novo" class="inline-flex items-center justify-center space-x-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-sm shrink-0">
          <i data-lucide="plus" class="w-5 h-5"></i>
          <span>Cadastrar Cliente</span>
        </a>
      <% } %>
    </div>

    <!-- Lista de Clientes -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      
      <!-- Visualização Desktop (Tabela) -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/70 border-b border-slate-200 text-slate-400 text-xs font-bold uppercase tracking-wider">
              <th class="p-4 pl-6">Nome</th>
              <th class="p-4">CPF</th>
              <th class="p-4">E-mail</th>
              <th class="p-4">WhatsApp / Tel</th>
              <th class="p-4">Consentimento LGPD</th>
              <th class="p-4 pr-6 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700 text-sm">
            <% if (clientes.length === 0) { %>
              <tr>
                <td colspan="6" class="p-8 text-center text-slate-400">
                  <i data-lucide="users" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                  Nenhum cliente cadastrado ainda.
                </td>
              </tr>
            <% } else { %>
              <% clientes.forEach(cliente => { %>
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="p-4 pl-6 font-semibold text-slate-900"><%= cliente.usuario.nome %></td>
                  <td class="p-4 font-mono"><%= cliente.cpf %></td>
                  <td class="p-4 text-slate-500"><%= cliente.usuario.email %></td>
                  <td class="p-4"><%= cliente.telefone_whatsapp || 'Não cadastrado' %></td>
                  <td class="p-4">
                    <% if (cliente.consentimento_lgpd) { %>
                      <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                        <span>Ativo</span>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                        <span>Revogado</span>
                      </span>
                    <% } %>
                  </td>
                  <td class="p-4 pr-6 text-right space-x-2">
                    <a href="/clientes/<%= cliente.id %>" class="inline-flex items-center justify-center p-2 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-950 transition-colors" title="Visualizar Detalhes">
                      <i data-lucide="eye" class="w-4.5 h-4.5"></i>
                    </a>
                    <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                      <a href="/clientes/<%= cliente.id %>/editar" class="inline-flex items-center justify-center p-2 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-950 transition-colors" title="Editar">
                        <i data-lucide="edit-2" class="w-4.5 h-4.5"></i>
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Visualização Mobile (Cards) -->
      <div class="block md:hidden divide-y divide-slate-100">
        <% if (clientes.length === 0) { %>
          <div class="p-8 text-center text-slate-400">
            <i data-lucide="users" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
            Nenhum cliente cadastrado ainda.
          </div>
        <% } else { %>
          <% clientes.forEach(cliente => { %>
            <div class="p-4 space-y-3 hover:bg-slate-50/50 transition-colors">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-900"><%= cliente.usuario.nome %></span>
                <% if (cliente.consentimento_lgpd) { %>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-green-100 text-green-800">LGPD OK</span>
                <% } else { %>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-red-100 text-red-800">REVOGADO</span>
                <% } %>
              </div>
              
              <div class="grid grid-cols-2 gap-2 text-xs text-slate-500">
                <div>
                  <span class="block text-slate-400 font-bold uppercase tracking-wider text-[9px]">CPF</span>
                  <span class="font-mono text-slate-800"><%= cliente.cpf %></span>
                </div>
                <div>
                  <span class="block text-slate-400 font-bold uppercase tracking-wider text-[9px]">WhatsApp</span>
                  <span class="text-slate-800"><%= cliente.telefone_whatsapp || 'Não informado' %></span>
                </div>
                <div class="col-span-2">
                  <span class="block text-slate-400 font-bold uppercase tracking-wider text-[9px]">E-mail</span>
                  <span class="text-slate-800 truncate block"><%= cliente.usuario.email %></span>
                </div>
              </div>

              <!-- Ações no Mobile (Navegação fácil) -->
              <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
                <a href="/clientes/<%= cliente.id %>" class="flex-1 text-center py-2 px-3 rounded-lg border border-slate-200 text-slate-700 font-semibold text-xs hover:bg-slate-50">
                  Ver Ficha Completa
                </a>
                <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                  <a href="/clientes/<%= cliente.id %>/editar" class="p-2 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" title="Editar">
                    <i data-lucide="edit-2" class="w-4 h-4 mx-auto"></i>
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
