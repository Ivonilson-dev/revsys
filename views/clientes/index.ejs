<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Alertas Globais -->
    <% if (erroMsg) { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-800 text-base font-medium flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-red-600"></i>
        <span><%= erroMsg %></span>
      </div>
    <% } %>

    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-base font-medium flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Cabeçalho -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Clientes Cadastrados</h1>
        <p class="text-slate-600 text-sm sm:text-base md:text-lg mt-1 font-normal">Gerenciamento de clientes e contatos da oficina.</p>
      </div>
      <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
        <a href="/clientes/novo" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-brand-500 hover:bg-brand-600 text-white font-bold py-3 px-5 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-base shrink-0 text-center">
          <i data-lucide="plus" class="w-5 h-5"></i>
          <span>Cadastrar Cliente</span>
        </a>
      <% } %>
    </div>

    <!-- Lista de Clientes -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      
      <!-- Visualização Desktop (Tabela) -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-100/80 border-b border-slate-200 text-slate-700 text-sm font-bold uppercase tracking-wider">
              <th class="p-4 pl-6">Nome</th>
              <th class="p-4">CPF</th>
              <th class="p-4">E-mail</th>
              <th class="p-4">WhatsApp / Tel</th>
              <th class="p-4">Situação</th>
              <th class="p-4">Consentimento LGPD</th>
              <th class="p-4 pr-6 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-800 text-base">
            <% if (clientes.length === 0) { %>
              <tr>
                <td colspan="7" class="p-10 text-center text-slate-500 text-base font-medium">
                  <i data-lucide="users" class="w-10 h-10 mx-auto mb-3 text-slate-300"></i>
                  Nenhum cliente cadastrado ainda.
                </td>
              </tr>
            <% } else { %>
              <% clientes.forEach(cliente => { 
                   let foneWhats = cliente.telefone_whatsapp ? String(cliente.telefone_whatsapp).replace(/\D/g, '') : '';
                   if (foneWhats.length === 10 || foneWhats.length === 11) foneWhats = '55' + foneWhats;
              %>
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="p-4 pl-6 font-bold text-slate-900"><%= cliente.usuario.nome %></td>
                  <td class="p-4 font-mono font-medium text-slate-800"><%= formatarCPF(cliente.cpf) %></td>
                  <td class="p-4 text-slate-600"><%= cliente.usuario.email %></td>
                  <td class="p-4">
                    <% if (cliente.telefone_whatsapp) { %>
                      <div class="flex items-center space-x-2.5">
                        <span class="font-medium text-slate-800"><%= formatarTelefone(cliente.telefone_whatsapp) %></span>
                        <a href="https://wa.me/<%= foneWhats %>?text=<%= encodeURIComponent('Olá ' + cliente.usuario.nome + '! Aqui é da oficina AUTEC.') %>" 
                           target="_blank" 
                           rel="noopener noreferrer"
                           class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#25D366] hover:bg-[#128C7E] text-white shadow-sm transition-all hover:scale-110 active:scale-95 shrink-0" 
                           title="Conversar no WhatsApp Web/Desktop">
                          <svg class="w-4 h-4 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/>
                          </svg>
                        </a>
                      </div>
                    <% } else { %>
                      <span class="text-slate-400 italic">Não cadastrado</span>
                    <% } %>
                  </td>
                  <td class="p-4">
                    <% if (cliente.ativo) { %>
                      <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span>Ativo</span>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300" title="<%= cliente.motivo_inativacao || 'Cadastro Inativo' %>">
                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                        <span>Inativo</span>
                      </span>
                    <% } %>
                  </td>
                  <td class="p-4">
                    <% if (cliente.consentimento_lgpd) { %>
                      <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800 border border-green-300">
                        <span class="w-2 h-2 rounded-full bg-green-500"></span>
                        <span>Ativo</span>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-300">
                        <span class="w-2 h-2 rounded-full bg-red-500"></span>
                        <span>Revogado</span>
                      </span>
                    <% } %>
                  </td>
                  <td class="p-4 pr-6 text-right space-x-1.5">
                    <a href="/clientes/<%= cliente.id %>" class="inline-flex items-center justify-center p-2.5 rounded-xl hover:bg-slate-200 text-slate-600 hover:text-slate-950 transition-colors" title="Visualizar Detalhes">
                      <i data-lucide="eye" class="w-5 h-5"></i>
                    </a>
                    <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                      <a href="/clientes/<%= cliente.id %>/editar" class="inline-flex items-center justify-center p-2.5 rounded-xl hover:bg-slate-200 text-slate-600 hover:text-slate-950 transition-colors" title="Editar">
                        <i data-lucide="edit-2" class="w-5 h-5"></i>
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Visualização Mobile (Cards) -->
      <div class="block md:hidden divide-y divide-slate-100">
        <% if (clientes.length === 0) { %>
          <div class="p-8 text-center text-slate-500 text-base font-medium">
            <i data-lucide="users" class="w-10 h-10 mx-auto mb-3 text-slate-300"></i>
            Nenhum cliente cadastrado ainda.
          </div>
        <% } else { %>
          <% clientes.forEach(cliente => { 
               let foneWhats = cliente.telefone_whatsapp ? String(cliente.telefone_whatsapp).replace(/\D/g, '') : '';
               if (foneWhats.length === 10 || foneWhats.length === 11) foneWhats = '55' + foneWhats;
          %>
            <div class="p-4 sm:p-5 space-y-3.5 hover:bg-slate-50/70 transition-colors">
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold text-slate-900 text-base sm:text-lg truncate"><%= cliente.usuario.nome %></span>
                <div class="flex items-center gap-1.5">
                  <% if (cliente.ativo) { %>
                    <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300 shrink-0">ATIVO</span>
                  <% } else { %>
                    <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-300 shrink-0" title="<%= cliente.motivo_inativacao || '' %>">INATIVO</span>
                  <% } %>
                  <% if (cliente.consentimento_lgpd) { %>
                    <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-300 shrink-0">LGPD</span>
                  <% } else { %>
                    <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-red-100 text-red-800 border border-red-300 shrink-0">REVOGADO</span>
                  <% } %>
                </div>
              </div>
              
              <div class="grid grid-cols-2 gap-3 text-sm text-slate-600">
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">CPF</span>
                  <span class="font-mono font-bold text-slate-800 text-sm sm:text-base"><%= formatarCPF(cliente.cpf) %></span>
                </div>
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">WhatsApp</span>
                  <div class="flex items-center gap-1.5 mt-0.5">
                    <span class="text-slate-800 font-semibold text-sm sm:text-base truncate"><%= cliente.telefone_whatsapp ? formatarTelefone(cliente.telefone_whatsapp) : 'Não informado' %></span>
                    <% if (foneWhats) { %>
                      <a href="https://wa.me/<%= foneWhats %>?text=<%= encodeURIComponent('Olá ' + cliente.usuario.nome + '! Aqui é da oficina AUTEC.') %>" 
                         target="_blank" 
                         rel="noopener noreferrer"
                         class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-[#25D366] text-white shadow-sm shrink-0 active:scale-95" 
                         title="Abrir WhatsApp">
                        <svg class="w-4 h-4 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24">
                          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/>
                        </svg>
                      </a>
                    <% } %>
                  </div>
                </div>
                <div class="col-span-2">
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">E-mail</span>
                  <span class="text-slate-800 font-medium truncate block text-sm sm:text-base"><%= cliente.usuario.email %></span>
                </div>
              </div>

              <!-- Ações no Mobile (Navegação com áreas de toque confortáveis) -->
              <div class="flex items-center gap-2 pt-3 border-t border-slate-100">
                <a href="/clientes/<%= cliente.id %>" class="flex-1 text-center py-2.5 px-3 rounded-xl border border-slate-300 bg-white text-slate-800 font-bold text-sm hover:bg-slate-50 active:bg-slate-100 transition-colors shadow-sm">
                  Ver Ficha Completa
                </a>
                <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                  <a href="/clientes/<%= cliente.id %>/editar" class="w-11 h-11 flex items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 active:bg-slate-100 transition-colors shadow-sm shrink-0" title="Editar">
                    <i data-lucide="edit-2" class="w-5 h-5"></i>
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
