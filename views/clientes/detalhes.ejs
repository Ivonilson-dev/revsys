<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Link Voltar & Notificações de Sucesso -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <a href="/clientes" class="inline-flex items-center space-x-1 text-slate-500 hover:text-slate-900 transition-colors text-sm font-semibold">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Voltar para Clientes</span>
      </a>
      <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
        <div class="flex items-center space-x-2">
          <a href="/clientes/<%= cliente.id %>/editar" class="inline-flex items-center space-x-1.5 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-semibold py-2 px-4 rounded-xl text-sm transition-all shadow-sm">
            <i data-lucide="edit-2" class="w-4 h-4"></i>
            <span>Editar Cadastro</span>
          </a>
          
          <% if (['admin', 'gerente'].includes(usuarioLogado.papel)) { %>
            <form action="/clientes/<%= cliente.id %>?_method=DELETE" method="POST" onsubmit="return confirm('ATENÇÃO: Deletar este cliente removerá todos os seus veículos e histórico do sistema de forma irreversível. Deseja continuar?')" class="inline">
              <button type="submit" class="inline-flex items-center space-x-1.5 bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 font-semibold py-2 px-4 rounded-xl text-sm transition-all shadow-sm">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
                <span>Excluir Cliente</span>
              </button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Mensagens -->
    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-sm flex items-start space-x-2 shadow-sm">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Layout: Ficha do Cliente e Veículos -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Ficha de Cadastro (1/3) -->
      <div class="space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-100">
            <div class="w-12 h-12 rounded-2xl bg-brand-100 text-brand-600 flex items-center justify-center font-extrabold text-lg select-none mb-4">
              <%= cliente.usuario.nome.substring(0, 2).toUpperCase() %>
            </div>
            <h2 class="text-xl font-bold text-slate-900 leading-tight"><%= cliente.usuario.nome %></h2>
            <span class="text-xs text-slate-400 block mt-1 uppercase font-bold tracking-wider">Cliente cadastrado</span>
          </div>

          <div class="p-6 space-y-4 text-sm">
            <div>
              <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">CPF</span>
              <span class="font-mono font-semibold text-slate-800 mt-0.5 block"><%= cliente.cpf %></span>
            </div>
            
            <div>
              <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">E-mail</span>
              <span class="text-slate-800 mt-0.5 block truncate"><%= cliente.usuario.email %></span>
            </div>

            <div>
              <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Telefone / WhatsApp</span>
              <span class="text-slate-800 mt-0.5 block"><%= cliente.telefone_whatsapp || 'Não informado' %></span>
            </div>

            <div class="pt-4 border-t border-slate-100">
              <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Endereço Registrado</span>
              <div class="text-slate-600 leading-relaxed text-xs">
                <% if (cliente.logradouro) { %>
                  <p><%= cliente.logradouro %>, Nº <%= cliente.numero %></p>
                  <p><%= cliente.bairro %> - <%= cliente.cidade %>/<%= cliente.estado %></p>
                  <p>CEP: <%= cliente.cep || 'N/I' %></p>
                <% } else { %>
                  <p class="italic text-slate-400">Endereço não cadastrado.</p>
                <% } %>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 space-y-2">
              <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Consentimento LGPD</span>
              <div class="flex items-center space-x-2">
                <% if (cliente.consentimento_lgpd) { %>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-800 border border-green-200">
                    CONCEDIDO
                  </span>
                  <span class="text-[10px] text-slate-400"><%= new Date(cliente.data_consentimento_lgpd).toLocaleDateString('pt-BR') %></span>
                <% } else { %>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-200">
                    REVOGADO / INATIVO
                  </span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Histórico de Veículos (2/3) -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Veículos Cadastrados -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <i data-lucide="car" class="w-5 h-5 text-brand-500"></i>
                <span>Veículos do Cliente</span>
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">Veículos registrados para emissão de alertas.</p>
            </div>
            <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
              <a href="/veiculos/novo?cliente_id=<%= cliente.id %>" class="inline-flex items-center space-x-1.5 bg-brand-50 hover:bg-brand-100 border border-brand-200 text-brand-700 font-bold py-2 px-3 rounded-lg text-xs transition-colors shrink-0">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Adicionar Veículo</span>
              </a>
            <% } %>
          </div>

          <div class="divide-y divide-slate-100">
            <% if (cliente.veiculos && cliente.veiculos.length === 0) { %>
              <div class="p-12 text-center text-slate-400">
                <i data-lucide="car" class="w-10 h-10 mx-auto mb-2 text-slate-300"></i>
                <p class="text-sm">Nenhum veículo cadastrado para este cliente.</p>
              </div>
            <% } else { %>
              <% cliente.veiculos.forEach(veiculo => { %>
                <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/50 transition-colors">
                  <div class="flex items-center space-x-4">
                    <!-- Placa Estilizada -->
                    <div class="bg-slate-950 text-white font-mono font-bold text-sm border-2 border-slate-800 rounded-lg px-3 py-1.5 shadow-sm uppercase tracking-wider select-none">
                      <%= veiculo.placa %>
                    </div>
                    <div>
                      <span class="text-base font-bold text-slate-900 block">
                        <%= veiculo.modelo ? veiculo.modelo.marca.nome + ' ' + veiculo.modelo.nome : 'Modelo não cadastrado' %>
                      </span>
                      <div class="flex items-center gap-3 text-xs text-slate-500 mt-1">
                        <span>Ano: <span class="font-medium text-slate-700"><%= veiculo.ano %></span></span>
                        <span>•</span>
                        <span>Cor: <span class="font-medium text-slate-700"><%= veiculo.cor %></span></span>
                        <span>•</span>
                        <span>KM atual: <span class="font-medium text-slate-700"><%= veiculo.km_atual %> km</span></span>
                      </div>
                    </div>
                  </div>
                  <div>
                    <a href="/veiculos/<%= veiculo.id %>" class="inline-flex items-center space-x-1.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2 px-3 rounded-lg text-xs shadow-sm hover:shadow-md transition-colors">
                      <i data-lucide="wrench" class="w-3.5 h-3.5"></i>
                      <span>Ver Prontuário / Alertas</span>
                    </a>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
