<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-7xl mx-auto space-y-6 sm:space-y-8">
    
    <!-- Cabeçalho -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Área do Cliente</h1>
        <p class="text-slate-600 text-sm sm:text-base md:text-lg mt-1 font-normal">Olá, <%= cliente.usuario.nome %>! Acompanhe o prontuário dos seus veículos e solicite revisões.</p>
      </div>
    </div>

    <!-- Mensagens de Feedback -->
    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-base font-medium flex items-start space-x-2 shadow-sm">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>
    <% if (erroMsg) { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-800 text-base font-medium flex items-start space-x-2 shadow-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-red-600"></i>
        <span><%= erroMsg %></span>
      </div>
    <% } %>

    <!-- Bloco 1: Gestão de Privacidade (LGPD - RF-31/RF-32) -->
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4">
      <div class="flex items-center gap-2.5">
        <i data-lucide="shield-check" class="w-6 h-6 text-brand-500 shrink-0"></i>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">Gerenciamento de Privacidade & Dados Pessoais</h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-4xl font-normal">
        Em conformidade com a Lei Geral de Proteção de Dados (LGPD), você possui total controle sobre seus dados em nosso sistema. Ao manter seu consentimento ativo, nos autoriza a tratar seus dados para fins de envio de alertas automáticos de vencimento de peças no WhatsApp, agendamento de revisões e histórico de manutenção.
      </p>

      <div class="p-4 sm:p-5 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-sm font-semibold
                  <%= cliente.consentimento_lgpd ? 'bg-green-50/60 border-green-200 text-green-800' : 'bg-red-50/60 border-red-200 text-red-800' %>">
        <div class="flex items-start sm:items-center gap-3">
          <span class="w-3 h-3 rounded-full mt-1 sm:mt-0 shrink-0 <%= cliente.consentimento_lgpd ? 'bg-green-500' : 'bg-red-500' %>"></span>
          <div>
            <span class="block font-bold text-base">Status do Consentimento: <%= cliente.consentimento_lgpd ? 'AUTORIZADO / ATIVO' : 'REVOGADO / INATIVO' %></span>
            <% if (cliente.consentimento_lgpd && cliente.data_consentimento_lgpd) { %>
              <span class="text-xs text-slate-500 block font-normal mt-0.5">Autorizado em: <%= new Date(cliente.data_consentimento_lgpd).toLocaleString('pt-BR') %></span>
            <% } else { %>
              <span class="text-xs text-slate-500 block font-normal mt-0.5">Alertas automáticos de WhatsApp e lembretes de revisão estão desativados.</span>
            <% } %>
          </div>
        </div>

        <div>
          <% if (cliente.consentimento_lgpd) { %>
            <form action="/cliente/revogar-consentimento" method="POST" onsubmit="confirmarAcaoModal(event, 'Ao revogar, você não receberá mais notificações sobre vencimento de peças ou agendamentos.', 'Revogar Consentimento?'); return false;">
              <button type="submit" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 px-4 rounded-xl shadow-sm hover:shadow-md transition-all text-sm">
                Revogar Consentimento
              </button>
            </form>
          <% } else { %>
            <form action="/cliente/dar-consentimento" method="POST">
              <button type="submit" class="w-full sm:w-auto bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 px-4 rounded-xl shadow-sm hover:shadow-md transition-all text-sm">
                Conceder Consentimento
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Layout Grid: Meus Veículos e Solicitação/Agenda -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Lado Esquerdo: Lista de Veículos & Alertas (2/3) -->
      <div class="lg:col-span-2 space-y-6 sm:space-y-8">
        
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-6">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-2.5">
            <i data-lucide="car" class="w-6 h-6 text-brand-500"></i>
            <span>Meus Veículos Cadastrados</span>
          </h2>
          
          <div class="space-y-6 divide-y divide-slate-100">
            <% if (veiculosComAlertas.length === 0) { %>
              <div class="text-center text-slate-500 py-10 font-medium">
                Nenhum veículo vinculado ao seu CPF no sistema.
              </div>
            <% } else { %>
              <% veiculosComAlertas.forEach(item => { %>
                <div class="pt-6 first:pt-0 space-y-4">
                  <!-- Bloco Cabeçalho Veículo -->
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex flex-col xs:flex-row xs:items-center gap-3.5 sm:space-x-4">
                      <span class="px-3 py-1.5 rounded-lg bg-slate-900 text-white font-mono font-bold text-sm sm:text-base uppercase tracking-wider border border-slate-700 shadow-sm self-start xs:self-auto">
                        <%= item.veiculo.placa %>
                      </span>
                      <div>
                        <h3 class="text-base sm:text-lg font-bold text-slate-900"><%= item.veiculo.modelo ? item.veiculo.modelo.marca.nome + ' ' + item.veiculo.modelo.nome : 'Modelo N/I' %></h3>
                        <span class="text-xs sm:text-sm text-slate-600 mt-0.5 block font-medium">
                          KM Atual: <span class="font-bold text-slate-800"><%= item.veiculo.km_atual %> km</span> | Ano: <span class="font-bold text-slate-800"><%= item.veiculo.ano %></span>
                        </span>
                      </div>
                    </div>
                    <a href="/cliente/veiculo/<%= item.veiculo.id %>" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-4 rounded-xl text-sm shadow-sm transition-colors text-center">
                      <i data-lucide="history" class="w-4 h-4"></i>
                      <span>Ver Linha do Tempo</span>
                    </a>
                  </div>

                  <!-- Alertas Ativos das Peças deste Veículo -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pl-0 sm:pl-4">
                    <% if (item.alertas.length === 0) { %>
                      <div class="col-span-1 sm:col-span-2 text-sm text-slate-500 italic py-2">
                        Nenhuma peça possui trocas cadastradas para exibir alertas neste veículo.
                      </div>
                    <% } else { %>
                      <% item.alertas.forEach(al => { %>
                        <div class="p-4 rounded-xl border flex flex-col justify-between space-y-2.5 <%= al.alerta.cor %> shadow-sm">
                          <div class="flex justify-between items-start gap-2">
                            <div>
                              <span class="text-sm sm:text-base font-bold block leading-tight text-slate-900"><%= al.peca.nome %></span>
                              <span class="text-xs text-slate-600 mt-0.5 block">Marca: <%= al.peca.marca.nome %></span>
                            </div>
                            
                            <% if (al.alerta.status === 'vencido') { %>
                              <span class="p-1 rounded-full bg-red-200 text-red-800 shrink-0"><i data-lucide="x" class="w-4 h-4"></i></span>
                            <% } else if (al.alerta.status === 'proximo') { %>
                              <span class="p-1 rounded-full bg-yellow-200 text-yellow-800 shrink-0"><i data-lucide="alert-triangle" class="w-4 h-4"></i></span>
                            <% } else { %>
                              <span class="p-1 rounded-full bg-green-200 text-green-800 shrink-0"><i data-lucide="check" class="w-4 h-4"></i></span>
                            <% } %>
                          </div>

                          <div class="text-xs space-y-1 opacity-95 border-t border-black/10 pt-2 leading-relaxed">
                            <div class="flex justify-between text-slate-700">
                              <span>Próxima prevista:</span>
                              <span class="font-bold text-slate-900">
                                <%= al.troca.km_previsto_proximo ? al.troca.km_previsto_proximo + ' km' : 'Não definido' %>
                              </span>
                            </div>
                            <div class="flex justify-between text-slate-700">
                              <span>Data prevista:</span>
                              <span class="font-bold text-slate-900">
                                <%= al.troca.data_prevista_proximo ? new Date(al.troca.data_prevista_proximo).toLocaleDateString('pt-BR') : 'Não definido' %>
                              </span>
                            </div>
                            <span class="block text-xs uppercase font-extrabold tracking-wider mt-1.5 text-slate-900">
                              Status: <%= al.alerta.mensagem %>
                            </span>
                          </div>
                        </div>
                      <% }) %>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

      </div>

      <!-- Lado Direito: Solicitar Revisão & Minha Agenda (1/3) -->
      <div class="space-y-6 sm:space-y-8">
        
        <!-- Solicitar Revisão (RF-30) -->
        <% if (veiculosComAlertas.length > 0) { %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-5">
            <div>
              <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <i data-lucide="calendar-plus" class="w-5 h-5 text-indigo-500"></i>
                <span>Solicitar Agendamento</span>
              </h2>
              <p class="text-xs sm:text-sm text-slate-500 mt-0.5 font-normal">Selecione o veículo e o horário desejado.</p>
            </div>

            <form action="/cliente/solicitar-manutencao" method="POST" class="space-y-4">
              <!-- Veículo -->
              <div>
                <label for="veiculo_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Escolha seu veículo *</label>
                <select id="veiculo_id" name="veiculo_id" required
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
                  <option value="" disabled selected>Selecione...</option>
                  <% veiculosComAlertas.forEach(item => { %>
                    <option value="<%= item.veiculo.id %>"><%= item.veiculo.placa %> - <%= item.veiculo.modelo ? item.veiculo.modelo.nome : '' %></option>
                  <% }) %>
                </select>
              </div>

              <!-- Data -->
              <div>
                <label for="data_agendada" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Data desejada *</label>
                <input type="date" id="data_agendada" name="data_agendada" required onchange="carregarHorariosDisponiveisCliente(this.value)"
                       min="<%= new Date().toISOString().split('T')[0] %>"
                       class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              </div>

              <!-- Horário -->
              <div>
                <label for="horario_agendado" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">Horário disponível *</label>
                <select id="horario_agendado" name="horario_agendado" required disabled
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium disabled:opacity-60">
                  <option value="" disabled selected>Selecione o horário...</option>
                </select>
              </div>

              <!-- Motivo -->
              <div>
                <label for="motivo_revisao" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">O que precisa ser revisado? *</label>
                <input type="text" id="motivo_revisao" name="motivo_revisao" required placeholder="Ex: Revisão preventiva de 50.000km"
                       class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              </div>

              <button type="submit" 
                      class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-3 px-4 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-base flex items-center justify-center space-x-2">
                <span>Solicitar Revisão</span>
                <i data-lucide="check" class="w-5 h-5"></i>
              </button>
            </form>
          </div>
        <% } %>

        <!-- Minha Agenda -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-5">
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <i data-lucide="calendar" class="w-5 h-5 text-brand-500"></i>
            <span>Meus Agendamentos</span>
          </h2>

          <div class="divide-y divide-slate-100 max-h-[300px] overflow-y-auto pr-1">
            <% if (agendamentos.length === 0) { %>
              <div class="text-center text-slate-500 py-6 text-sm font-medium">
                Nenhum agendamento futuro programado.
              </div>
            <% } else { %>
              <% agendamentos.forEach(a => { %>
                <div class="py-3.5 flex justify-between items-center text-sm gap-3">
                  <div>
                    <span class="font-bold text-slate-900 block uppercase font-mono text-base"><%= a.veiculo ? a.veiculo.placa : 'Placa N/I' %></span>
                    <span class="text-slate-700 font-medium block mt-0.5">"<%= a.motivo_revisao %>"</span>
                    <span class="text-slate-500 text-xs block mt-0.5">
                      <%= new Date(a.data_agendada).toLocaleDateString('pt-BR') %> às <%= a.horario_agendado %>
                    </span>
                  </div>
                  <div class="shrink-0">
                    <% if (a.status === 'agendado') { %>
                      <span class="px-2.5 py-1 rounded-full bg-sky-50 text-sky-700 border border-sky-200 font-bold uppercase text-xs">Marcado</span>
                    <% } else if (a.status === 'concluido') { %>
                      <span class="px-2.5 py-1 rounded-full bg-green-50 text-green-700 border border-green-200 font-bold uppercase text-xs">Concluído</span>
                    <% } else { %>
                      <span class="px-2.5 py-1 rounded-full bg-red-50 text-red-700 border border-red-200 font-bold uppercase text-xs">Cancelado</span>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  // Busca horários livres para o cliente
  async function carregarHorariosDisponiveisCliente(data) {
    const selectHorario = document.getElementById('horario_agendado');
    selectHorario.innerHTML = '<option value="" disabled selected>Buscando horários...</option>';
    selectHorario.disabled = true;

    if (!data) return;

    try {
      const res = await fetch(`/agendamentos/horarios-disponiveis?data=${data}`);
      if (res.ok) {
        const lista = await res.json();
        selectHorario.innerHTML = '<option value="" disabled selected>Selecione...</option>';
        
        lista.forEach(item => {
          if (item.ocupado) {
            selectHorario.innerHTML += `<option value="${item.horario}" disabled class="text-red-400 bg-red-50">${item.horario} (Ocupado)</option>`;
          } else {
            selectHorario.innerHTML += `<option value="${item.horario}" class="text-slate-800">${item.horario} (Livre)</option>`;
          }
        });
        selectHorario.disabled = false;
      } else {
        selectHorario.innerHTML = '<option value="" disabled>Erro ao buscar horários.</option>';
      }
    } catch (error) {
      console.error(error);
      selectHorario.innerHTML = '<option value="" disabled>Erro de conexão.</option>';
    }
  }
</script>

<%- include('../parciais/rodape') %>
