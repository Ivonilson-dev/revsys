<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<script src="https://unpkg.com/imask"></script>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-3xl mx-auto space-y-6">
    
    <!-- Link Voltar -->
    <a href="/veiculos/<%= veiculo.id %>" class="inline-flex items-center space-x-1 text-slate-500 hover:text-slate-900 transition-colors text-sm font-semibold">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      <span>Voltar para Detalhes</span>
    </a>

    <!-- Alerta de Erro -->
    <% if (erro) { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-800 text-sm flex items-start space-x-2 shadow-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-red-600"></i>
        <span><%= erro %></span>
      </div>
    <% } %>

    <!-- Título -->
    <div>
      <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Editar Veículo: <%= veiculo.placa %></h1>
      <p class="text-slate-500 mt-1">Atualize as informações do veículo do cliente <%= veiculo.cliente.usuario.nome %>.</p>
    </div>

    <!-- Card de Formulário -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <form action="/veiculos/<%= veiculo.id %>?_method=PUT" method="POST" class="space-y-6">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Cliente (Desabilitado na Edição para Segurança de Vínculo) -->
          <div class="col-span-1 sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1.5">Proprietário (Cliente)</label>
            <input type="text" disabled value="<%= veiculo.cliente.usuario.nome %> (CPF: <%= veiculo.cliente.cpf %>)"
                   class="w-full bg-slate-100 border border-slate-200 text-slate-400 rounded-xl py-2.5 px-3.5 text-sm cursor-not-allowed">
          </div>

          <!-- Seleção de Marca -->
          <div>
            <label for="marca_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Marca do Veículo *</label>
            <select id="marca_id" required
                    class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              <option value="" disabled selected>Selecione a Marca...</option>
              <% marcas.forEach(m => { %>
                <option value="<%= m.id %>"><%= m.nome %></option>
              <% }) %>
            </select>
          </div>

          <!-- Seleção de Modelo -->
          <div>
            <label for="modelo_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Modelo do Veículo *</label>
            <select id="modelo_id" name="modelo_id" required disabled
                    class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all disabled:opacity-60 disabled:cursor-not-allowed">
              <option value="" disabled selected>Selecione primeiro a Marca...</option>
            </select>
          </div>

          <!-- Placa -->
          <div>
            <label for="placa" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Placa do Veículo *</label>
            <input type="text" id="placa" name="placa" required value="<%= veiculo.placa %>"
                   class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all uppercase">
          </div>

          <!-- Ano -->
          <div>
            <label for="ano" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Ano de Fabricação *</label>
            <input type="number" id="ano" name="ano" required min="1950" max="<%= new Date().getFullYear() + 1 %>" value="<%= veiculo.ano %>"
                   class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
          </div>

          <!-- Cor -->
          <div>
            <label for="cor" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Cor *</label>
            <input type="text" id="cor" name="cor" required value="<%= veiculo.cor %>"
                   class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
          </div>

          <!-- KM Atual -->
          <div>
            <label for="km_atual" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Kilometragem Atual *</label>
            <input type="number" id="km_atual" name="km_atual" required min="0" value="<%= veiculo.km_atual %>"
                   class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
          </div>

          <!-- Condição -->
          <div>
            <label for="condicao" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Condição *</label>
            <select id="condicao" name="condicao" required
                    class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              <option value="usado" <%= veiculo.condicao == 'usado' ? 'selected' : '' %>>Usado</option>
              <option value="novo" <%= veiculo.condicao == 'novo' ? 'selected' : '' %>>Novo / Zero KM</option>
            </select>
          </div>

        </div>

        <!-- Botões de Ação -->
        <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
          <a href="/veiculos/<%= veiculo.id %>" class="px-5 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold transition-all">
            Cancelar
          </a>
          <button type="submit" 
                  class="bg-brand-500 hover:bg-brand-600 text-white font-semibold py-2.5 px-6 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-sm flex items-center space-x-2">
            <span>Salvar Alterações</span>
            <i data-lucide="check" class="w-4 h-4"></i>
          </button>
        </div>

      </form>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Dados de modelos passados pelo servidor
    const todosModelos = <%- JSON.stringify(modelos.map(m => ({ id: m.id, nome: m.nome, marca_veiculo_id: m.marca_veiculo_id }))) %>;
    const modeloSelecionadoId = "<%= veiculo.modelo_id || '' %>";

    const marcaSelect = document.getElementById('marca_id');
    const modeloSelect = document.getElementById('modelo_id');

    function atualizarModelos(marcaId, modeloIdParaSelecionar = '') {
      modeloSelect.innerHTML = '<option value="" disabled selected>Selecione o Modelo...</option>';
      
      if (!marcaId) {
        modeloSelect.disabled = true;
        return;
      }

      const modelosFiltrados = todosModelos
        .filter(m => String(m.marca_veiculo_id) === String(marcaId))
        .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));

      if (modelosFiltrados.length === 0) {
        modeloSelect.innerHTML = '<option value="" disabled selected>Nenhum modelo cadastrado para esta marca</option>';
        modeloSelect.disabled = true;
        return;
      }

      modelosFiltrados.forEach(m => {
        const option = document.createElement('option');
        option.value = m.id;
        option.textContent = m.nome;
        if (String(m.id) === String(modeloIdParaSelecionar)) {
          option.selected = true;
        }
        modeloSelect.appendChild(option);
      });

      modeloSelect.disabled = false;
    }

    marcaSelect.addEventListener('change', (e) => {
      atualizarModelos(e.target.value);
    });

    // Pré-selecionar a marca e o modelo atual do veículo na página de edição
    if (modeloSelecionadoId) {
      const modeloAtual = todosModelos.find(m => String(m.id) === String(modeloSelecionadoId));
      if (modeloAtual) {
        marcaSelect.value = modeloAtual.marca_veiculo_id;
        atualizarModelos(modeloAtual.marca_veiculo_id, modeloSelecionadoId);
      }
    }

    const placaInput = document.getElementById('placa');
    if (placaInput) {
      IMask(placaInput, {
        mask: [
          { mask: 'aaa-0000' },
          { mask: 'aaa0a00' }
        ],
        prepare: function (str) {
          return str.toUpperCase();
        }
      });
    }
  });
</script>

<%- include('../parciais/rodape') %>
