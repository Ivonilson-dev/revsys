<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<script src="https://unpkg.com/imask"></script>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-3xl mx-auto space-y-6">
    
    <!-- Link Voltar -->
    <a href="/veiculos" class="inline-flex items-center space-x-1 text-slate-500 hover:text-slate-900 transition-colors text-sm font-semibold">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      <span>Voltar para Frota</span>
    </a>

    <!-- Alerta de Erro -->
    <% if (erro) { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-800 text-sm flex items-start space-x-2 shadow-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-red-600"></i>
        <span><%= erro %></span>
      </div>
    <% } %>

    <!-- Título -->
    <div>
      <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Cadastrar Novo Veículo</h1>
      <p class="text-slate-500 mt-1">Vincule um novo veículo a um cliente cadastrado no sistema.</p>
    </div>

    <!-- Card de Formulário -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <form action="/veiculos" method="POST" class="space-y-6">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Seleção de Cliente -->
          <div class="col-span-1 sm:col-span-2">
            <label for="cliente_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Proprietário (Cliente) *</label>
            <select id="cliente_id" name="cliente_id" required
                    class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              <option value="" disabled selected>Selecione o Cliente...</option>
              <% clientes.forEach(cli => { %>
                <option value="<%= cli.id %>" <%= (clienteId == cli.id || dados.cliente_id == cli.id) ? 'selected' : '' %>>
                  <%= cli.usuario.nome %> (CPF: <%= cli.cpf %>)
                </option>
              <% }) %>
            </select>
          </div>

          <!-- Seleção de Modelo -->
          <div>
            <label for="modelo_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Marca / Modelo do Veículo *</label>
            <select id="modelo_id" name="modelo_id" required
                    class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              <option value="" disabled selected>Selecione a Marca / Modelo...</option>
              <% modelos.forEach(mod => { %>
                <option value="<%= mod.id %>" <%= (dados.modelo_id == mod.id) ? 'selected' : '' %>>
                  <%= mod.marca.nome %> - <%= mod.nome %>
                </option>
              <% }) %>
            </select>
          </div>

          <!-- Placa -->
          <div>
            <label for="placa" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Placa do Veículo *</label>
            <input type="text" id="placa" name="placa" required value="<%= dados.placa || '' %>"
                   placeholder="Ex: ABC-1234 ou ABC1D23"
                   class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all uppercase">
          </div>

          <!-- Ano -->
          <div>
            <label for="ano" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Ano de Fabricação *</label>
            <input type="number" id="ano" name="ano" required min="1950" max="<%= new Date().getFullYear() + 1 %>" value="<%= dados.ano || new Date().getFullYear() %>"
                   class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
          </div>

          <!-- Cor -->
          <div>
            <label for="cor" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Cor *</label>
            <input type="text" id="cor" name="cor" required value="<%= dados.cor || '' %>"
                   placeholder="Ex: Preto, Prata, Vermelho"
                   class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
          </div>

          <!-- KM Atual -->
          <div>
            <label for="km_atual" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Kilometragem Atual *</label>
            <input type="number" id="km_atual" name="km_atual" required min="0" value="<%= dados.km_atual || '0' %>"
                   class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
          </div>

          <!-- Condição -->
          <div>
            <label for="condicao" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1.5">Condição *</label>
            <select id="condicao" name="condicao" required
                    class="w-full bg-slate-50/50 border border-slate-200 text-slate-800 rounded-xl py-2.5 px-3.5 text-sm focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              <option value="usado" <%= dados.condicao == 'usado' ? 'selected' : '' %>>Usado</option>
              <option value="novo" <%= dados.condicao == 'novo' ? 'selected' : '' %>>Novo / Zero KM</option>
            </select>
          </div>

        </div>

        <!-- Botões de Ação -->
        <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
          <a href="/veiculos" class="px-5 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold transition-all">
            Cancelar
          </a>
          <button type="submit" 
                  class="bg-brand-500 hover:bg-brand-600 text-white font-semibold py-2.5 px-6 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-sm flex items-center space-x-2">
            <span>Salvar Veículo</span>
            <i data-lucide="check" class="w-4 h-4"></i>
          </button>
        </div>

      </form>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Máscara Flexível de Placa (Mercosul ou Antiga) - RNF-15
    const placaInput = document.getElementById('placa');
    if (placaInput) {
      IMask(placaInput, {
        mask: [
          { mask: 'aaa-0000' }, // Placa antiga
          { mask: 'aaa0a00' }  // Placa Mercosul
        ],
        prepare: function (str) {
          return str.toUpperCase();
        }
      });
    }
  });
</script>

<%- include('../parciais/rodape') %>
