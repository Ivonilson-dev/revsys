<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Alertas Globais -->
    <% if (erroMsg) { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-800 text-base font-medium flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-red-600"></i>
        <span><%= erroMsg %></span>
      </div>
    <% } %>

    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-base font-medium flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Cabeçalho -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Frota de Veículos</h1>
        <p class="text-slate-600 text-sm sm:text-base md:text-lg mt-1 font-normal">Busque veículos pela placa ou gerencie o cadastro de frota.</p>
      </div>
      <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
        <a href="/veiculos/novo" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-brand-500 hover:bg-brand-600 text-white font-bold py-3 px-5 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-base shrink-0 text-center">
          <i data-lucide="plus" class="w-5 h-5"></i>
          <span>Cadastrar Veículo</span>
        </a>
      <% } %>
    </div>

    <!-- Barra de Pesquisa (RF-16) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4">
      <form action="/veiculos" method="GET" class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
            <i data-lucide="search" class="w-5 h-5"></i>
          </div>
          <input type="text" name="busca" value="<%= busca %>" placeholder="Digite a placa para busca rápida (ex: BRA2E19)..."
                 class="w-full bg-slate-50 border border-slate-300 text-slate-900 font-mono rounded-xl py-3 pl-12 pr-4 text-base placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all uppercase">
        </div>
        <div class="flex items-center gap-2">
          <button type="submit" class="flex-1 sm:flex-none bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 px-7 rounded-xl transition-all text-base shrink-0 flex items-center justify-center space-x-2 shadow-sm">
            <span>Pesquisar</span>
          </button>
          <% if (busca) { %>
            <a href="/veiculos" class="inline-flex items-center justify-center border border-slate-300 hover:bg-slate-50 text-slate-700 py-3 px-5 rounded-xl text-base transition-all font-semibold shrink-0">
              Limpar
            </a>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Tabela / Cards de Veículos -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      
      <!-- Visualização Desktop (Tabela) -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-100/80 border-b border-slate-200 text-slate-700 text-sm font-bold uppercase tracking-wider">
              <th class="p-4 pl-6">Placa</th>
              <th class="p-4">Marca / Modelo</th>
              <th class="p-4">Ano</th>
              <th class="p-4">Cor</th>
              <th class="p-4">Último KM Registrado</th>
              <th class="p-4">Proprietário</th>
              <th class="p-4 pr-6 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-800 text-base">
            <% if (veiculos.length === 0) { %>
              <tr>
                <td colspan="7" class="p-10 text-center text-slate-500 text-base font-medium">
                  <i data-lucide="car" class="w-10 h-10 mx-auto mb-3 text-slate-300"></i>
                  Nenhum veículo encontrado.
                </td>
              </tr>
            <% } else { %>
              <% veiculos.forEach(veiculo => { %>
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="p-4 pl-6">
                    <span class="<%= obterClassePlaca(veiculo.placa) %> px-3 py-1 text-sm">
                      <%= formatarPlaca(veiculo.placa) %>
                    </span>
                  </td>
                  <td class="p-4 font-bold text-slate-900">
                    <%= veiculo.modelo ? veiculo.modelo.marca.nome + ' ' + veiculo.modelo.nome : 'Não Informado' %>
                  </td>
                  <td class="p-4 text-slate-600 font-medium"><%= veiculo.ano %></td>
                  <td class="p-4 text-slate-700 capitalize font-medium"><%= veiculo.cor %></td>
                  <td class="p-4 font-bold text-slate-900"><%= Number(veiculo.km_atual).toLocaleString('pt-BR') %> km</td>
                  <td class="p-4 text-slate-700 font-medium">
                    <%= veiculo.cliente ? veiculo.cliente.usuario.nome : 'Sem Proprietário' %>
                  </td>
                  <td class="p-4 pr-6 text-right space-x-2">
                    <a href="/veiculos/<%= veiculo.id %>" class="inline-flex items-center justify-center p-2.5 rounded-xl hover:bg-slate-200 text-slate-600 hover:text-slate-950 transition-colors" title="Ver Prontuário / Alertas">
                      <i data-lucide="wrench" class="w-5 h-5"></i>
                    </a>
                    <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                      <a href="/veiculos/<%= veiculo.id %>/editar" class="inline-flex items-center justify-center p-2.5 rounded-xl hover:bg-slate-200 text-slate-600 hover:text-slate-950 transition-colors" title="Editar">
                        <i data-lucide="edit-2" class="w-5 h-5"></i>
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Visualização Mobile (Cards) -->
      <div class="block md:hidden divide-y divide-slate-100">
        <% if (veiculos.length === 0) { %>
          <div class="p-8 text-center text-slate-500 text-base font-medium">
            <i data-lucide="car" class="w-10 h-10 mx-auto mb-3 text-slate-300"></i>
            Nenhum veículo encontrado.
          </div>
        <% } else { %>
          <% veiculos.forEach(veiculo => { %>
            <div class="p-4 sm:p-5 space-y-3.5 hover:bg-slate-50/70 transition-colors">
              <div class="flex items-center justify-between gap-2">
                <span class="<%= obterClassePlaca(veiculo.placa) %> px-2.5 py-1 text-xs sm:text-sm">
                  <%= formatarPlaca(veiculo.placa) %>
                </span>
                <span class="font-bold text-slate-900 text-sm sm:text-base truncate">
                  <%= veiculo.modelo ? veiculo.modelo.marca.nome + ' ' + veiculo.modelo.nome : 'Modelo N/I' %>
                </span>
              </div>
              
              <div class="grid grid-cols-2 gap-3 text-sm text-slate-600">
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">Último KM Registrado</span>
                  <span class="font-bold text-slate-900 text-sm sm:text-base"><%= Number(veiculo.km_atual).toLocaleString('pt-BR') %> km</span>
                </div>
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">Cor / Ano</span>
                  <span class="text-slate-800 font-medium capitalize text-sm sm:text-base"><%= veiculo.cor %> / <%= veiculo.ano %></span>
                </div>
                <div class="col-span-2">
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">Proprietário</span>
                  <span class="text-slate-900 font-semibold truncate block text-sm sm:text-base"><%= veiculo.cliente ? veiculo.cliente.usuario.nome : 'Sem Proprietário' %></span>
                </div>
              </div>

              <!-- Ações no Mobile -->
              <div class="flex items-center gap-2 pt-3 border-t border-slate-100">
                <a href="/veiculos/<%= veiculo.id %>" class="flex-1 text-center py-2.5 px-3 rounded-xl border border-slate-300 bg-white text-slate-800 font-bold text-sm hover:bg-slate-50 active:bg-slate-100 transition-colors shadow-sm">
                  Ver Ficha / Registrar Troca
                </a>
                <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                  <a href="/veiculos/<%= veiculo.id %>/editar" class="w-11 h-11 flex items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 active:bg-slate-100 transition-colors shadow-sm shrink-0" title="Editar">
                    <i data-lucide="edit-2" class="w-5 h-5"></i>
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
