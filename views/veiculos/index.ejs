<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Alertas Globais -->
    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-sm flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Cabeçalho -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Frota de Veículos</h1>
        <p class="text-slate-500 mt-1">Busque veículos pela placa ou gerencie o cadastro de frota.</p>
      </div>
      <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
        <a href="/veiculos/novo" class="inline-flex items-center justify-center space-x-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-sm shrink-0">
          <i data-lucide="plus" class="w-5 h-5"></i>
          <span>Cadastrar Veículo</span>
        </a>
      <% } %>
    </div>

    <!-- Barra de Pesquisa (RF-16) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4">
      <form action="/veiculos" method="GET" class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <i data-lucide="search" class="w-5 h-5"></i>
          </div>
          <input type="text" name="busca" value="<%= busca %>" placeholder="Digite a placa para busca rápida (ex: ABC1D23)..."
                 class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2.5 pl-11 pr-4 text-sm placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:bg-white transition-all uppercase">
        </div>
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2.5 px-6 rounded-xl transition-all text-sm shrink-0 flex items-center justify-center space-x-2">
          <span>Pesquisar</span>
        </button>
        <% if (busca) { %>
          <a href="/veiculos" class="inline-flex items-center justify-center border border-slate-200 hover:bg-slate-50 text-slate-700 py-2.5 px-4 rounded-xl text-sm transition-all font-semibold">
            Limpar Filtro
          </a>
        <% } %>
      </form>
    </div>

    <!-- Tabela / Cards de Veículos -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      
      <!-- Visualização Desktop (Tabela) -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/70 border-b border-slate-200 text-slate-400 text-xs font-bold uppercase tracking-wider">
              <th class="p-4 pl-6">Placa</th>
              <th class="p-4">Marca / Modelo</th>
              <th class="p-4">Ano</th>
              <th class="p-4">Cor</th>
              <th class="p-4">KM Atual</th>
              <th class="p-4">Proprietário</th>
              <th class="p-4 pr-6 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700 text-sm">
            <% if (veiculos.length === 0) { %>
              <tr>
                <td colspan="7" class="p-8 text-center text-slate-400">
                  <i data-lucide="car" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                  Nenhum veículo encontrado.
                </td>
              </tr>
            <% } else { %>
              <% veiculos.forEach(veiculo => { %>
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="p-4 pl-6">
                    <span class="px-2.5 py-1 rounded bg-slate-900 text-white font-mono font-bold text-xs uppercase border border-slate-700 tracking-wider shadow-sm">
                      <%= veiculo.placa %>
                    </span>
                  </td>
                  <td class="p-4 font-semibold text-slate-900">
                    <%= veiculo.modelo ? veiculo.modelo.marca.nome + ' ' + veiculo.modelo.nome : 'Não Informado' %>
                  </td>
                  <td class="p-4 text-slate-500"><%= veiculo.ano %></td>
                  <td class="p-4"><%= veiculo.cor %></td>
                  <td class="p-4 font-medium"><%= veiculo.km_atual %> km</td>
                  <td class="p-4 text-slate-600">
                    <%= veiculo.cliente ? veiculo.cliente.usuario.nome : 'Sem Proprietário' %>
                  </td>
                  <td class="p-4 pr-6 text-right space-x-2">
                    <a href="/veiculos/<%= veiculo.id %>" class="inline-flex items-center justify-center p-2 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-950 transition-colors" title="Ver Prontuário / Alertas">
                      <i data-lucide="wrench" class="w-4.5 h-4.5"></i>
                    </a>
                    <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                      <a href="/veiculos/<%= veiculo.id %>/editar" class="inline-flex items-center justify-center p-2 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-950 transition-colors" title="Editar">
                        <i data-lucide="edit-2" class="w-4.5 h-4.5"></i>
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Visualização Mobile (Cards) -->
      <div class="block md:hidden divide-y divide-slate-100">
        <% if (veiculos.length === 0) { %>
          <div class="p-8 text-center text-slate-400">
            <i data-lucide="car" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
            Nenhum veículo encontrado.
          </div>
        <% } else { %>
          <% veiculos.forEach(veiculo => { %>
            <div class="p-4 space-y-3 hover:bg-slate-50/50 transition-colors">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-0.5 rounded bg-slate-900 text-white font-mono font-bold text-xs uppercase border border-slate-700 tracking-wider">
                  <%= veiculo.placa %>
                </span>
                <span class="font-bold text-slate-900">
                  <%= veiculo.modelo ? veiculo.modelo.marca.nome + ' ' + veiculo.modelo.nome : 'Modelo N/I' %>
                </span>
              </div>
              
              <div class="grid grid-cols-2 gap-2 text-xs text-slate-500">
                <div>
                  <span class="block text-slate-400 font-bold uppercase tracking-wider text-[9px]">KM Atual</span>
                  <span class="font-semibold text-slate-800"><%= veiculo.km_atual %> km</span>
                </div>
                <div>
                  <span class="block text-slate-400 font-bold uppercase tracking-wider text-[9px]">Cor / Ano</span>
                  <span class="text-slate-800"><%= veiculo.cor %> / <%= veiculo.ano %></span>
                </div>
                <div class="col-span-2">
                  <span class="block text-slate-400 font-bold uppercase tracking-wider text-[9px]">Proprietário</span>
                  <span class="text-slate-800 truncate block"><%= veiculo.cliente ? veiculo.cliente.usuario.nome : 'Sem Proprietário' %></span>
                </div>
              </div>

              <!-- Ações no Mobile -->
              <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
                <a href="/veiculos/<%= veiculo.id %>" class="flex-1 text-center py-2 px-3 rounded-lg border border-slate-200 text-slate-700 font-semibold text-xs hover:bg-slate-50">
                  Ver Ficha / Registrar Troca
                </a>
                <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                  <a href="/veiculos/<%= veiculo.id %>/editar" class="p-2 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50" title="Editar">
                    <i data-lucide="edit-2" class="w-4 h-4 mx-auto"></i>
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
