<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Link Voltar & Ações -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <a href="/veiculos" class="inline-flex items-center space-x-1 text-slate-500 hover:text-slate-900 transition-colors text-sm font-semibold">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Voltar para Frota</span>
      </a>
      <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
        <div class="flex items-center space-x-2">
          <a href="/veiculos/<%= veiculo.id %>/editar" class="inline-flex items-center space-x-1.5 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-semibold py-2 px-4 rounded-xl text-sm transition-all shadow-sm">
            <i data-lucide="edit" class="w-4 h-4"></i>
            <span>Editar Veículo</span>
          </a>
          <% if (['admin', 'gerente'].includes(usuarioLogado.papel)) { %>
            <form action="/veiculos/<%= veiculo.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Tem certeza que deseja deletar este veículo? Todos os registros de trocas de peças serão apagados!')" class="inline">
              <button type="submit" class="inline-flex items-center space-x-1.5 bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 font-semibold py-2 px-4 rounded-xl text-sm transition-all shadow-sm">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
                <span>Excluir Veículo</span>
              </button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Alertas Globais -->
    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-sm flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Cabeçalho / Identidade do Veículo -->
    <div class="bg-slate-900 text-white rounded-2xl p-6 md:p-8 border border-slate-800 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center space-x-6">
        <!-- Placa Em Destaque -->
        <div class="bg-white text-slate-900 font-mono font-extrabold text-2xl border-4 border-slate-750 rounded-xl px-4 py-2.5 shadow-md uppercase tracking-widest select-none shrink-0">
          <%= veiculo.placa %>
        </div>
        <div>
          <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">
            <%= veiculo.modelo ? veiculo.modelo.marca.nome + ' ' + veiculo.modelo.nome : 'Modelo N/I' %>
          </h1>
          <p class="text-slate-400 mt-1 text-sm font-medium">
            Proprietário: <a href="/clientes/<%= veiculo.cliente_id %>" class="text-brand-400 hover:underline"><%= veiculo.cliente.usuario.nome %></a>
          </p>
        </div>
      </div>
      
      <!-- Detalhes Rápidos -->
      <div class="grid grid-cols-3 gap-4 border-t border-slate-850 pt-4 md:pt-0 md:border-t-0 md:pl-6 md:border-l md:border-slate-800 text-center">
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">KM Atual</span>
          <span class="text-lg font-extrabold text-white mt-0.5 block"><%= veiculo.km_atual %> km</span>
        </div>
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Ano</span>
          <span class="text-lg font-extrabold text-white mt-0.5 block"><%= veiculo.ano %></span>
        </div>
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Cor</span>
          <span class="text-lg font-extrabold text-white mt-0.5 block capitalize"><%= veiculo.cor %></span>
        </div>
      </div>
    </div>

    <!-- Grid Layout de Prontuário -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Coluna Esquerda: Alertas de Peças e Histórico de Trocas (2/3) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Status de Alerta das Peças (RF-14) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div>
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="shield-alert" class="w-5 h-5 text-brand-500"></i>
              <span>Alertas Ativos por Peça</span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Alertas automáticos de acordo com a KM ou data previstos na última troca de cada componente.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% if (alertasPecas.length === 0) { %>
              <div class="col-span-1 sm:col-span-2 p-6 border border-dashed border-slate-200 rounded-xl text-center text-slate-400">
                <i data-lucide="info" class="w-6 h-6 mx-auto mb-2 text-slate-350"></i>
                <p class="text-sm">Nenhuma peça possui trocas registradas para emitir alertas.</p>
              </div>
            <% } else { %>
              <% alertasPecas.forEach(item => { %>
                <div class="p-4 rounded-xl border flex flex-col justify-between space-y-3 <%= item.alerta.cor %> shadow-sm">
                  <div class="flex items-start justify-between">
                    <div>
                      <span class="font-bold text-sm block leading-tight"><%= item.peca.nome %></span>
                      <span class="text-[10px] font-medium opacity-80 mt-0.5 block">Marca: <%= item.peca.marca.nome %></span>
                    </div>
                    
                    <!-- Ícones com base no status -->
                    <% if (item.alerta.status === 'vencido') { %>
                      <span class="p-1 rounded-full bg-red-200 text-red-800"><i data-lucide="x" class="w-4 h-4"></i></span>
                    <% } else if (item.alerta.status === 'proximo') { %>
                      <span class="p-1 rounded-full bg-yellow-200 text-yellow-800"><i data-lucide="alert-triangle" class="w-4 h-4"></i></span>
                    <% } else { %>
                      <span class="p-1 rounded-full bg-green-200 text-green-800"><i data-lucide="check" class="w-4 h-4"></i></span>
                    <% } %>
                  </div>

                  <div class="text-xs space-y-1 opacity-90 border-t border-black/5 pt-2">
                    <div class="flex justify-between">
                      <span>Última troca:</span>
                      <span class="font-semibold"><%= new Date(item.troca.data_troca).toLocaleDateString('pt-BR') %></span>
                    </div>
                    <% if (item.troca.km_previsto_proximo) { %>
                      <div class="flex justify-between">
                        <span>Previsão KM:</span>
                        <span class="font-semibold"><%= item.troca.km_previsto_proximo %> km</span>
                      </div>
                    <% } %>
                    <% if (item.troca.data_prevista_proximo) { %>
                      <div class="flex justify-between">
                        <span>Previsão Data:</span>
                        <span class="font-semibold"><%= new Date(item.troca.data_prevista_proximo).toLocaleDateString('pt-BR') %></span>
                      </div>
                    <% } %>
                    <div class="text-[10px] font-bold mt-2 uppercase tracking-wide">
                      Status: <%= item.alerta.mensagem %>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </section>

        <!-- Linha do Tempo de Manutenções (Trocas de Peças e Serviços Prestados) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <i data-lucide="git-commit" class="w-5 h-5 text-brand-500"></i>
                <span>Linha do Tempo de Manutenções</span>
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">Histórico completo de trocas de peças e serviços prestados no veículo.</p>
            </div>
          </div>

          <!-- Histórico de Serviços (Sem Peça) -->
          <% if (historicoServicos && historicoServicos.length > 0) { %>
            <div class="space-y-3">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-1.5 border-b border-slate-100 pb-2">
                <i data-lucide="wrench" class="w-4 h-4 text-emerald-500"></i>
                <span>Serviços Prestados (<%= historicoServicos.length %>)</span>
              </h3>
              <div class="space-y-3">
                <% historicoServicos.forEach(serv => { %>
                  <div class="bg-slate-50 rounded-xl p-4 border border-slate-200/60 shadow-sm space-y-2">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                      <h4 class="font-bold text-slate-800 text-sm flex items-center gap-1.5">
                        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-500"></i>
                        <span><%= serv.servico.nome %></span>
                        <% if (serv.servico.categoria) { %>
                          <span class="text-[10px] font-medium text-slate-500 bg-slate-200/60 px-1.5 py-0.5 rounded uppercase"><%= serv.servico.categoria %></span>
                        <% } %>
                      </h4>
                      <span class="text-xs font-semibold text-slate-400 bg-white border border-slate-200 px-2 py-0.5 rounded-md self-start sm:self-auto shrink-0 shadow-sm">
                        <%= new Date(serv.data_servico).toLocaleDateString('pt-BR') %>
                      </span>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-slate-500 border-t border-slate-200/50 pt-2">
                      <div>
                        <span class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">KM no Serviço</span>
                        <span class="text-slate-800 font-semibold mt-0.5 block"><%= serv.km_no_servico %> km</span>
                      </div>
                      <div>
                        <span class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">Próxima (KM)</span>
                        <span class="text-slate-800 font-semibold mt-0.5 block"><%= serv.km_previsto_proximo ? serv.km_previsto_proximo + ' km' : 'N/I' %></span>
                      </div>
                      <div>
                        <span class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">Próxima (Data)</span>
                        <span class="text-slate-800 font-semibold mt-0.5 block">
                          <%= serv.data_prevista_proximo ? new Date(serv.data_prevista_proximo).toLocaleDateString('pt-BR') : 'N/I' %>
                        </span>
                      </div>
                      <div>
                        <span class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">Executado por</span>
                        <span class="text-slate-800 font-semibold mt-0.5 block truncate"><%= serv.executado_por %></span>
                      </div>
                    </div>

                    <% if (serv.observacoes) { %>
                      <div class="text-xs text-slate-500 bg-slate-100 p-2 rounded-lg italic">
                        "<%= serv.observacoes %>"
                      </div>
                    <% } %>

                    <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                      <div class="flex justify-end pt-1">
                        <form action="/registro-servico/<%= serv.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Apagar registro deste serviço?')" class="inline">
                          <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-bold flex items-center gap-1">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            <span>Apagar Registro</span>
                          </button>
                        </form>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Trocas de Peças -->
          <div class="space-y-3 pt-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-1.5 border-b border-slate-100 pb-2">
              <i data-lucide="package" class="w-4 h-4 text-brand-500"></i>
              <span>Trocas de Peças (<%= historicoTrocas.length %>)</span>
            </h3>

            <div class="relative pl-6 border-l border-slate-200 space-y-6">
              <% if (historicoTrocas.length === 0) { %>
                <div class="text-center text-slate-400 py-6 pr-6">
                  <i data-lucide="wrench" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                  Nenhum registro de troca de peça encontrado para este veículo.
                </div>
              <% } else { %>
                <% historicoTrocas.forEach(troca => { %>
                  <div class="relative">
                    <div class="absolute -left-[31px] top-1.5 w-4.5 h-4.5 rounded-full border-2 border-white bg-brand-500 shadow-sm flex items-center justify-center">
                      <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                    </div>

                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-200/60 shadow-sm space-y-3">
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <h4 class="font-bold text-slate-800 text-sm flex items-center gap-1.5">
                          <i data-lucide="package" class="w-4 h-4 text-slate-500"></i>
                          <span><%= troca.peca.nome %></span>
                          <span class="text-xs font-normal text-slate-500">(<%= troca.peca.marca.nome %>)</span>
                        </h4>
                        <span class="text-xs font-semibold text-slate-400 bg-white border border-slate-200 px-2 py-0.5 rounded-md self-start sm:self-auto shrink-0 shadow-sm">
                          <%= new Date(troca.data_troca).toLocaleDateString('pt-BR') %>
                        </span>
                      </div>

                      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-slate-500 border-t border-slate-200/50 pt-2.5">
                        <div>
                          <span class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">KM na Troca</span>
                          <span class="text-slate-800 font-semibold mt-0.5 block"><%= troca.km_na_troca %> km</span>
                        </div>
                        <div>
                          <span class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">Próxima (KM)</span>
                          <span class="text-slate-800 font-semibold mt-0.5 block"><%= troca.km_previsto_proximo || 'Não Definido' %></span>
                        </div>
                        <div>
                          <span class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">Próxima (Data)</span>
                          <span class="text-slate-800 font-semibold mt-0.5 block">
                            <%= troca.data_prevista_proximo ? new Date(troca.data_prevista_proximo).toLocaleDateString('pt-BR') : 'Não Definido' %>
                          </span>
                        </div>
                        <div>
                          <span class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">Executado por</span>
                          <span class="text-slate-800 font-semibold mt-0.5 block truncate" title="<%= troca.executado_por %>"><%= troca.executado_por %></span>
                        </div>
                      </div>

                      <% if (troca.oficina || troca.nome_oficina_manual) { %>
                        <div class="text-xs bg-white border border-slate-200/50 p-2 rounded-lg flex items-center gap-1.5 text-slate-600">
                          <i data-lucide="home" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
                          <span class="font-medium">Oficina:</span>
                          <span><%= troca.oficina ? troca.oficina.nome : troca.nome_oficina_manual %></span>
                        </div>
                      <% } %>

                      <% if (troca.observacoes) { %>
                        <div class="text-xs text-slate-500 bg-slate-100 p-2.5 rounded-lg italic">
                          "<%= troca.observacoes %>"
                        </div>
                      <% } %>

                      <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                        <div class="flex justify-end pt-1">
                          <form action="/troca/<%= troca.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Tem certeza que deseja apagar esse registro de troca?')" class="inline">
                            <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-bold flex items-center gap-1">
                              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                              <span>Apagar Registro</span>
                            </button>
                          </form>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </section>

      </div>

      <!-- Coluna Direita: Registro Rápido e Agendamentos (1/3) -->
      <div class="space-y-8">
        
        <!-- Formulário Rápido: Registrar Serviço Realizado (Sem Peça) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div>
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="wrench" class="w-5 h-5 text-emerald-500"></i>
              <span>Registrar Serviço Realizado</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Registre um serviço que não exigiu troca de peças.</p>
          </div>

          <form action="/registro-servico" method="POST" class="space-y-4">
            <input type="hidden" name="veiculo_id" value="<%= veiculo.id %>">
            
            <!-- Serviço -->
            <div>
              <label for="servico_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Serviço Executado *</label>
              <select id="servico_id" name="servico_id" required
                      class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-emerald-500 focus:bg-white transition-all">
                <option value="" disabled selected>Selecione o serviço...</option>
                <% servicos.forEach(s => { %>
                  <option value="<%= s.id %>"><%= s.nome %> <%= s.categoria ? '(' + s.categoria + ')' : '' %></option>
                <% }) %>
              </select>
            </div>

            <!-- KM no Serviço -->
            <div>
              <label for="km_no_servico" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">KM Atual *</label>
              <input type="number" id="km_no_servico" name="km_no_servico" required min="0" value="<%= veiculo.km_atual %>"
                     class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-emerald-500 focus:bg-white transition-all">
            </div>

            <!-- Data do Serviço -->
            <div>
              <label for="data_servico" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Data do Serviço *</label>
              <input type="date" id="data_servico" name="data_servico" required value="<%= new Date().toISOString().split('T')[0] %>"
                     class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-emerald-500 focus:bg-white transition-all">
            </div>

            <!-- Executado Por -->
            <div>
              <label for="executado_por_servico" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Quem executou? *</label>
              <input type="text" id="executado_por_servico" name="executado_por" required value="<%= usuarioLogado.nome %>"
                     class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-emerald-500 focus:bg-white transition-all">
            </div>

            <!-- Observações -->
            <div>
              <label for="observacoes_servico" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Observações</label>
              <textarea id="observacoes_servico" name="observacoes" rows="2" placeholder="Detalhes técnicos do serviço..."
                        class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-emerald-500 focus:bg-white transition-all resize-none"></textarea>
            </div>

            <button type="submit" 
                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md shadow-emerald-500/10 active:scale-[0.98] transition-all text-xs flex items-center justify-center space-x-2">
              <span>Registrar Serviço</span>
              <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
            </button>

          </form>
        </section>
        
        <!-- Formulário Rápido de Registro de Troca (RF-11/RF-12/RF-13) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div>
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="plus-circle" class="w-5 h-5 text-brand-500"></i>
              <span>Registrar Troca de Peça</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Insira um novo registro de troca para calcular alertas.</p>
          </div>

          <form action="/troca" method="POST" class="space-y-4">
            <input type="hidden" name="veiculo_id" value="<%= veiculo.id %>">
            
            <!-- Peça -->
            <div>
              <label for="peca_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Peça Substituída *</label>
              <select id="peca_id" name="peca_id" required
                      class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
                <option value="" disabled selected>Selecione a peça...</option>
                <% pecas.forEach(p => { %>
                  <option value="<%= p.id %>"><%= p.nome %> (<%= p.marca.nome %>)</option>
                <% }) %>
              </select>
            </div>

            <!-- KM na Troca e Atualizar KM -->
            <div>
              <label for="km_na_troca" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">KM no Momento da Troca *</label>
              <input type="number" id="km_na_troca" name="km_na_troca" required min="0" value="<%= veiculo.km_atual %>"
                     class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
              <div class="flex items-center space-x-2 mt-2">
                <input type="checkbox" id="atualizar_km_veiculo" name="atualizar_km_veiculo" value="true" checked
                       class="w-4 h-4 text-brand-600 bg-white border-slate-300 rounded focus:ring-brand-500 cursor-pointer">
                <label for="atualizar_km_veiculo" class="text-[10px] font-medium text-slate-500 cursor-pointer select-none">
                  Atualizar KM atual do veículo para este valor (RF-33)
                </label>
              </div>
            </div>

            <!-- Data da Troca -->
            <div>
              <label for="data_troca" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Data da Troca *</label>
              <input type="date" id="data_troca" name="data_troca" required value="<%= new Date().toISOString().split('T')[0] %>"
                     class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <!-- Previsões (Próxima Troca) -->
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/50 space-y-3">
              <span class="block text-[10px] uppercase font-bold text-slate-400 tracking-wider">Previsão Próxima Troca</span>
              
              <div>
                <label for="km_previsto_proximo" class="block text-[10px] font-semibold text-slate-600 mb-0.5">KM Previsto (Opcional)</label>
                <input type="number" id="km_previsto_proximo" name="km_previsto_proximo" placeholder="Ex: <%= veiculo.km_atual + 10000 %>"
                       class="w-full bg-white border border-slate-200 text-slate-800 rounded-lg py-1.5 px-2 text-xs focus:outline-none focus:border-brand-500 transition-all">
              </div>

              <div>
                <label for="data_prevista_proximo" class="block text-[10px] font-semibold text-slate-600 mb-0.5">Data Prevista (Opcional)</label>
                <input type="date" id="data_prevista_proximo" name="data_prevista_proximo"
                       class="w-full bg-white border border-slate-200 text-slate-800 rounded-lg py-1.5 px-2 text-xs focus:outline-none focus:border-brand-500 transition-all">
              </div>
            </div>

            <!-- Executado Por e Oficina -->
            <div>
              <label for="executado_por" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Quem efetuou a troca? *</label>
              <input type="text" id="executado_por" name="executado_por" required value="<%= usuarioLogado.nome %>"
                     placeholder="Nome do mecânico"
                     class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div>
              <label for="oficina_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Oficina Executante</label>
              <select id="oficina_id" name="oficina_id" onchange="toggleOficinaManual(this)"
                      class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
                <option value="">Outra Oficina (Preenchimento manual)...</option>
                <% oficinas.forEach(o => { %>
                  <option value="<%= o.id %>" <%= o.cnpj === '00000000000000' ? 'selected' : '' %>><%= o.nome %></option>
                <% }) %>
              </select>
            </div>

            <div id="campo_oficina_manual" class="hidden">
              <label for="nome_oficina_manual" class="block text-[10px] font-semibold text-slate-600 mb-0.5">Nome da Oficina Externa</label>
              <input type="text" id="nome_oficina_manual" name="nome_oficina_manual" placeholder="Nome da oficina externa..."
                     class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg py-1.5 px-2 text-xs focus:outline-none focus:border-brand-500 transition-all">
            </div>

            <!-- Observações -->
            <div>
              <label for="observacoes" class="block text-xs font-semibold text-slate-700 uppercase tracking-wide mb-1">Observações / Detalhes</label>
              <textarea id="observacoes" name="observacoes" rows="2" placeholder="Informações adicionais da substituição..."
                        class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 focus:bg-white transition-all resize-none"></textarea>
            </div>

            <button type="submit" 
                    class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-xs flex items-center justify-center space-x-2">
              <span>Registrar Troca</span>
              <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            </button>

          </form>
        </section>

        <!-- Agendamentos do Veículo -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="calendar" class="w-5 h-5 text-indigo-500"></i>
              <span>Agendamentos</span>
            </h2>
            <a href="/agendamentos/calendario-tela" class="text-xs text-brand-500 hover:text-brand-600 font-semibold">Agendar</a>
          </div>

          <div class="divide-y divide-slate-100 max-h-[300px] overflow-y-auto pr-1">
            <% if (agendamentos.length === 0) { %>
              <div class="text-center text-slate-400 py-6 text-xs">
                Nenhum agendamento para este veículo.
              </div>
            <% } else { %>
              <% agendamentos.forEach(a => { %>
                <div class="py-3 flex justify-between items-center text-xs gap-3">
                  <div>
                    <span class="font-bold text-slate-800 block"><%= a.motivo_revisao %></span>
                    <span class="text-slate-400 block mt-0.5">
                      <%= new Date(a.data_agendada).toLocaleDateString('pt-BR') %> às <%= a.horario_agendado %>
                    </span>
                  </div>
                  <div class="shrink-0">
                    <% if (a.status === 'agendado') { %>
                      <span class="px-2 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200 font-bold uppercase text-[9px]">Agendado</span>
                    <% } else if (a.status === 'concluido') { %>
                      <span class="px-2 py-0.5 rounded bg-green-50 text-green-700 border border-green-200 font-bold uppercase text-[9px]">Concluído</span>
                    <% } else { %>
                      <span class="px-2 py-0.5 rounded bg-red-50 text-red-700 border border-red-200 font-bold uppercase text-[9px]">Cancelado</span>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </section>

      </div>

    </div>

  </div>
</div>

<script>
  function toggleOficinaManual(select) {
    const campoManual = document.getElementById('campo_oficina_manual');
    if (select.value === "") {
      campoManual.classList.remove('hidden');
    } else {
      campoManual.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Inicializar estado da oficina manual se selecionado a opção vazia
    const select = document.getElementById('oficina_id');
    if (select) toggleOficinaManual(select);
  });
</script>

<%- include('../parciais/rodape') %>
