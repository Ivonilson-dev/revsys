<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Link Voltar & Ações -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <a href="/veiculos" class="inline-flex items-center space-x-1.5 text-slate-600 hover:text-slate-900 transition-colors text-base font-semibold">
        <i data-lucide="arrow-left" class="w-5 h-5"></i>
        <span>Voltar para Frota</span>
      </a>
      <% 
        let telCliente = veiculo.cliente && veiculo.cliente.telefone_whatsapp ? String(veiculo.cliente.telefone_whatsapp).replace(/\D/g, '') : '';
        if (telCliente.length === 10 || telCliente.length === 11) {
          telCliente = '55' + telCliente;
        }
        const nomeModelo = veiculo.modelo ? (veiculo.modelo.marca ? veiculo.modelo.marca.nome + ' ' : '') + veiculo.modelo.nome : 'veículo';
        const msgWhatsVeiculo = `Olá ${veiculo.cliente && veiculo.cliente.usuario ? veiculo.cliente.usuario.nome : ''}, tudo bem? Entramos em contato da oficina sobre o seu ${nomeModelo} (Placa ${veiculo.placa}).`;
      %>
      <div class="grid grid-cols-1 xs:grid-cols-2 sm:flex sm:items-center gap-2.5 w-full sm:w-auto">
        <% if (telCliente) { %>
          <a href="https://wa.me/<%= telCliente %>?text=<%= encodeURIComponent(msgWhatsVeiculo) %>" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-2.5 px-4 rounded-xl text-sm sm:text-base transition-all shadow-sm">
            <svg class="w-5 h-5 fill-current shrink-0" width="20" height="20" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/></svg>
            <span>WhatsApp Proprietário</span>
          </a>
        <% } %>
        <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
          <a href="/veiculos/<%= veiculo.id %>/editar" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-bold py-2.5 px-4 rounded-xl text-sm sm:text-base transition-all shadow-sm">
            <i data-lucide="edit" class="w-4.5 h-4.5"></i>
            <span>Editar Veículo</span>
          </a>
          <% if (['admin', 'gerente'].includes(usuarioLogado.papel)) { %>
            <form action="/veiculos/<%= veiculo.id %>?_method=DELETE" method="POST" onsubmit="confirmarAcaoModal(event, 'Tem certeza que deseja excluir este veículo? A exclusão só será permitida se não houver manutenções, peças ou serviços vinculados ao seu histórico.', 'Excluir Veículo?'); return false;" class="w-full sm:w-auto inline">
              <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 font-bold py-2.5 px-4 rounded-xl text-sm sm:text-base transition-all shadow-sm">
                <i data-lucide="trash-2" class="w-4.5 h-4.5"></i>
                <span>Excluir Veículo</span>
              </button>
            </form>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- Alertas Globais -->
    <% if (erroMsg) { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-800 text-base font-medium flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-red-600"></i>
        <span><%= erroMsg %></span>
      </div>
    <% } %>

    <% if (sucessoMsg) { %>
      <div id="alerta-global" class="p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-800 text-base font-medium flex items-start space-x-2 shadow-sm transition-all duration-300">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-600"></i>
        <span><%= sucessoMsg %></span>
      </div>
    <% } %>

    <!-- Cabeçalho / Identidade do Veículo -->
    <div class="bg-slate-900 text-white rounded-2xl p-5 sm:p-6 md:p-8 border border-slate-800 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex flex-col xs:flex-row xs:items-center gap-4 sm:space-x-6">
        <!-- Placa Em Destaque (Mercosul ou Padrão Anterior Cinza) -->
        <% if (ehPlacaMercosul(veiculo.placa)) { %>
          <div class="inline-flex flex-col rounded-xl border-2 border-slate-300 bg-white shadow-lg overflow-hidden select-none self-start xs:self-auto shrink-0" title="Padrão Oficial Mercosul">
            <div class="bg-[#003399] text-white px-3 py-0.5 flex items-center justify-between text-[9px] font-black tracking-widest uppercase">
              <span class="text-[8px] font-bold text-sky-200">MERCOSUL</span>
              <span class="font-black text-[9px] tracking-wider text-white">BRASIL</span>
            </div>
            <div class="px-4 py-1.5 sm:px-5 sm:py-2 text-center font-mono font-black text-2xl md:text-3xl text-slate-950 tracking-widest bg-white">
              <%= formatarPlaca(veiculo.placa) %>
            </div>
          </div>
        <% } else { %>
          <div class="inline-flex flex-col rounded-xl border-2 border-slate-600 shadow-lg overflow-hidden select-none self-start xs:self-auto shrink-0" style="background: linear-gradient(180deg, #f1f5f9 0%, #cbd5e1 55%, #94a3b8 100%);" title="Padrão Anterior (Placa Cinza)">
            <div class="bg-slate-400/90 border-b border-slate-500 text-slate-800 px-3 py-0.5 flex items-center justify-between text-[9px] font-black tracking-widest uppercase shadow-inner">
              <span class="text-[8px] font-black text-slate-700 tracking-wider">BRASIL</span>
              <span class="font-bold text-[8px] tracking-widest text-slate-600">● CINZA ●</span>
            </div>
            <div class="px-4 py-1.5 sm:px-5 sm:py-2 text-center font-mono font-black text-2xl md:text-3xl text-slate-950 tracking-widest">
              <%= formatarPlaca(veiculo.placa) %>
            </div>
          </div>
        <% } %>
        <div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight">
            <%= veiculo.modelo ? veiculo.modelo.marca.nome + ' ' + veiculo.modelo.nome : 'Modelo N/I' %>
          </h1>
          <p class="text-slate-300 mt-1 text-sm sm:text-base font-medium flex flex-wrap items-center gap-2">
            <span>Proprietário: <a href="/clientes/<%= veiculo.cliente_id %>" class="text-brand-400 hover:text-brand-300 font-bold underline"><%= veiculo.cliente.usuario.nome %></a></span>
            <% if (telCliente) { %>
              <a href="https://wa.me/<%= telCliente %>?text=<%= encodeURIComponent(msgWhatsVeiculo) %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#25D366] hover:bg-[#128C7E] text-white text-xs font-bold transition-all shadow-sm shrink-0" title="Chamar no WhatsApp">
                <svg class="w-4 h-4 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/></svg>
                <span>WhatsApp</span>
              </a>
            <% } %>
          </p>
        </div>
      </div>
      
      <!-- Detalhes Rápidos -->
      <div class="grid grid-cols-3 gap-2 sm:gap-6 border-t border-slate-800 pt-4 md:pt-0 md:border-t-0 md:pl-8 md:border-l md:border-slate-800 text-center">
        <div>
          <span class="text-[10px] sm:text-xs uppercase font-bold text-slate-400 block tracking-wider">Último KM Registrado</span>
          <span class="text-base sm:text-xl md:text-2xl font-black text-white mt-0.5 sm:mt-1 block"><%= Number(veiculo.km_atual).toLocaleString('pt-BR') %> km</span>
        </div>
        <div>
          <span class="text-[10px] sm:text-xs uppercase font-bold text-slate-400 block tracking-wider">Ano</span>
          <span class="text-base sm:text-xl md:text-2xl font-black text-white mt-0.5 sm:mt-1 block"><%= veiculo.ano %></span>
        </div>
        <div>
          <span class="text-[10px] sm:text-xs uppercase font-bold text-slate-400 block tracking-wider">Cor</span>
          <span class="text-base sm:text-xl md:text-2xl font-black text-white mt-0.5 sm:mt-1 block capitalize"><%= veiculo.cor %></span>
        </div>
      </div>
    </div>

    <!-- Grid Layout de Prontuário -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Coluna Esquerda: Alertas de Peças e Histórico de Trocas (2/3) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Status de Alerta das Peças (RF-14) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div>
            <h2 class="text-xl md:text-2xl font-bold text-slate-900 flex items-center gap-2.5">
              <i data-lucide="shield-alert" class="w-6 h-6 text-brand-500"></i>
              <span>Alertas Ativos por Peça</span>
            </h2>
            <p class="text-sm text-slate-600 mt-1">Alertas automáticos de acordo com a KM ou data previstos na última troca de cada componente.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% if (alertasPecas.length === 0) { %>
              <div class="col-span-1 sm:col-span-2 p-8 border border-dashed border-slate-300 rounded-xl text-center text-slate-500">
                <i data-lucide="info" class="w-8 h-8 mx-auto mb-2 text-slate-400"></i>
                <p class="text-base font-medium">Nenhuma peça possui trocas registradas para emitir alertas.</p>
              </div>
            <% } else { %>
              <% alertasPecas.forEach(item => { %>
                <div class="p-5 rounded-2xl border flex flex-col justify-between space-y-3.5 <%= item.alerta.cor %> shadow-sm">
                  <div class="flex items-start justify-between">
                    <div>
                      <span class="font-bold text-base md:text-lg block leading-snug"><%= item.peca.nome %></span>
                      <span class="text-xs md:text-sm font-semibold opacity-90 mt-1 block">Marca: <%= item.peca.marca.nome %></span>
                    </div>
                    
                    <!-- Ícones com base no status -->
                    <% if (item.alerta.status === 'vencido') { %>
                      <span class="p-1.5 rounded-full bg-red-200 text-red-800 shrink-0"><i data-lucide="x" class="w-5 h-5"></i></span>
                    <% } else if (item.alerta.status === 'proximo') { %>
                      <span class="p-1.5 rounded-full bg-yellow-200 text-yellow-800 shrink-0"><i data-lucide="alert-triangle" class="w-5 h-5"></i></span>
                    <% } else { %>
                      <span class="p-1.5 rounded-full bg-green-200 text-green-800 shrink-0"><i data-lucide="check" class="w-5 h-5"></i></span>
                    <% } %>
                  </div>

                  <div class="text-sm space-y-1.5 opacity-95 border-t border-black/10 pt-2.5">
                    <div class="flex justify-between">
                      <span class="font-medium">Última troca:</span>
                      <span class="font-bold"><%= new Date(item.troca.data_troca).toLocaleDateString('pt-BR') %></span>
                    </div>
                    <% if (item.troca.km_previsto_proximo) { %>
                      <div class="flex justify-between">
                        <span class="font-medium">Previsão KM:</span>
                        <span class="font-bold"><%= Number(item.troca.km_previsto_proximo).toLocaleString('pt-BR') %> km</span>
                      </div>
                    <% } %>
                    <% if (item.troca.data_prevista_proximo) { %>
                      <div class="flex justify-between">
                        <span class="font-medium">Previsão Data:</span>
                        <span class="font-bold"><%= new Date(item.troca.data_prevista_proximo).toLocaleDateString('pt-BR') %></span>
                      </div>
                    <% } %>
                    <div class="text-xs font-black mt-2 uppercase tracking-wide">
                      Status: <%= item.alerta.mensagem %>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </section>

        <!-- Linha do Tempo de Manutenções (Trocas de Peças e Serviços Prestados) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 flex items-center gap-2.5">
                <i data-lucide="git-commit" class="w-6 h-6 text-brand-500"></i>
                <span>Linha do Tempo de Manutenções</span>
              </h2>
              <p class="text-sm text-slate-600 mt-1">Histórico completo de trocas de peças e serviços prestados no veículo.</p>
            </div>
          </div>

          <!-- Histórico de Serviços (Sem Peça) -->
          <% if (historicoServicos && historicoServicos.length > 0) { %>
            <div class="space-y-3.5">
              <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2 border-b border-slate-200 pb-2.5">
                <i data-lucide="wrench" class="w-5 h-5 text-emerald-500"></i>
                <span>Serviços Prestados (<%= historicoServicos.length %>)</span>
              </h3>
              <div class="space-y-3">
                <% historicoServicos.forEach(serv => { %>
                  <div class="bg-slate-50 rounded-xl p-5 border border-slate-200 shadow-sm space-y-2.5">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                      <h4 class="font-bold text-slate-900 text-base md:text-lg flex items-center gap-2">
                        <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0"></i>
                        <span><%= serv.servico.nome %></span>
                        <% if (serv.servico.categoria) { %>
                          <span class="text-xs font-semibold text-slate-600 bg-slate-200 px-2 py-0.5 rounded uppercase tracking-wider"><%= serv.servico.categoria %></span>
                        <% } %>
                      </h4>
                      <span class="text-xs sm:text-sm font-bold text-slate-700 bg-white border border-slate-300 px-3 py-1 rounded-lg self-start sm:self-auto shrink-0 shadow-sm">
                        <%= new Date(serv.data_servico).toLocaleDateString('pt-BR') %>
                      </span>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm text-slate-600 border-t border-slate-200 pt-3">
                      <div>
                        <span class="block text-xs uppercase font-bold text-slate-500 tracking-wider">KM no Serviço</span>
                        <span class="text-slate-900 font-bold mt-0.5 block text-base"><%= Number(serv.km_no_servico).toLocaleString('pt-BR') %> km</span>
                      </div>
                      <div>
                        <span class="block text-xs uppercase font-bold text-slate-500 tracking-wider">Próxima (KM)</span>
                        <span class="text-slate-900 font-bold mt-0.5 block text-base"><%= serv.km_previsto_proximo ? Number(serv.km_previsto_proximo).toLocaleString('pt-BR') + ' km' : 'N/I' %></span>
                      </div>
                      <div>
                        <span class="block text-xs uppercase font-bold text-slate-500 tracking-wider">Próxima (Data)</span>
                        <span class="text-slate-900 font-bold mt-0.5 block text-base">
                          <%= serv.data_prevista_proximo ? new Date(serv.data_prevista_proximo).toLocaleDateString('pt-BR') : 'N/I' %>
                        </span>
                      </div>
                      <div>
                        <span class="block text-xs uppercase font-bold text-slate-500 tracking-wider">Executado por</span>
                        <span class="text-slate-900 font-bold mt-0.5 block text-base truncate"><%= serv.executado_por %></span>
                      </div>
                    </div>

                    <% if (serv.observacoes) { %>
                      <div class="text-sm text-slate-600 bg-slate-100 p-3 rounded-lg italic">
                        "<%= serv.observacoes %>"
                      </div>
                    <% } %>

                    <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                      <div class="flex justify-end pt-2 border-t border-slate-200/60">
                        <form action="/registro-servico/<%= serv.id %>?_method=DELETE" method="POST" onsubmit="confirmarAcaoModal(event, 'Deseja remover este serviço do histórico do veículo?', 'Apagar Registro de Serviço?'); return false;" class="inline">
                          <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-bold flex items-center gap-1.5 transition-colors">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                            <span>Apagar Registro</span>
                          </button>
                        </form>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Trocas de Peças -->
          <div class="space-y-4 pt-2">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2 border-b border-slate-200 pb-2.5">
              <i data-lucide="package" class="w-5 h-5 text-brand-500"></i>
              <span>Trocas de Peças (<%= historicoTrocas.length %>)</span>
            </h3>

            <div class="relative pl-6 border-l-2 border-slate-300 space-y-6">
              <% if (historicoTrocas.length === 0) { %>
                <div class="text-center text-slate-500 py-8 pr-6 text-base font-medium">
                  <i data-lucide="wrench" class="w-10 h-10 mx-auto mb-2 text-slate-300"></i>
                  Nenhum registro de troca de peça encontrado para este veículo.
                </div>
              <% } else { %>
                <% historicoTrocas.forEach(troca => { %>
                  <div class="relative">
                    <div class="absolute -left-[33px] top-2 w-5 h-5 rounded-full border-2 border-white bg-brand-500 shadow-sm flex items-center justify-center">
                      <span class="w-2 h-2 rounded-full bg-white"></span>
                    </div>

                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200 shadow-sm space-y-3.5">
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <h4 class="font-bold text-slate-900 text-base md:text-lg flex items-center gap-2">
                          <i data-lucide="package" class="w-5 h-5 text-slate-600"></i>
                          <span><%= troca.peca.nome %></span>
                          <span class="text-sm font-semibold text-slate-500">(<%= troca.peca.marca.nome %>)</span>
                        </h4>
                        <span class="text-xs sm:text-sm font-bold text-slate-700 bg-white border border-slate-300 px-3 py-1 rounded-lg self-start sm:self-auto shrink-0 shadow-sm">
                          <%= new Date(troca.data_troca).toLocaleDateString('pt-BR') %>
                        </span>
                      </div>

                      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm text-slate-600 border-t border-slate-200 pt-3">
                        <div>
                          <span class="block text-xs uppercase font-bold text-slate-500 tracking-wider">KM na Troca</span>
                          <span class="text-slate-900 font-bold mt-0.5 block text-base"><%= Number(troca.km_na_troca).toLocaleString('pt-BR') %> km</span>
                        </div>
                        <div>
                          <span class="block text-xs uppercase font-bold text-slate-500 tracking-wider">Próxima (KM)</span>
                          <span class="text-slate-900 font-bold mt-0.5 block text-base"><%= troca.km_previsto_proximo ? Number(troca.km_previsto_proximo).toLocaleString('pt-BR') + ' km' : 'Não Definido' %></span>
                        </div>
                        <div>
                          <span class="block text-xs uppercase font-bold text-slate-500 tracking-wider">Próxima (Data)</span>
                          <span class="text-slate-900 font-bold mt-0.5 block text-base">
                            <%= troca.data_prevista_proximo ? new Date(troca.data_prevista_proximo).toLocaleDateString('pt-BR') : 'Não Definido' %>
                          </span>
                        </div>
                        <div>
                          <span class="block text-xs uppercase font-bold text-slate-500 tracking-wider">Executado por</span>
                          <span class="text-slate-900 font-bold mt-0.5 block text-base truncate" title="<%= troca.executado_por %>"><%= troca.executado_por %></span>
                        </div>
                      </div>

                      <% if (troca.oficina || troca.nome_oficina_manual) { %>
                        <div class="text-sm bg-white border border-slate-200 p-2.5 rounded-lg flex items-center gap-2 text-slate-700 font-medium">
                          <i data-lucide="home" class="w-4 h-4 text-slate-500 shrink-0"></i>
                          <span class="font-bold">Oficina:</span>
                          <span><%= troca.oficina ? troca.oficina.nome : troca.nome_oficina_manual %></span>
                        </div>
                      <% } %>

                      <% if (troca.observacoes) { %>
                        <div class="text-sm text-slate-600 bg-slate-100 p-3 rounded-lg italic">
                          "<%= troca.observacoes %>"
                        </div>
                      <% } %>

                      <% if (['admin', 'gerente', 'atendente'].includes(usuarioLogado.papel)) { %>
                        <div class="flex justify-end pt-2 border-t border-slate-200/60">
                          <form action="/troca/<%= troca.id %>?_method=DELETE" method="POST" onsubmit="confirmarAcaoModal(event, 'Tem certeza que deseja apagar esse registro de troca de peça?', 'Excluir Troca de Peça?'); return false;" class="inline">
                            <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-bold flex items-center gap-1.5 transition-colors">
                              <i data-lucide="trash-2" class="w-4 h-4"></i>
                              <span>Apagar Registro</span>
                            </button>
                          </form>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </section>

      </div>

      <!-- Coluna Direita: Registro Rápido e Agendamentos (1/3) -->
      <div class="space-y-8">
        
        <!-- Formulário Rápido: Registrar Serviço Realizado (Sem Peça) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div>
            <h2 class="text-lg md:text-xl font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="wrench" class="w-5 h-5 text-emerald-500"></i>
              <span>Registrar Serviço Realizado</span>
            </h2>
            <p class="text-sm text-slate-500 mt-1">Registre um serviço que não exigiu troca de peças.</p>
          </div>

          <form action="/registro-servico" method="POST" class="space-y-4">
            <input type="hidden" name="veiculo_id" value="<%= veiculo.id %>">
            
            <!-- Serviço -->
            <div>
              <label for="servico_id" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">Serviço Executado *</label>
              <select id="servico_id" name="servico_id" required
                      class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm md:text-base focus:outline-none focus:border-emerald-500 focus:bg-white transition-all font-medium">
                <option value="" disabled selected>Selecione o serviço...</option>
                <% servicos.forEach(s => { %>
                  <option value="<%= s.id %>"><%= s.nome %> <%= s.categoria ? '(' + s.categoria + ')' : '' %></option>
                <% }) %>
              </select>
            </div>

            <!-- KM no Serviço -->
            <div>
              <label for="km_no_servico" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">KM no Momento do Serviço *</label>
              <input type="number" id="km_no_servico" name="km_no_servico" required min="0" value="<%= veiculo.km_atual %>"
                     class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-emerald-500 focus:bg-white transition-all font-bold">
            </div>

            <!-- Data do Serviço -->
            <div>
              <label for="data_servico" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">Data do Serviço *</label>
              <input type="date" id="data_servico" name="data_servico" required value="<%= new Date().toISOString().split('T')[0] %>"
                     class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-emerald-500 focus:bg-white transition-all">
            </div>

            <!-- Executado Por -->
            <div>
              <label for="executado_por_servico" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">Quem executou? *</label>
              <input type="text" id="executado_por_servico" name="executado_por" required value="<%= usuarioLogado.nome %>"
                     class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-emerald-500 focus:bg-white transition-all">
            </div>

            <!-- Observações -->
            <div>
              <label for="observacoes_servico" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">Observações</label>
              <textarea id="observacoes_servico" name="observacoes" rows="2" placeholder="Detalhes técnicos do serviço..."
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm md:text-base focus:outline-none focus:border-emerald-500 focus:bg-white transition-all resize-none"></textarea>
            </div>

            <button type="submit" 
                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-5 rounded-xl shadow-md shadow-emerald-500/10 active:scale-[0.98] transition-all text-base flex items-center justify-center space-x-2">
              <span>Registrar Serviço</span>
              <i data-lucide="check-circle" class="w-5 h-5"></i>
            </button>

          </form>
        </section>
        
        <!-- Formulário Rápido de Registro de Troca (RF-11/RF-12/RF-13) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div>
            <h2 class="text-lg md:text-xl font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="plus-circle" class="w-5 h-5 text-brand-500"></i>
              <span>Registrar Troca de Peça</span>
            </h2>
            <p class="text-sm text-slate-500 mt-1">Insira um novo registro de troca para calcular alertas.</p>
          </div>

          <form action="/troca" method="POST" class="space-y-4">
            <input type="hidden" name="veiculo_id" value="<%= veiculo.id %>">
            
            <!-- Peça -->
            <div>
              <label for="peca_id" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">Peça Substituída *</label>
              <select id="peca_id" name="peca_id" required
                      class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm md:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
                <option value="" disabled selected>Selecione a peça...</option>
                <% pecas.forEach(p => { %>
                  <option value="<%= p.id %>"><%= p.nome %> (<%= p.marca.nome %>)</option>
                <% }) %>
              </select>
            </div>

            <!-- KM na Troca e Atualizar KM -->
            <div>
              <label for="km_na_troca" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">KM no Momento da Troca *</label>
              <input type="number" id="km_na_troca" name="km_na_troca" required min="0" value="<%= veiculo.km_atual %>"
                     class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-bold">
              <div class="flex items-center space-x-2.5 mt-2.5">
                <input type="checkbox" id="atualizar_km_veiculo" name="atualizar_km_veiculo" value="true" checked
                       class="w-5 h-5 text-brand-600 bg-white border-slate-300 rounded focus:ring-brand-500 cursor-pointer">
                <label for="atualizar_km_veiculo" class="text-sm font-semibold text-slate-700 cursor-pointer select-none">
                  Atualizar último KM registrado do veículo para este valor (RF-33)
                </label>
              </div>
            </div>

            <!-- Data da Troca -->
            <div>
              <label for="data_troca" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">Data da Troca *</label>
              <input type="date" id="data_troca" name="data_troca" required value="<%= new Date().toISOString().split('T')[0] %>"
                     class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <!-- Previsões (Próxima Troca) -->
            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-3.5">
              <span class="block text-xs uppercase font-bold text-slate-700 tracking-wider">Previsão Próxima Troca</span>
              
              <div>
                <label for="km_previsto_proximo" class="block text-sm font-bold text-slate-700 mb-1">KM Previsto (Opcional)</label>
                <input type="number" id="km_previsto_proximo" name="km_previsto_proximo" placeholder="Ex: <%= veiculo.km_atual + 10000 %>"
                       class="w-full bg-white border border-slate-300 text-slate-900 rounded-lg py-2 px-3 text-base focus:outline-none focus:border-brand-500 transition-all font-medium">
              </div>

              <div>
                <label for="data_prevista_proximo" class="block text-sm font-bold text-slate-700 mb-1">Data Prevista (Opcional)</label>
                <input type="date" id="data_prevista_proximo" name="data_prevista_proximo"
                       class="w-full bg-white border border-slate-300 text-slate-900 rounded-lg py-2 px-3 text-base focus:outline-none focus:border-brand-500 transition-all">
              </div>
            </div>

            <!-- Executado Por e Oficina -->
            <div>
              <label for="executado_por" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">Quem efetuou a troca? *</label>
              <input type="text" id="executado_por" name="executado_por" required value="<%= usuarioLogado.nome %>"
                     placeholder="Nome do mecânico"
                     class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div>
              <label for="oficina_id" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">Oficina Executante</label>
              <select id="oficina_id" name="oficina_id" onchange="toggleOficinaManual(this)"
                      class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm md:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all font-medium">
                <option value="">Outra Oficina (Preenchimento manual)...</option>
                <% oficinas.forEach(o => { %>
                  <option value="<%= o.id %>" <%= o.cnpj === '12345678000199' ? 'selected' : '' %>><%= o.nome %></option>
                <% }) %>
              </select>
            </div>

            <div id="campo_oficina_manual" class="hidden">
              <label for="nome_oficina_manual" class="block text-sm font-bold text-slate-700 mb-1">Nome da Oficina Externa</label>
              <input type="text" id="nome_oficina_manual" name="nome_oficina_manual" placeholder="Nome da oficina externa..."
                     class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-lg py-2 px-3 text-base focus:outline-none focus:border-brand-500 transition-all">
            </div>

            <!-- Observações -->
            <div>
              <label for="observacoes" class="block text-sm font-bold text-slate-800 uppercase tracking-wide mb-1.5">Observações / Detalhes</label>
              <textarea id="observacoes" name="observacoes" rows="2" placeholder="Informações adicionais da substituição..."
                        class="w-full bg-slate-50 border border-slate-300 text-slate-900 rounded-xl py-2.5 px-3.5 text-sm md:text-base focus:outline-none focus:border-brand-500 focus:bg-white transition-all resize-none"></textarea>
            </div>

            <button type="submit" 
                    class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-3 px-5 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-base flex items-center justify-center space-x-2">
              <span>Registrar Troca</span>
              <i data-lucide="plus" class="w-5 h-5"></i>
            </button>

          </form>
        </section>

        <!-- Agendamentos do Veículo -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
          <div class="flex items-center justify-between">
            <h2 class="text-lg md:text-xl font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="calendar" class="w-5 h-5 text-indigo-500"></i>
              <span>Agendamentos</span>
            </h2>
            <a href="/agendamentos/calendario-tela" class="text-sm text-brand-600 hover:text-brand-700 font-bold">Agendar</a>
          </div>

          <div class="divide-y divide-slate-100 max-h-[300px] overflow-y-auto pr-1">
            <% if (agendamentos.length === 0) { %>
              <div class="text-center text-slate-500 py-6 text-sm font-medium">
                Nenhum agendamento para este veículo.
              </div>
            <% } else { %>
              <% agendamentos.forEach(a => { %>
                <div class="py-3.5 flex justify-between items-center text-sm gap-3">
                  <div>
                    <span class="font-bold text-slate-900 block text-base"><%= a.motivo_revisao %></span>
                    <span class="text-slate-500 block mt-1 font-medium">
                      <%= new Date(a.data_agendada).toLocaleDateString('pt-BR') %> às <span class="font-bold text-slate-800"><%= a.horario_agendado %><%= a.horario_fim ? ' às ' + a.horario_fim : '' %></span>
                      <% if (a.duracao_minutos) { %>
                        <span class="text-xs text-brand-600 font-semibold ml-1">(<%= formatarDuracao(a.duracao_minutos) %>)</span>
                      <% } %>
                    </span>
                  </div>
                  <div class="shrink-0">
                    <% if (a.status === 'agendado') { %>
                      <span class="px-3 py-1 rounded-full bg-sky-100 text-sky-800 border border-sky-300 font-bold uppercase text-xs">Agendado</span>
                    <% } else if (a.status === 'concluido') { %>
                      <span class="px-3 py-1 rounded-full bg-green-100 text-green-800 border border-green-300 font-bold uppercase text-xs">Concluído</span>
                    <% } else { %>
                      <span class="px-3 py-1 rounded-full bg-red-100 text-red-800 border border-red-300 font-bold uppercase text-xs">Cancelado</span>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </section>

      </div>

    </div>

  </div>
</div>

<script>
  function toggleOficinaManual(select) {
    const campoManual = document.getElementById('campo_oficina_manual');
    if (select.value === "") {
      campoManual.classList.remove('hidden');
    } else {
      campoManual.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('oficina_id');
    if (select) toggleOficinaManual(select);
  });
</script>

<%- include('../parciais/rodape') %>
