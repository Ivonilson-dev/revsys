<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<!-- Conteúdo da Página -->
<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-7xl mx-auto space-y-8">
    
    <!-- Cabeçalho do Painel -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Painel da Oficina</h1>
        <p class="text-slate-500 mt-1">Visão geral do dia, agendamentos e status da frota de clientes.</p>
      </div>
      <div class="flex items-center space-x-3">
        <a href="/agendamentos/calendario-tela" class="inline-flex items-center space-x-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md shadow-brand-500/10 hover:shadow-brand-500/20 active:scale-[0.98] transition-all text-sm">
          <i data-lucide="calendar" class="w-4 h-4"></i>
          <span>Abrir Calendário</span>
        </a>
        <a href="/veiculos" class="inline-flex items-center space-x-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md hover:shadow-xl active:scale-[0.98] transition-all text-sm">
          <i data-lucide="search" class="w-4 h-4"></i>
          <span>Buscar Veículo</span>
        </a>
      </div>
    </div>

    <!-- Cards de Indicadores (Métricas) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Card: Agendamentos de Hoje -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-all flex items-center space-x-4">
        <div class="bg-sky-100 p-4 rounded-xl text-sky-600">
          <i data-lucide="clock" class="w-6 h-6"></i>
        </div>
        <div>
          <span class="text-slate-400 text-xs font-bold uppercase tracking-wider block">Agendados para Hoje</span>
          <span class="text-3xl font-extrabold text-slate-800 block mt-1"><%= agendamentosHoje.length %></span>
        </div>
      </div>

      <!-- Card: Manutenções Atrasadas -->
      <a href="/relatorios/vencidos" class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-all flex items-center space-x-4">
        <div class="bg-red-100 p-4 rounded-xl text-red-600">
          <i data-lucide="alert-triangle" class="w-6 h-6"></i>
        </div>
        <div>
          <span class="text-slate-400 text-xs font-bold uppercase tracking-wider block">Veículos Atrasados</span>
          <span class="text-3xl font-extrabold text-red-600 block mt-1"><%= totalVeiculosAtrasados %></span>
        </div>
      </a>

      <!-- Card: Trocas Realizadas no Mês -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-all flex items-center space-x-4">
        <div class="bg-emerald-100 p-4 rounded-xl text-emerald-600">
          <i data-lucide="wrench" class="w-6 h-6"></i>
        </div>
        <div>
          <span class="text-slate-400 text-xs font-bold uppercase tracking-wider block">Trocas Realizadas (Mês)</span>
          <span class="text-3xl font-extrabold text-slate-800 block mt-1"><%= totalTrocasMes %></span>
        </div>
      </div>

    </div>

    <!-- Layout Dividido em Duas Colunas -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Coluna Principal (2/3 de largura) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Agendamentos de Hoje -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="calendar-check" class="w-5 h-5 text-brand-500"></i>
              <span>Agenda de Hoje</span>
            </h2>
            <a href="/agendamentos" class="text-xs text-brand-500 hover:text-brand-600 font-semibold flex items-center gap-1">
              <span>Ver todos</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>

          <div class="divide-y divide-slate-100">
            <% if (agendamentosHoje.length === 0) { %>
              <div class="p-8 text-center text-slate-400">
                <i data-lucide="calendar" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                <p class="text-sm">Nenhum agendamento para hoje.</p>
              </div>
            <% } else { %>
              <% agendamentosHoje.forEach(agenda => { %>
                <div class="p-4 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/50 transition-colors">
                  <div class="flex items-start space-x-4">
                    <div class="bg-slate-100 px-3 py-2 rounded-xl text-center shrink-0 min-w-[70px]">
                      <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Horário</span>
                      <span class="text-lg font-extrabold text-slate-800"><%= agenda.horario_agendado %></span>
                    </div>
                    <div>
                      <span class="text-sm font-semibold text-slate-800 block"><%= agenda.cliente.usuario.nome %></span>
                      <span class="text-xs text-slate-500 block mt-0.5">
                        <%= agenda.veiculo.placa %> | <%= agenda.veiculo.modelo ? agenda.veiculo.modelo.marca.nome + ' ' + agenda.veiculo.modelo.nome : 'Modelo N/I' %>
                      </span>
                      <span class="text-xs italic text-slate-400 block mt-1">"<%= agenda.motivo_revisao %>"</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <% if (agenda.status === 'agendado') { %>
                      <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-sky-100 text-sky-800 border border-sky-200 uppercase">Agendado</span>
                    <% } else if (agenda.status === 'concluido') { %>
                      <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800 border border-green-200 uppercase">Concluído</span>
                    <% } %>
                    
                    <a href="/veiculos/<%= agenda.veiculo_id %>" class="p-2 hover:bg-slate-100 rounded-lg text-slate-600 transition-colors" title="Ver detalhes do veículo">
                      <i data-lucide="eye" class="w-5 h-5"></i>
                    </a>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </section>

        <!-- Veículos Atrasados (Histórico/Manutenção) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="alert-circle" class="w-5 h-5 text-red-500"></i>
              <span>Veículos com Manutenção Atrasada</span>
            </h2>
            <a href="/relatorios/vencidos" class="text-xs text-brand-500 hover:text-brand-600 font-semibold flex items-center gap-1">
              <span>Ver todos</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>

          <div class="divide-y divide-slate-100">
            <% if (veiculosAtrasados.length === 0) { %>
              <div class="p-8 text-center text-slate-400">
                <i data-lucide="shield-check" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                <p class="text-sm">Todos os veículos em dia!</p>
              </div>
            <% } else { %>
              <% veiculosAtrasados.forEach(veiculo => { %>
                <div class="p-4 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/50 transition-colors">
                  <div>
                    <div class="flex items-center space-x-2">
                      <span class="px-2.5 py-0.5 rounded-lg bg-slate-900 text-white font-mono font-bold text-xs uppercase border border-slate-700 tracking-wider shadow-sm">
                        <%= veiculo.placa %>
                      </span>
                      <span class="text-sm font-semibold text-slate-800">
                        <%= veiculo.modelo ? veiculo.modelo.marca.nome + ' ' + veiculo.modelo.nome : 'Modelo Não Informado' %>
                      </span>
                    </div>
                    <span class="text-xs text-slate-500 block mt-1.5">
                      Proprietário: <span class="font-medium text-slate-700"><%= veiculo.cliente.usuario.nome %></span> | KM atual: <span class="font-medium text-slate-700"><%= veiculo.km_atual %> km</span>
                    </span>
                  </div>
                  <div>
                    <a href="/veiculos/<%= veiculo.id %>" class="inline-flex items-center space-x-1.5 text-xs font-bold text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 py-2 px-3 rounded-lg border border-red-200 transition-colors">
                      <i data-lucide="wrench" class="w-3.5 h-3.5"></i>
                      <span>Resolver Manutenção</span>
                    </a>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </section>

      </div>

      <!-- Coluna Lateral (1/3 de largura) -->
      <div class="space-y-8">
        
        <!-- Notificações Recentes / Solicitações de Clientes -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="bell" class="w-5 h-5 text-amber-500"></i>
              <span>Solicitações / Notificações</span>
            </h2>
            <% if (notificacoes.length > 0) { %>
              <form action="/notificacoes/ler-todas" method="POST" class="inline">
                <button type="submit" class="text-[10px] text-slate-400 hover:text-slate-600 font-bold uppercase tracking-wider">Limpar</button>
              </form>
            <% } %>
          </div>

          <div class="divide-y divide-slate-100">
            <% if (notificacoes.length === 0) { %>
              <div class="p-8 text-center text-slate-400">
                <i data-lucide="bell-off" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                <p class="text-sm">Nenhuma notificação pendente.</p>
              </div>
            <% } else { %>
              <% notificacoes.forEach(notif => { %>
                <div class="p-4 hover:bg-slate-50/50 transition-colors relative flex flex-col justify-between">
                  <div class="pr-6">
                    <span class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-amber-100 text-amber-800">
                      <%= notif.tipo === 'solicitacao_cliente' ? 'Solicitação' : 'Alerta' %>
                    </span>
                    <p class="text-xs text-slate-700 mt-2 leading-relaxed"><%= notif.mensagem %></p>
                    <span class="text-[10px] text-slate-400 block mt-1"><%= new Date(notif.criado_em).toLocaleString('pt-BR') %></span>
                  </div>
                  
                  <!-- Formulário para marcar como lida -->
                  <form action="/notificacoes/<%= notif.id %>/lida" method="POST" class="absolute top-4 right-4">
                    <button type="submit" class="p-1 hover:bg-slate-200 text-slate-400 hover:text-slate-600 rounded" title="Marcar como lida">
                      <i data-lucide="check" class="w-4 h-4"></i>
                    </button>
                  </form>
                </div>
              <% }) %>
            <% } %>
          </div>
        </section>

        <!-- Próximas Trocas (7 dias) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-100">
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="calendar-days" class="w-5 h-5 text-indigo-500"></i>
              <span>Vencendo em Breve</span>
            </h2>
            <span class="text-xs text-slate-400 mt-0.5 block">Previsões para os próximos 7 dias por tempo.</span>
          </div>

          <div class="divide-y divide-slate-100">
            <% if (proximasTrocas7Dias.length === 0) { %>
              <div class="p-8 text-center text-slate-400">
                <i data-lucide="calendar" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                <p class="text-sm">Nenhuma troca agendada para os próximos 7 dias.</p>
              </div>
            <% } else { %>
              <% proximasTrocas7Dias.forEach(item => { %>
                <div class="p-4 hover:bg-slate-50/50 transition-colors">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-800 block"><%= item.peca.nome %></span>
                    <span class="text-[10px] font-semibold text-indigo-600 bg-indigo-50 border border-indigo-100 px-2 py-0.5 rounded-lg">
                      <%= new Date(item.data_prevista).toLocaleDateString('pt-BR') %>
                    </span>
                  </div>
                  <span class="text-xs text-slate-500 block mt-1">
                    Veículo: <span class="font-medium text-slate-700"><%= item.veiculo.placa %></span> (<%= item.veiculo.modelo ? item.veiculo.modelo.nome : 'N/I' %>)
                  </span>
                </div>
              <% }) %>
            <% } %>
          </div>
        </section>

      </div>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
