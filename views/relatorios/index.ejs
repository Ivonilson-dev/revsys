<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 md:p-8">
  <div class="max-w-6xl mx-auto space-y-8">
    
    <!-- Cabeçalho -->
    <div>
      <h1 class="text-3xl font-bold text-slate-900 tracking-tight font-sans">Relatórios e Consultas</h1>
      <p class="text-slate-500 mt-1">Gere relatórios de revisões, trocas realizadas, status de frotas e agenda de atendimento.</p>
    </div>

    <!-- Layout em Cards de Categorias -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Bloco 1: Relatórios Rápidos de Manutenção -->
      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="alert-circle" class="w-5 h-5 text-red-500"></i>
          <span>Alertas de Manutenção</span>
        </h2>
        <p class="text-xs text-slate-400">Consulte de forma agrupada as peças que já venceram o prazo de uso ou estão vencendo nos próximos dias.</p>
        
        <div class="space-y-2 pt-2">
          <!-- Vencidos -->
          <a href="/relatorios/vencidos" class="flex items-center justify-between p-3.5 rounded-xl border border-red-100 bg-red-50/30 hover:bg-red-50 text-slate-700 hover:text-slate-950 transition-colors">
            <span class="text-xs font-semibold flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-500"></span>
              Manutenções Vencidas Atualmente
            </span>
            <i data-lucide="chevron-right" class="w-4 h-4 text-red-400"></i>
          </a>

          <!-- Próximos 7 Dias -->
          <a href="/relatorios/proximos" class="flex items-center justify-between p-3.5 rounded-xl border border-yellow-100 bg-yellow-50/30 hover:bg-yellow-50 text-slate-700 hover:text-slate-950 transition-colors">
            <span class="text-xs font-semibold flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
              Próximas Trocas (7 dias / Iminente)
            </span>
            <i data-lucide="chevron-right" class="w-4 h-4 text-yellow-400"></i>
          </a>
        </div>
      </section>

      <!-- Bloco 2: Relatórios de Atendimento (Agenda) -->
      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="calendar" class="w-5 h-5 text-indigo-500"></i>
          <span>Agenda e Ocupação</span>
        </h2>
        <p class="text-xs text-slate-400">Visualize as listas consolidadas de agendamentos diários ou mensais da oficina.</p>
        
        <div class="space-y-2 pt-2">
          <!-- Hoje -->
          <a href="/relatorios/agendamentos?tipo=dia" class="flex items-center justify-between p-3.5 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-slate-100 text-slate-700 hover:text-slate-950 transition-colors">
            <span class="text-xs font-semibold flex items-center gap-2">
              <i data-lucide="clock" class="w-4 h-4 text-brand-500"></i>
              Agendamentos de Hoje
            </span>
            <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
          </a>

          <!-- Mês -->
          <a href="/relatorios/agendamentos?tipo=mes" class="flex items-center justify-between p-3.5 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-slate-100 text-slate-700 hover:text-slate-950 transition-colors">
            <span class="text-xs font-semibold flex items-center gap-2">
              <i data-lucide="calendar-range" class="w-4 h-4 text-brand-500"></i>
              Agendamentos Deste Mês
            </span>
            <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
          </a>
        </div>
      </section>

      <!-- Bloco 3: Histórico Filtrado por Peça (RF-24) -->
      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="package" class="w-5 h-5 text-brand-500"></i>
          <span>Histórico de Substituição por Peça</span>
        </h2>
        <p class="text-xs text-slate-400">Gere a listagem de todos os veículos que realizaram a substituição de uma peça específica.</p>
        
        <form action="/relatorios/peca" method="GET" class="flex gap-2 pt-2">
          <select name="peca_id" required
                  class="flex-1 bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 transition-all">
            <option value="" disabled selected>Escolha a peça...</option>
            <% pecas.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.nome %> (<%= p.marca ? p.marca.nome : '' %>)</option>
            <% }) %>
          </select>
          <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2 px-4 rounded-xl text-xs transition-all flex items-center gap-1.5 shrink-0">
            <i data-lucide="file-search" class="w-4 h-4"></i>
            <span>Gerar</span>
          </button>
        </form>
      </section>

      <!-- Bloco 4: Prontuário Consolidado por Cliente (RF-25) -->
      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="users" class="w-5 h-5 text-brand-500"></i>
          <span>Relatório Consolidado de Cliente</span>
        </h2>
        <p class="text-xs text-slate-400">Exiba a ficha consolidada de todos os veículos e status de manutenção de um cliente selecionado.</p>
        
        <form action="/relatorios/cliente" method="GET" class="flex gap-2 pt-2">
          <select name="cliente_id" required
                  class="flex-1 bg-slate-50 border border-slate-200 text-slate-800 rounded-xl py-2 px-3 text-xs focus:outline-none focus:border-brand-500 transition-all">
            <option value="" disabled selected>Escolha o cliente...</option>
            <% clientes.forEach(cli => { %>
              <option value="<%= cli.id %>"><%= cli.usuario.nome %> (CPF: <%= cli.cpf %>)</option>
            <% }) %>
          </select>
          <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2 px-4 rounded-xl text-xs transition-all flex items-center gap-1.5 shrink-0">
            <i data-lucide="file-search" class="w-4 h-4"></i>
            <span>Gerar</span>
          </button>
        </form>
      </section>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
