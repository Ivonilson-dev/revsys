<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Link Voltar -->
    <a href="/relatorios" class="inline-flex items-center space-x-2 text-slate-600 hover:text-slate-900 transition-colors text-base font-semibold">
      <i data-lucide="arrow-left" class="w-5 h-5"></i>
      <span>Voltar para Relatórios</span>
    </a>

    <!-- Cabeçalho do Relatório -->
    <% 
      let telRelatorio = cliente.telefone_whatsapp ? String(cliente.telefone_whatsapp).replace(/\D/g, '') : '';
      if (telRelatorio.length === 10 || telRelatorio.length === 11) {
        telRelatorio = '55' + telRelatorio;
      }
      const msgWhatsRelatorio = `Olá ${cliente.usuario.nome}, tudo bem? Estamos acompanhando o histórico e manutenções do seu veículo na oficina.`;
    %>
    <div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 md:p-8 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-xs md:text-sm font-bold text-brand-600 uppercase tracking-widest block font-mono">Relatório por Cliente</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1"><%= cliente.usuario.nome %></h1>
        <p class="text-sm sm:text-base text-slate-600 mt-2 flex flex-wrap items-center gap-y-1">
          <span>E-mail: <span class="text-slate-900 font-semibold"><%= cliente.usuario.email %></span></span>
          <span class="mx-2 text-slate-300 hidden sm:inline">|</span>
          <span class="inline-flex items-center gap-2">
            <span>Tel/WhatsApp: <span class="text-slate-900 font-semibold"><%= cliente.telefone_whatsapp ? formatarTelefone(cliente.telefone_whatsapp) : 'Não informado' %></span></span>
            <% if (telRelatorio) { %>
              <a href="https://wa.me/<%= telRelatorio %>?text=<%= encodeURIComponent(msgWhatsRelatorio) %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg bg-[#25D366] hover:bg-[#128C7E] text-white text-xs font-bold transition-all shadow-sm shrink-0" title="Chamar no WhatsApp">
                <svg class="w-4 h-4 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/></svg>
                <span>WhatsApp</span>
              </a>
            <% } %>
          </span>
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-2.5 w-full sm:w-auto">
        <% if (telRelatorio) { %>
          <a href="https://wa.me/<%= telRelatorio %>?text=<%= encodeURIComponent(msgWhatsRelatorio) %>" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-2.5 px-4 rounded-xl text-sm sm:text-base transition-all shadow-sm">
            <svg class="w-5 h-5 fill-current shrink-0" width="20" height="20" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/></svg>
            <span>Conversar no WhatsApp</span>
          </a>
        <% } %>
        <a href="/clientes/<%= cliente.id %>" class="w-full sm:w-auto inline-flex items-center justify-center bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-5 rounded-xl text-base transition-colors shadow-sm text-center">
          Ficha do Cliente
        </a>
      </div>
    </div>

    <!-- Lista de Veículos e Status -->
    <div class="space-y-6">
      <% if (veiculosComStatus.length === 0) { %>
        <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center text-slate-500 font-medium text-base shadow-sm">
          Nenhum veículo registrado para este cliente.
        </div>
      <% } else { %>
        <% veiculosComStatus.forEach(item => { %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <!-- Barra do Veículo -->
            <div class="p-4 sm:p-6 border-b border-slate-100 bg-slate-50/70 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex flex-col xs:flex-row xs:items-center gap-3.5 sm:space-x-4">
                <span class="<%= obterClassePlaca(item.veiculo.placa) %> px-3 py-1.5 text-sm sm:text-base self-start xs:self-auto">
                  <%= formatarPlaca(item.veiculo.placa) %>
                </span>
                <div>
                  <h3 class="text-base sm:text-lg md:text-xl font-bold text-slate-900">
                    <%= item.veiculo.modelo ? item.veiculo.modelo.marca.nome + ' ' + item.veiculo.modelo.nome : 'Modelo N/I' %>
                  </h3>
                  <span class="text-xs sm:text-sm md:text-base text-slate-600 mt-0.5 block">
                    Último KM Registrado: <span class="font-bold text-slate-900"><%= item.veiculo.km_atual %> km</span> | 
                    Ano: <span class="font-bold text-slate-900"><%= item.veiculo.ano %></span>
                  </span>
                </div>
              </div>
              <div>
                <% if (item.statusGeral === 'vencido') { %>
                  <span class="px-3.5 py-1.5 rounded-full text-xs md:text-sm font-bold bg-red-100 text-red-800 border border-red-200 uppercase tracking-wide inline-block">Possui Alerta Vencido</span>
                <% } else if (item.statusGeral === 'proximo') { %>
                  <span class="px-3.5 py-1.5 rounded-full text-xs md:text-sm font-bold bg-yellow-100 text-yellow-800 border border-yellow-200 uppercase tracking-wide inline-block">Possui Alerta Próximo</span>
                <% } else { %>
                  <span class="px-3.5 py-1.5 rounded-full text-xs md:text-sm font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 uppercase tracking-wide inline-block">Tudo em Dia</span>
                <% } %>
              </div>
            </div>

            <!-- Tabela de Alertas de Peças do Veículo (Desktop) -->
            <div class="hidden md:block p-6 overflow-x-auto">
              <% if (item.alertas.length === 0) { %>
                <div class="text-center text-slate-500 py-6 text-base">
                  Sem trocas de peças registradas para este veículo.
                </div>
              <% } else { %>
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="text-slate-700 text-sm font-bold uppercase tracking-wider border-b border-slate-200">
                      <th class="pb-3 pr-4">Componente / Peça</th>
                      <th class="pb-3 pr-4">Data Última Troca</th>
                      <th class="pb-3 pr-4">Previsão (KM / Tempo)</th>
                      <th class="pb-3 pr-4">Alerta</th>
                      <th class="pb-3 text-right">Ação</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 text-slate-800 text-base">
                    <% item.alertas.forEach(al => { %>
                      <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="py-3.5 pr-4 font-bold text-slate-900"><%= al.peca.nome %></td>
                        <td class="py-3.5 pr-4 text-slate-700"><%= new Date(al.troca.data_troca).toLocaleDateString('pt-BR') %></td>
                        <td class="py-3.5 pr-4 text-slate-700 font-medium">
                          <%= al.troca.km_previsto_proximo ? al.troca.km_previsto_proximo + ' km' : 'Sem previsão por KM' %> / 
                          <%= al.troca.data_prevista_proximo ? new Date(al.troca.data_prevista_proximo).toLocaleDateString('pt-BR') : 'Sem data' %>
                        </td>
                        <td class="py-3.5 pr-4">
                          <span class="px-2.5 py-1 rounded-full font-bold uppercase text-xs inline-block <%= al.alerta.cor %>">
                            <%= al.alerta.mensagem %>
                          </span>
                        </td>
                        <td class="py-3.5 text-right">
                          <a href="/veiculos/<%= item.veiculo.id %>" class="text-brand-600 hover:text-brand-700 font-bold text-base inline-flex items-center gap-1 hover:underline">
                            Resolver
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              <% } %>
            </div>

            <!-- Cards de Alertas de Peças do Veículo (Mobile) -->
            <div class="block md:hidden divide-y divide-slate-100">
              <% if (item.alertas.length === 0) { %>
                <div class="p-6 text-center text-slate-500 text-sm font-medium">
                  Sem trocas de peças registradas para este veículo.
                </div>
              <% } else { %>
                <% item.alertas.forEach(al => { %>
                  <div class="p-4 space-y-3 hover:bg-slate-50/70 transition-colors">
                    <div class="flex items-start justify-between gap-2">
                      <span class="font-bold text-slate-900 text-base leading-snug"><%= al.peca.nome %></span>
                      <span class="px-2.5 py-0.5 rounded-full font-bold uppercase text-[11px] shrink-0 <%= al.alerta.cor %>">
                        <%= al.alerta.mensagem %>
                      </span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs text-slate-600">
                      <div>
                        <span class="block text-slate-500 font-bold uppercase tracking-wider text-[10px]">Última Troca</span>
                        <span class="text-slate-800 font-semibold"><%= new Date(al.troca.data_troca).toLocaleDateString('pt-BR') %></span>
                      </div>
                      <div>
                        <span class="block text-slate-500 font-bold uppercase tracking-wider text-[10px]">Próxima Prevista</span>
                        <span class="text-slate-800 font-semibold">
                          <%= al.troca.km_previsto_proximo ? al.troca.km_previsto_proximo + ' km' : (al.troca.data_prevista_proximo ? new Date(al.troca.data_prevista_proximo).toLocaleDateString('pt-BR') : 'N/I') %>
                        </span>
                      </div>
                    </div>

                    <div class="pt-2 border-t border-slate-100 flex justify-end">
                      <a href="/veiculos/<%= item.veiculo.id %>" class="text-brand-600 hover:text-brand-700 font-bold text-sm inline-flex items-center gap-1">
                        <span>Resolver Alerta</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                      </a>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>

          </div>
        <% }) %>
      <% } %>
    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
