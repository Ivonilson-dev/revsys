<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Link Voltar -->
    <a href="/relatorios" class="inline-flex items-center space-x-2 text-slate-600 hover:text-slate-900 transition-colors text-base font-semibold">
      <i data-lucide="arrow-left" class="w-5 h-5"></i>
      <span>Voltar para Relatórios</span>
    </a>

    <!-- Cabeçalho do Relatório -->
    <div>
      <span class="text-xs md:text-sm font-bold text-brand-600 uppercase tracking-widest block font-mono">Relatório por Peça</span>
      <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mt-1"><%= peca.nome %> (<%= peca.marca.nome %>)</h1>
      <p class="text-base text-slate-600 mt-2">Exibindo histórico de substituições desta peça em todos os veículos.</p>
    </div>

    <!-- Tabela / Cards -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      
      <!-- Visualização Desktop (Tabela) -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-700 text-xs md:text-sm font-bold uppercase tracking-wider">
              <th class="p-4 pl-6">Data Troca</th>
              <th class="p-4">Veículo (Placa)</th>
              <th class="p-4">Proprietário</th>
              <th class="p-4">KM na Troca</th>
              <th class="p-4">Executado por</th>
              <th class="p-4 pr-6 text-right">Prontuário</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-800 text-base">
            <% if (trocas.length === 0) { %>
              <tr>
                <td colspan="6" class="p-8 text-center text-slate-500 font-medium">
                  Nenhuma troca registrada para esta peça.
                </td>
              </tr>
            <% } else { %>
              <% trocas.forEach(t => { %>
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="p-4 pl-6 font-semibold text-slate-900"><%= new Date(t.data_troca).toLocaleDateString('pt-BR') %></td>
                  <td class="p-4">
                    <span class="<%= t.veiculo ? obterClassePlaca(t.veiculo.placa) : 'placa-mercosul' %> px-2.5 py-1 text-sm">
                      <%= t.veiculo ? formatarPlaca(t.veiculo.placa) : 'N/I' %>
                    </span>
                  </td>
                  <td class="p-4 font-medium text-slate-800">
                    <%= t.veiculo && t.veiculo.cliente ? t.veiculo.cliente.usuario.nome : 'N/I' %>
                  </td>
                  <td class="p-4 font-semibold text-slate-900"><%= t.km_na_troca %> km</td>
                  <td class="p-4 text-slate-600 font-medium"><%= t.executado_por %></td>
                  <td class="p-4 pr-6 text-right">
                    <a href="/veiculos/<%= t.veiculo_id %>" class="text-brand-600 hover:text-brand-700 font-bold text-base inline-flex items-center justify-end gap-1.5 hover:underline">
                      <span>Prontuário</span>
                      <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Visualização Mobile (Cards) -->
      <div class="block md:hidden divide-y divide-slate-100">
        <% if (trocas.length === 0) { %>
          <div class="p-8 text-center text-slate-500 font-medium">
            Nenhuma troca registrada para esta peça.
          </div>
        <% } else { %>
          <% trocas.forEach(t => { %>
            <div class="p-5 space-y-3 hover:bg-slate-50/50 transition-colors">
              <div class="flex items-center justify-between">
                <span class="font-bold text-base text-slate-900"><%= new Date(t.data_troca).toLocaleDateString('pt-BR') %></span>
                <span class="<%= t.veiculo ? obterClassePlaca(t.veiculo.placa) : 'placa-mercosul' %> px-2.5 py-1 text-xs sm:text-sm">
                  <%= t.veiculo ? formatarPlaca(t.veiculo.placa) : 'N/I' %>
                </span>
              </div>
              
              <div class="grid grid-cols-2 gap-3 text-sm text-slate-600">
                <div>
                  <span class="block text-slate-700 font-bold uppercase tracking-wider text-xs">KM na Troca</span>
                  <span class="text-slate-900 font-semibold text-base"><%= t.km_na_troca %> km</span>
                </div>
                <div>
                  <span class="block text-slate-700 font-bold uppercase tracking-wider text-xs">Mecânico</span>
                  <span class="text-slate-900 font-medium text-base truncate block"><%= t.executado_por %></span>
                </div>
                <div class="col-span-2">
                  <span class="block text-slate-700 font-bold uppercase tracking-wider text-xs">Cliente</span>
                  <span class="text-slate-900 font-semibold text-base"><%= t.veiculo && t.veiculo.cliente ? t.veiculo.cliente.usuario.nome : 'N/I' %></span>
                </div>
              </div>

              <div class="pt-3 border-t border-slate-100 flex justify-end">
                <a href="/veiculos/<%= t.veiculo_id %>" class="text-brand-600 hover:text-brand-700 text-base font-bold inline-flex items-center gap-1">
                  Ver Prontuário do Veículo
                  <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
