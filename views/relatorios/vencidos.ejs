<%- include('../parciais/cabecalho') %>
<%- include('../parciais/menu') %>

<div class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-6 md:p-8 pb-24 md:pb-8 smooth-scroll">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Link Voltar -->
    <a href="/relatorios" class="inline-flex items-center space-x-1.5 text-slate-600 hover:text-slate-900 transition-colors text-base font-semibold">
      <i data-lucide="arrow-left" class="w-5 h-5"></i>
      <span>Voltar para Relatórios</span>
    </a>

    <!-- Cabeçalho -->
    <div>
      <span class="text-xs font-bold text-red-600 uppercase tracking-widest block font-mono">Relatório Crítico</span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mt-1">Manutenções Vencidas</h1>
      <p class="text-slate-600 text-base md:text-lg mt-1 font-normal">Veículos com peças que ultrapassaram o limite de Kilometragem ou data limite de tempo (Vermelho).</p>
    </div>

    <!-- Tabela / Cards -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-100/80 border-b border-slate-200 text-slate-700 text-sm font-bold uppercase tracking-wider">
              <th class="p-4 pl-6">Veículo</th>
              <th class="p-4">Proprietário</th>
              <th class="p-4">Peça Substituída</th>
              <th class="p-4">Último KM / Previsto</th>
              <th class="p-4">Data Prevista</th>
              <th class="p-4">Alerta</th>
              <th class="p-4 pr-6 text-right">Ação</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-800 text-base">
            <% if (itensVencidos.length === 0) { %>
              <tr>
                <td colspan="7" class="p-10 text-center text-slate-500 text-base font-medium">
                  Nenhum veículo com manutenções vencidas! Excelente.
                </td>
              </tr>
            <% } else { %>
              <% itensVencidos.forEach(item => { %>
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="p-4 pl-6">
                    <div class="flex items-center space-x-2.5">
                      <span class="<%= obterClassePlaca(item.veiculo.placa) %> px-2.5 py-1 text-sm">
                        <%= formatarPlaca(item.veiculo.placa) %>
                      </span>
                      <span class="text-slate-900 font-bold block text-sm truncate max-w-[130px]">
                        <%= item.veiculo.modelo ? item.veiculo.modelo.nome : 'N/I' %>
                      </span>
                    </div>
                  </td>
                  <td class="p-4 text-slate-800 font-medium"><%= item.veiculo.cliente.usuario.nome %></td>
                  <td class="p-4 font-bold text-slate-900"><%= item.peca.nome %></td>
                  <td class="p-4 font-mono font-bold text-sm">
                    <span class="text-slate-900"><%= Number(item.veiculo.km_atual).toLocaleString('pt-BR') %></span> / 
                    <span class="text-red-600"><%= item.troca.km_previsto_proximo ? Number(item.troca.km_previsto_proximo).toLocaleString('pt-BR') : 'Sem Limite' %></span>
                  </td>
                  <td class="p-4 text-sm font-medium">
                    <%= item.troca.data_prevista_proximo ? new Date(item.troca.data_prevista_proximo).toLocaleDateString('pt-BR') : 'Sem data' %>
                  </td>
                  <td class="p-4">
                    <span class="px-3 py-1 rounded-full font-bold uppercase text-xs <%= item.alerta.cor %>">
                      <%= item.alerta.mensagem %>
                    </span>
                  </td>
                  <td class="p-4 pr-6 text-right space-x-2 whitespace-nowrap">
                    <% if (item.whatsapp_url) { %>
                      <a href="<%= item.whatsapp_url %>" target="_blank" rel="noopener noreferrer" 
                         class="inline-flex items-center gap-1.5 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-1.5 px-3 rounded-xl shadow-sm text-xs transition-all active:scale-[0.98]"
                         title="Contatar cliente no WhatsApp para agendar manutenção">
                        <svg class="w-3.5 h-3.5 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/></svg>
                        <span>WhatsApp</span>
                      </a>
                    <% } %>
                    <a href="/agendamentos/calendario-tela?cliente_id=<%= item.veiculo.cliente_id %>&veiculo_id=<%= item.veiculo.id %>" 
                       class="inline-flex items-center gap-1 bg-brand-50 hover:bg-brand-100 text-brand-700 font-bold py-1.5 px-3 rounded-xl border border-brand-200 text-xs transition-colors"
                       title="Agendar horário para este veículo">
                      <i data-lucide="calendar-plus" class="w-3.5 h-3.5 text-brand-600"></i>
                      <span>Agendar</span>
                    </a>
                    <a href="/veiculos/<%= item.veiculo.id %>" class="text-slate-600 hover:text-slate-900 font-bold text-xs inline-flex items-center gap-1 transition-colors p-1.5 rounded-lg border border-slate-200">
                      <span>Ficha</span>
                      <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Cards Mobile -->
      <div class="block md:hidden divide-y divide-slate-100">
        <% if (itensVencidos.length === 0) { %>
          <div class="p-10 text-center text-slate-500 text-base font-medium">
            Nenhum veículo com manutenções vencidas.
          </div>
        <% } else { %>
          <% itensVencidos.forEach(item => { %>
            <div class="p-5 space-y-3.5 hover:bg-slate-50/70 transition-colors">
              <div class="flex items-center justify-between">
                <span class="<%= obterClassePlaca(item.veiculo.placa) %> px-2.5 py-1 text-xs sm:text-sm">
                  <%= formatarPlaca(item.veiculo.placa) %>
                </span>
                <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-red-100 text-red-800 border border-red-300"><%= item.alerta.mensagem %></span>
              </div>
              
              <div class="grid grid-cols-2 gap-3 text-sm text-slate-600">
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">Peça Vencida</span>
                  <span class="text-slate-900 font-bold block"><%= item.peca.nome %></span>
                </div>
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">Cliente</span>
                  <span class="text-slate-800 font-medium truncate block"><%= item.veiculo.cliente.usuario.nome %></span>
                </div>
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">Último KM / Limite</span>
                  <span class="text-slate-900 font-bold"><%= Number(item.veiculo.km_atual).toLocaleString('pt-BR') %> / <%= item.troca.km_previsto_proximo ? Number(item.troca.km_previsto_proximo).toLocaleString('pt-BR') : 'S/L' %></span>
                </div>
                <div>
                  <span class="block text-slate-500 font-bold uppercase tracking-wider text-xs">Data Limite</span>
                  <span class="text-slate-800 font-medium"><%= item.troca.data_prevista_proximo ? new Date(item.troca.data_prevista_proximo).toLocaleDateString('pt-BR') : 'Sem data' %></span>
                </div>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2 flex-wrap">
                <% if (item.whatsapp_url) { %>
                  <a href="<%= item.whatsapp_url %>" target="_blank" rel="noopener noreferrer" 
                     class="inline-flex items-center gap-1.5 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-1.5 px-3 rounded-xl shadow-sm text-xs transition-all active:scale-[0.98]">
                    <svg class="w-3.5 h-3.5 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436.002 9.858-4.419 9.86-9.86 0-2.636-1.027-5.115-2.89-6.981-1.864-1.865-4.347-2.89-6.985-2.891-5.439 0-9.861 4.417-9.865 9.86-.001 1.745.454 3.447 1.32 4.965l-.995 3.637 3.73-.976zm9.953-6.85c-.29-.145-1.713-.846-1.979-.942-.266-.097-.459-.145-.653.146-.193.29-.749.942-.919 1.135-.169.193-.339.217-.629.072-.29-.144-1.226-.452-2.335-1.441-.864-.771-1.447-1.724-1.616-2.014-.169-.29-.018-.447.127-.591.131-.13.29-.339.435-.508.145-.169.193-.29.29-.483.097-.193.048-.363-.024-.508-.072-.145-.653-1.573-.895-2.153-.235-.568-.475-.49-.653-.5-.169-.008-.363-.009-.556-.009-.193 0-.508.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.183 2.995.145.193 2.043 3.12 4.949 4.373.692.298 1.232.476 1.652.61.697.221 1.33.19 1.83.115.557-.083 1.713-.699 1.954-1.376.241-.676.241-1.256.169-1.376-.073-.12-.266-.193-.556-.339z"/></svg>
                    <span>WhatsApp</span>
                  </a>
                <% } %>
                <a href="/agendamentos/calendario-tela?cliente_id=<%= item.veiculo.cliente_id %>&veiculo_id=<%= item.veiculo.id %>" 
                   class="inline-flex items-center gap-1 bg-brand-50 hover:bg-brand-100 text-brand-700 font-bold py-1.5 px-3 rounded-xl border border-brand-200 text-xs transition-colors">
                  <i data-lucide="calendar-plus" class="w-3.5 h-3.5 text-brand-600"></i>
                  <span>Agendar</span>
                </a>
                <a href="/veiculos/<%= item.veiculo.id %>" class="text-slate-600 hover:text-slate-900 font-bold text-xs inline-flex items-center gap-1 transition-colors p-1.5 rounded-lg border border-slate-200">
                  <span>Ficha</span>
                  <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </a>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

    </div>

  </div>
</div>

<%- include('../parciais/rodape') %>
