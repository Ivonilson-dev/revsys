<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-950">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <title>Login - RevSys</title>
  
  <!-- Fontes do Google -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <!-- Tailwind CSS Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Outfit', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Outfit', sans-serif;
      -webkit-tap-highlight-color: transparent;
      -webkit-font-smoothing: antialiased;
    }
    .glass-effect {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
  </style>
</head>
<body class="min-h-full flex items-center justify-center p-4 sm:p-6 relative overflow-y-auto bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-black">

  <!-- Detalhes de luz de fundo decorativa -->
  <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-sky-500/10 blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-500/10 blur-[120px] pointer-events-none"></div>

  <!-- Card de Login -->
  <div class="w-full max-w-md glass-effect rounded-3xl p-6 sm:p-8 shadow-2xl z-10 transition-all duration-300 my-auto">
    <div class="text-center mb-6 sm:mb-8">
      <div class="inline-flex bg-sky-500/15 p-3.5 rounded-2xl text-sky-400 mb-3 sm:mb-4 border border-sky-500/25 shadow-lg shadow-sky-500/10">
        <i data-lucide="wrench" class="w-8 h-8"></i>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-white">RevSys</h1>
      <p class="text-slate-400 mt-1.5 text-sm sm:text-base font-normal">Gestão de Troca de Peças e Manutenção</p>
    </div>

    <!-- Alertas -->
    <% if (erro) { %>
      <div class="mb-6 p-4 rounded-xl bg-red-500/15 border border-red-500/30 text-red-200 text-sm sm:text-base flex items-start space-x-2">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5 text-red-400"></i>
        <span><%= erro %></span>
      </div>
    <% } %>

    <% if (mensagem) { %>
      <div class="mb-6 p-4 rounded-xl bg-green-500/15 border border-green-500/30 text-green-200 text-sm sm:text-base flex items-start space-x-2">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0 mt-0.5 text-green-400"></i>
        <span><%= mensagem %></span>
      </div>
    <% } %>

    <!-- Formulário -->
    <form action="/login" method="POST" class="space-y-5 sm:space-y-6">
      <div>
        <label for="email" class="block text-xs sm:text-sm font-bold text-slate-300 uppercase tracking-wider mb-2">E-mail</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
            <i data-lucide="mail" class="w-5 h-5"></i>
          </div>
          <input type="email" id="email" name="email" required 
                 placeholder="seuemail@exemplo.com"
                 class="w-full bg-slate-900/90 border border-slate-750 text-white rounded-xl py-3 pl-11 pr-4 text-base placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all font-medium">
        </div>
      </div>

      <div>
        <div class="flex justify-between items-center mb-2">
          <label for="senha" class="block text-xs sm:text-sm font-bold text-slate-300 uppercase tracking-wider">Senha</label>
          <a href="/recuperar-senha" class="text-xs sm:text-sm text-sky-400 hover:text-sky-300 font-semibold transition-colors">Esqueceu a senha?</a>
        </div>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
            <i data-lucide="lock" class="w-5 h-5"></i>
          </div>
          <input type="password" id="senha" name="senha" required
                 placeholder="Sua senha de acesso"
                 class="w-full bg-slate-900/90 border border-slate-750 text-white rounded-xl py-3 pl-11 pr-4 text-base placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all font-medium">
        </div>
      </div>

      <button type="submit" 
              class="w-full bg-sky-500 hover:bg-sky-600 active:scale-[0.98] text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-sky-500/20 transition-all flex items-center justify-center space-x-2 text-base">
        <span>Entrar no Sistema</span>
        <i data-lucide="arrow-right" class="w-5 h-5"></i>
      </button>
    </form>

    <div class="mt-6 sm:mt-8 text-center text-xs text-slate-400">
      <p>Desenvolvido para máxima segurança e conformidade LGPD.</p>
    </div>
  </div>

  <script>
    // Inicializar ícones
    lucide.createIcons();
  </script>
</body>
</html>
